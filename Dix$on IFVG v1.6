f_processBullMitigation(bool bullEntryIn, float bullEntryPriceIn, box bullEntryFvgBoxIn, int bullEntrySessIdIn, int bullEntryIdxIn,
     bool bullMitigationBarIn, int bullMitOriginIdxIn, float bullMitEntryPriceIn, string bullDeliveredTFsIn, bool bullDeliveredAnyIn) =>
    bool   bullEntryLocal       = bullEntryIn
    float  bullEntryPriceLocal  = bullEntryPriceIn
    box    bullEntryFvgBoxLocal = bullEntryFvgBoxIn
    int    bullEntrySessIdLocal = bullEntrySessIdIn
    int    bullEntryIdxLocal    = bullEntryIdxIn
    bool   bullMitigationBarLocal = bullMitigationBarIn
    int    bullMitOriginIdxLocal  = bullMitOriginIdxIn
    float  bullMitEntryPriceLocal = bullMitEntryPriceIn
    string bullDeliveredTFsLocal  = bullDeliveredTFsIn
    bool   bullDeliveredAnyLocal  = bullDeliveredAnyIn

    bullCount = array.size(bullFvgBoxes)
    int lastBullMitigatedIdx = na

    // Precompute per-bar HTF "inside" IDs once to avoid repeating 4 scans per active zone.
    int bullInside1Id = htfDeliveryEnabled and mtfFinder1Enabled ? ifvglib.htfInsideIdSide(close, htf1BearTops, htf1BearBots, htf1BearIds) : na
    int bullInside2Id = htfDeliveryEnabled and mtfFinder2Enabled ? ifvglib.htfInsideIdSide(close, htf2BearTops, htf2BearBots, htf2BearIds) : na
    int bullInside3Id = htfDeliveryEnabled and mtfFinder3Enabled ? ifvglib.htfInsideIdSide(close, htf3BearTops, htf3BearBots, htf3BearIds) : na
    int bullInside4Id = htfDeliveryEnabled and mtfFinder4Enabled ? ifvglib.htfInsideIdSide(close, htf4BearTops, htf4BearBots, htf4BearIds) : na

    if bullCount > 0
        for i = 0 to bullCount - 1
            if not array.get(bullFvgHandled, i)
                bool entryEligible = i < array.size(bullEntryEligible) and array.get(bullEntryEligible, i)
                idx     = array.get(bullFvgIndices, i)
                topB    = array.get(bullFvgTops, i)
                botB    = array.get(bullFvgBottoms, i)
                box activeBullBox = array.get(bullFvgBoxes, i)
                if (entryEligible or extendCoreFvgsToCurrentBar) and not na(activeBullBox)
                    box.set_right(activeBullBox, barNum + coreFvgExtendBars)

                hiGapB  = math.max(topB, botB)
                loGapB  = math.min(topB, botB)

                barsAgo = barNum - idx

                if hasMitCap and barsAgo > maxMitBars
                    array.set(bullFvgHandled, i, true)
                else
                    inWindow = barsAgo >= 0 and (not hasMitCap or barsAgo <= maxMitBars)
                    bool inDeliveryTouchWindow = inWindow or barsAgo == 0
                    bool zoneConfirmed = array.get(bullFvgConfirmed, i)
                    if not zoneConfirmed and srcConfirmedCore and barNum > idx
                        zoneConfirmed := true
                        array.set(bullFvgConfirmed, i, true)
                    if not zoneConfirmed
                        if inWindow and high >= loGapB and low <= hiGapB
                            float shrinkLo = math.max(loGapB, math.min(high, hiGapB))
                            if shrinkLo != loGapB
                                array.set(bullFvgBottoms, i, shrinkLo)
                                array.set(bullFvgTops, i, hiGapB)
                                box shrinkBox = array.get(bullFvgBoxes, i)
                                if not na(shrinkBox)
                                    box.set_bottom(shrinkBox, shrinkLo)
                                    box.set_top(shrinkBox, hiGapB)

                    wickLow  = low
                    wickHigh = high

                    touchedLowPrev  = array.get(bullFvgTouchedLow, i)
                    touchedHighPrev = array.get(bullFvgTouchedHigh, i)

                    [mitigates, touchedLowNew, touchedHighNew] = ifvglib.mitigates(inWindow, loGapB, hiGapB, wickLow, wickHigh, close, touchedLowPrev, touchedHighPrev, true, useIfvgWick)

                    array.set(bullFvgTouchedLow, i, touchedLowNew)
                    array.set(bullFvgTouchedHigh, i, touchedHighNew)

                    bool bullSessIdxOk = i < array.size(bullFvgSess)
                    bool inIfvgSessWindow = ifvgSessionLookback == 0 or (not bullSessIdxOk ? true : (not na(ifvgCutoffSess) and array.get(bullFvgSess, i) >= ifvgCutoffSess))
                    int  bullEntrySess = bullSessIdxOk ? array.get(bullFvgSess, i) : ifvgSessionId

                    if htfDeliveryEnabled and entryEligible and inIfvgSessWindow and zoneConfirmed
                        int prevId1 = array.get(bullFvgTouchedHtf1Id, i)
                        int prevId2 = array.get(bullFvgTouchedHtf2Id, i)
                        int prevId3 = array.get(bullFvgTouchedHtf3Id, i)
                        int prevId4 = array.get(bullFvgTouchedHtf4Id, i)
                        if not ifvglib.htfEligibleId(prevId1, htf1BearIds, htf1BearMitIds, htf1BearMitBars, idx, maxMitBars)
                            array.set(bullFvgTouchedHtf1, i, false)
                            array.set(bullFvgTouchedHtf1Id, i, na)
                        if not ifvglib.htfEligibleId(prevId2, htf2BearIds, htf2BearMitIds, htf2BearMitBars, idx, maxMitBars)
                            array.set(bullFvgTouchedHtf2, i, false)
                            array.set(bullFvgTouchedHtf2Id, i, na)
                        if not ifvglib.htfEligibleId(prevId3, htf3BearIds, htf3BearMitIds, htf3BearMitBars, idx, maxMitBars)
                            array.set(bullFvgTouchedHtf3, i, false)
                            array.set(bullFvgTouchedHtf3Id, i, na)
                        if not ifvglib.htfEligibleId(prevId4, htf4BearIds, htf4BearMitIds, htf4BearMitBars, idx, maxMitBars)
                            array.set(bullFvgTouchedHtf4, i, false)
                            array.set(bullFvgTouchedHtf4Id, i, na)

                        int htfTouch1Id = mtfFinder1Enabled and inDeliveryTouchWindow and not mitigates ? ifvglib.htfTouchIdSide(wickLow, wickHigh, htf1BearTops, htf1BearBots, htf1BearIds) : na
                        int htfTouch2Id = mtfFinder2Enabled and inDeliveryTouchWindow and not mitigates ? ifvglib.htfTouchIdSide(wickLow, wickHigh, htf2BearTops, htf2BearBots, htf2BearIds) : na
                        int htfTouch3Id = mtfFinder3Enabled and inDeliveryTouchWindow and not mitigates ? ifvglib.htfTouchIdSide(wickLow, wickHigh, htf3BearTops, htf3BearBots, htf3BearIds) : na
                        int htfTouch4Id = mtfFinder4Enabled and inDeliveryTouchWindow and not mitigates ? ifvglib.htfTouchIdSide(wickLow, wickHigh, htf4BearTops, htf4BearBots, htf4BearIds) : na
                        bool htfTouch1Started = ifvglib.htfDeliveryZoneStartedId(htfTouch1Id, htf1BearIds, htf1BearOriginTime, gapMtf1Time)
                        bool htfTouch2Started = ifvglib.htfDeliveryZoneStartedId(htfTouch2Id, htf2BearIds, htf2BearOriginTime, gapMtf2Time)
                        bool htfTouch3Started = ifvglib.htfDeliveryZoneStartedId(htfTouch3Id, htf3BearIds, htf3BearOriginTime, gapMtf3Time)
                        bool htfTouch4Started = ifvglib.htfDeliveryZoneStartedId(htfTouch4Id, htf4BearIds, htf4BearOriginTime, gapMtf4Time)
                        if htfTouch1Started
                            array.set(bullFvgTouchedHtf1, i, true)
                            array.set(bullFvgTouchedHtf1Id, i, htfTouch1Id)
                        if htfTouch2Started
                            array.set(bullFvgTouchedHtf2, i, true)
                            array.set(bullFvgTouchedHtf2Id, i, htfTouch2Id)
                        if htfTouch3Started
                            array.set(bullFvgTouchedHtf3, i, true)
                            array.set(bullFvgTouchedHtf3Id, i, htfTouch3Id)
                        if htfTouch4Started
                            array.set(bullFvgTouchedHtf4, i, true)
                            array.set(bullFvgTouchedHtf4Id, i, htfTouch4Id)

                    if mitigates
                        array.set(bullFvgHandled, i, true)
                        array.set(bullFvgInverted, i, true)
                        lastBullMitigatedIdx := i

                        if entryEligible or extendCoreFvgsToCurrentBar
                            int x1Bull = na
                            int x2Bull = na
                            float y1Bull = na
                            float y2Bull = na
                            oldBox = array.get(bullFvgBoxes, i)
                            if not na(oldBox)
                                x1Bull := box.get_left(oldBox)
                                x2Bull := box.get_right(oldBox)
                                y1Bull := box.get_bottom(oldBox)
                                y2Bull := box.get_top(oldBox)
                                box.delete(oldBox)
                            if not na(x1Bull) and not na(y1Bull) and not na(x2Bull) and not na(y2Bull)
                                newBox = box.new(x1Bull, y1Bull, x2Bull, y2Bull, border_color=na, bgcolor=color.new(bullMitigatedFvgColorFinal, bullBoxTransp))
                                array.set(bullFvgBoxes, i, newBox)
                                if inIfvgSessWindow and entryEligible
                                    bullEntryFvgBoxLocal := newBox
                            else
                                array.set(bullFvgBoxes, i, na)

                        if inIfvgSessWindow and entryEligible
                            bullEntrySessIdLocal := bullEntrySess
                            bullEntryLocal       := true
                            bullEntryPriceLocal  := close
                            bullEntryIdxLocal    := i
                            array.set(bullEntryEligible, i, false)

                            bullMitigationBarLocal := true
                            bullMitOriginIdxLocal  := idx
                            bullMitEntryPriceLocal := close

                            if htfDeliveryEnabled
                                int htfTouch1EntryId = mtfFinder1Enabled ? array.get(bullFvgTouchedHtf1Id, i) : na
                                int htfTouch2EntryId = mtfFinder2Enabled ? array.get(bullFvgTouchedHtf2Id, i) : na
                                int htfTouch3EntryId = mtfFinder3Enabled ? array.get(bullFvgTouchedHtf3Id, i) : na
                                int htfTouch4EntryId = mtfFinder4Enabled ? array.get(bullFvgTouchedHtf4Id, i) : na
                                bool del1 = ifvglib.htfDeliveryFromStartedZones(bullInside1Id, htfTouch1EntryId, htf1BearIds, htf1BearOriginTime, gapMtf1Time)
                                bool del2 = ifvglib.htfDeliveryFromStartedZones(bullInside2Id, htfTouch2EntryId, htf2BearIds, htf2BearOriginTime, gapMtf2Time)
                                bool del3 = ifvglib.htfDeliveryFromStartedZones(bullInside3Id, htfTouch3EntryId, htf3BearIds, htf3BearOriginTime, gapMtf3Time)
                                bool del4 = ifvglib.htfDeliveryFromStartedZones(bullInside4Id, htfTouch4EntryId, htf4BearIds, htf4BearOriginTime, gapMtf4Time)
                                string delTxt = ""
                                if del1
                                    delTxt := ifvglib.joinComma(delTxt, mtf1GapTfLabel)
                                if del2
                                    delTxt := ifvglib.joinComma(delTxt, mtf2GapTfLabel)
                                if del3
                                    delTxt := ifvglib.joinComma(delTxt, mtf3GapTfLabel)
                                if del4
                                    delTxt := ifvglib.joinComma(delTxt, mtf4GapTfLabel)
                                bullDeliveredTFsLocal := delTxt
                                bullDeliveredAnyLocal := str.length(delTxt) > 0
                    else
                        bullEntryFvgBoxLocal := na
    [bullEntryLocal, bullEntryPriceLocal, bullEntryFvgBoxLocal, bullEntrySessIdLocal, bullEntryIdxLocal,
     bullMitigationBarLocal, bullMitOriginIdxLocal, bullMitEntryPriceLocal, bullDeliveredTFsLocal, bullDeliveredAnyLocal]

f_processBearMitigation(bool bearEntryIn, float bearEntryPriceIn, box bearEntryFvgBoxIn, int bearEntrySessIdIn, int bearEntryIdxIn,
     bool bearMitigationBarIn, int bearMitOriginIdxIn, float bearMitEntryPriceIn, string bearDeliveredTFsIn, bool bearDeliveredAnyIn) =>
    bool   bearEntryLocal       = bearEntryIn
    float  bearEntryPriceLocal  = bearEntryPriceIn
    box    bearEntryFvgBoxLocal = bearEntryFvgBoxIn
    int    bearEntrySessIdLocal = bearEntrySessIdIn
    int    bearEntryIdxLocal    = bearEntryIdxIn
    bool   bearMitigationBarLocal = bearMitigationBarIn
    int    bearMitOriginIdxLocal  = bearMitOriginIdxIn
    float  bearMitEntryPriceLocal = bearMitEntryPriceIn
    string bearDeliveredTFsLocal  = bearDeliveredTFsIn
    bool   bearDeliveredAnyLocal  = bearDeliveredAnyIn

    bearCount = array.size(bearFvgBoxes)
    int lastBearMitigatedIdx = na

    // Precompute per-bar HTF "inside" IDs once to avoid repeating 4 scans per active zone.
    int bearInside1Id = htfDeliveryEnabled and mtfFinder1Enabled ? ifvglib.htfInsideIdSide(close, htf1BullTops, htf1BullBots, htf1BullIds) : na
    int bearInside2Id = htfDeliveryEnabled and mtfFinder2Enabled ? ifvglib.htfInsideIdSide(close, htf2BullTops, htf2BullBots, htf2BullIds) : na
    int bearInside3Id = htfDeliveryEnabled and mtfFinder3Enabled ? ifvglib.htfInsideIdSide(close, htf3BullTops, htf3BullBots, htf3BullIds) : na
    int bearInside4Id = htfDeliveryEnabled and mtfFinder4Enabled ? ifvglib.htfInsideIdSide(close, htf4BullTops, htf4BullBots, htf4BullIds) : na

    if bearCount > 0
        for j = 0 to bearCount - 1
            if not array.get(bearFvgHandled, j)
                bool entryEligibleS = j < array.size(bearEntryEligible) and array.get(bearEntryEligible, j)
                idxS     = array.get(bearFvgIndices, j)
                topS     = array.get(bearFvgTops, j)
                botS     = array.get(bearFvgBottoms, j)
                box activeBearBox = array.get(bearFvgBoxes, j)
                if (entryEligibleS or extendCoreFvgsToCurrentBar) and not na(activeBearBox)
                    box.set_right(activeBearBox, barNum + coreFvgExtendBars)

                hiGapS  = math.max(topS, botS)
                loGapS  = math.min(topS, botS)

                barsAgoS = barNum - idxS

                if hasMitCap and barsAgoS > maxMitBars
                    array.set(bearFvgHandled, j, true)
                else
                    inWindowS = barsAgoS >= 0 and (not hasMitCap or barsAgoS <= maxMitBars)
                    bool inDeliveryTouchWindowS = inWindowS or barsAgoS == 0
                    bool zoneConfirmedS = array.get(bearFvgConfirmed, j)
                    if not zoneConfirmedS and srcConfirmedCore and barNum > idxS
                        zoneConfirmedS := true
                        array.set(bearFvgConfirmed, j, true)
                    if not zoneConfirmedS
                        if inWindowS and high >= loGapS and low <= hiGapS
                            float shrinkHi = math.min(hiGapS, math.max(low, loGapS))
                            if shrinkHi != hiGapS
                                array.set(bearFvgTops, j, shrinkHi)
                                array.set(bearFvgBottoms, j, loGapS)
                                box shrinkBoxS = array.get(bearFvgBoxes, j)
                                if not na(shrinkBoxS)
                                    box.set_top(shrinkBoxS, shrinkHi)
                                    box.set_bottom(shrinkBoxS, loGapS)

                    wickLowS  = low
                    wickHighS = high

                    touchedLowPrevS  = array.get(bearFvgTouchedLow, j)
                    touchedHighPrevS = array.get(bearFvgTouchedHigh, j)

                    [mitigatesS, touchedLowNewS, touchedHighNewS] = ifvglib.mitigates(inWindowS, loGapS, hiGapS, wickLowS, wickHighS, close, touchedLowPrevS, touchedHighPrevS, false, useIfvgWick)

                    array.set(bearFvgTouchedLow, j, touchedLowNewS)
                    array.set(bearFvgTouchedHigh, j, touchedHighNewS)

                    bool bearSessIdxOk = j < array.size(bearFvgSess)
                    bool inIfvgSessWindowS = ifvgSessionLookback == 0 or (not bearSessIdxOk ? true : (not na(ifvgCutoffSess) and array.get(bearFvgSess, j) >= ifvgCutoffSess))
                    int  bearEntrySess = bearSessIdxOk ? array.get(bearFvgSess, j) : ifvgSessionId

                    if htfDeliveryEnabled and entryEligibleS and inIfvgSessWindowS and zoneConfirmedS
                        int prevId1S = array.get(bearFvgTouchedHtf1Id, j)
                        int prevId2S = array.get(bearFvgTouchedHtf2Id, j)
                        int prevId3S = array.get(bearFvgTouchedHtf3Id, j)
                        int prevId4S = array.get(bearFvgTouchedHtf4Id, j)
                        if not ifvglib.htfEligibleId(prevId1S, htf1BullIds, htf1BullMitIds, htf1BullMitBars, idxS, maxMitBars)
                            array.set(bearFvgTouchedHtf1, j, false)
                            array.set(bearFvgTouchedHtf1Id, j, na)
                        if not ifvglib.htfEligibleId(prevId2S, htf2BullIds, htf2BullMitIds, htf2BullMitBars, idxS, maxMitBars)
                            array.set(bearFvgTouchedHtf2, j, false)
                            array.set(bearFvgTouchedHtf2Id, j, na)
                        if not ifvglib.htfEligibleId(prevId3S, htf3BullIds, htf3BullMitIds, htf3BullMitBars, idxS, maxMitBars)
                            array.set(bearFvgTouchedHtf3, j, false)
                            array.set(bearFvgTouchedHtf3Id, j, na)
                        if not ifvglib.htfEligibleId(prevId4S, htf4BullIds, htf4BullMitIds, htf4BullMitBars, idxS, maxMitBars)
                            array.set(bearFvgTouchedHtf4, j, false)
                            array.set(bearFvgTouchedHtf4Id, j, na)

                        int htfTouch1IdS = mtfFinder1Enabled and inDeliveryTouchWindowS and not mitigatesS ? ifvglib.htfTouchIdSide(wickLowS, wickHighS, htf1BullTops, htf1BullBots, htf1BullIds) : na
                        int htfTouch2IdS = mtfFinder2Enabled and inDeliveryTouchWindowS and not mitigatesS ? ifvglib.htfTouchIdSide(wickLowS, wickHighS, htf2BullTops, htf2BullBots, htf2BullIds) : na
                        int htfTouch3IdS = mtfFinder3Enabled and inDeliveryTouchWindowS and not mitigatesS ? ifvglib.htfTouchIdSide(wickLowS, wickHighS, htf3BullTops, htf3BullBots, htf3BullIds) : na
                        int htfTouch4IdS = mtfFinder4Enabled and inDeliveryTouchWindowS and not mitigatesS ? ifvglib.htfTouchIdSide(wickLowS, wickHighS, htf4BullTops, htf4BullBots, htf4BullIds) : na
                        bool htfTouch1StartedS = ifvglib.htfDeliveryZoneStartedId(htfTouch1IdS, htf1BullIds, htf1BullOriginTime, gapMtf1Time)
                        bool htfTouch2StartedS = ifvglib.htfDeliveryZoneStartedId(htfTouch2IdS, htf2BullIds, htf2BullOriginTime, gapMtf2Time)
                        bool htfTouch3StartedS = ifvglib.htfDeliveryZoneStartedId(htfTouch3IdS, htf3BullIds, htf3BullOriginTime, gapMtf3Time)
                        bool htfTouch4StartedS = ifvglib.htfDeliveryZoneStartedId(htfTouch4IdS, htf4BullIds, htf4BullOriginTime, gapMtf4Time)
                        if htfTouch1StartedS
                            array.set(bearFvgTouchedHtf1, j, true)
                            array.set(bearFvgTouchedHtf1Id, j, htfTouch1IdS)
                        if htfTouch2StartedS
                            array.set(bearFvgTouchedHtf2, j, true)
                            array.set(bearFvgTouchedHtf2Id, j, htfTouch2IdS)
                        if htfTouch3StartedS
                            array.set(bearFvgTouchedHtf3, j, true)
                            array.set(bearFvgTouchedHtf3Id, j, htfTouch3IdS)
                        if htfTouch4StartedS
                            array.set(bearFvgTouchedHtf4, j, true)
                            array.set(bearFvgTouchedHtf4Id, j, htfTouch4IdS)

                    if mitigatesS
                        array.set(bearFvgHandled, j, true)
                        array.set(bearFvgInverted, j, true)
                        lastBearMitigatedIdx := j

                        if entryEligibleS or extendCoreFvgsToCurrentBar
                            int x1Bear = na
                            int x2Bear = na
                            float y1Bear = na
                            float y2Bear = na
                            oldBoxS = array.get(bearFvgBoxes, j)
                            if not na(oldBoxS)
                                x1Bear := box.get_left(oldBoxS)
                                x2Bear := box.get_right(oldBoxS)
                                y1Bear := box.get_bottom(oldBoxS)
                                y2Bear := box.get_top(oldBoxS)
                                box.delete(oldBoxS)
                            if not na(x1Bear) and not na(y1Bear) and not na(x2Bear) and not na(y2Bear)
                                newBoxS = box.new(x1Bear, y1Bear, x2Bear, y2Bear, border_color=na, bgcolor=color.new(bearMitigatedFvgColorFinal, bearBoxTransp))
                                array.set(bearFvgBoxes, j, newBoxS)
                                if inIfvgSessWindowS and entryEligibleS
                                    bearEntryFvgBoxLocal := newBoxS
                            else
                                array.set(bearFvgBoxes, j, na)

                        if inIfvgSessWindowS and entryEligibleS
                            bearEntrySessIdLocal := bearEntrySess
                            bearEntryLocal       := true
                            bearEntryPriceLocal  := close
                            bearEntryIdxLocal    := j
                            array.set(bearEntryEligible, j, false)

                            bearMitigationBarLocal := true
                            bearMitOriginIdxLocal  := idxS
                            bearMitEntryPriceLocal := close

                            if htfDeliveryEnabled
                                int htfTouch1EntryIdS = mtfFinder1Enabled ? array.get(bearFvgTouchedHtf1Id, j) : na
                                int htfTouch2EntryIdS = mtfFinder2Enabled ? array.get(bearFvgTouchedHtf2Id, j) : na
                                int htfTouch3EntryIdS = mtfFinder3Enabled ? array.get(bearFvgTouchedHtf3Id, j) : na
                                int htfTouch4EntryIdS = mtfFinder4Enabled ? array.get(bearFvgTouchedHtf4Id, j) : na
                                bool del1S = ifvglib.htfDeliveryFromStartedZones(bearInside1Id, htfTouch1EntryIdS, htf1BullIds, htf1BullOriginTime, gapMtf1Time)
                                bool del2S = ifvglib.htfDeliveryFromStartedZones(bearInside2Id, htfTouch2EntryIdS, htf2BullIds, htf2BullOriginTime, gapMtf2Time)
                                bool del3S = ifvglib.htfDeliveryFromStartedZones(bearInside3Id, htfTouch3EntryIdS, htf3BullIds, htf3BullOriginTime, gapMtf3Time)
                                bool del4S = ifvglib.htfDeliveryFromStartedZones(bearInside4Id, htfTouch4EntryIdS, htf4BullIds, htf4BullOriginTime, gapMtf4Time)
                                string delTxtS = ""
                                if del1S
                                    delTxtS := ifvglib.joinComma(delTxtS, mtf1GapTfLabel)
                                if del2S
                                    delTxtS := ifvglib.joinComma(delTxtS, mtf2GapTfLabel)
                                if del3S
                                    delTxtS := ifvglib.joinComma(delTxtS, mtf3GapTfLabel)
                                if del4S
                                    delTxtS := ifvglib.joinComma(delTxtS, mtf4GapTfLabel)
                                bearDeliveredTFsLocal := delTxtS
                                bearDeliveredAnyLocal := str.length(delTxtS) > 0
                    else
                        bearEntryFvgBoxLocal := na
    [bearEntryLocal, bearEntryPriceLocal, bearEntryFvgBoxLocal, bearEntrySessIdLocal, bearEntryIdxLocal,
     bearMitigationBarLocal, bearMitOriginIdxLocal, bearMitEntryPriceLocal, bearDeliveredTFsLocal, bearDeliveredAnyLocal]
[bullEntryOut, bullEntryPriceOut, bullEntryFvgBoxOut, bullEntrySessIdOut, bullEntryIdxOut,
 bullMitigationBarOut, bullMitOriginIdxOut, bullMitEntryPriceOut, bullDeliveredTFsOut, bullDeliveredAnyOut] =
     f_processBullMitigation(bullEntry, bullEntryPrice, bullEntryFvgBox, bullEntrySessId, bullEntryIdx,
     bullMitigationBar, bullMitOriginIdx, bullMitEntryPrice, bullDeliveredTFs, bullDeliveredAny)
bullEntry := bullEntryOut
bullEntryPrice := bullEntryPriceOut
bullEntryFvgBox := bullEntryFvgBoxOut
bullEntrySessId := bullEntrySessIdOut
bullEntryIdx := bullEntryIdxOut
bullMitigationBar := bullMitigationBarOut
bullMitOriginIdx := bullMitOriginIdxOut
bullMitEntryPrice := bullMitEntryPriceOut
bullDeliveredTFs := bullDeliveredTFsOut
bullDeliveredAny := bullDeliveredAnyOut
[bearEntryOut, bearEntryPriceOut, bearEntryFvgBoxOut, bearEntrySessIdOut, bearEntryIdxOut,
 bearMitigationBarOut, bearMitOriginIdxOut, bearMitEntryPriceOut, bearDeliveredTFsOut, bearDeliveredAnyOut] =
     f_processBearMitigation(bearEntry, bearEntryPrice, bearEntryFvgBox, bearEntrySessId, bearEntryIdx,
     bearMitigationBar, bearMitOriginIdx, bearMitEntryPrice, bearDeliveredTFs, bearDeliveredAny)
bearEntry := bearEntryOut
bearEntryPrice := bearEntryPriceOut
bearEntryFvgBox := bearEntryFvgBoxOut
bearEntrySessId := bearEntrySessIdOut
bearEntryIdx := bearEntryIdxOut
bearMitigationBar := bearMitigationBarOut
bearMitOriginIdx := bearMitOriginIdxOut
bearMitEntryPrice := bearMitEntryPriceOut
bearDeliveredTFs := bearDeliveredTFsOut
bearDeliveredAny := bearDeliveredAnyOut

if extendCoreFvgsToCurrentBar
    int bullExtN = array.size(bullFvgBoxes)
    int bullHandledN = array.size(bullFvgHandled)
    int bullTopsN = array.size(bullFvgTops)
    int bullBottomsN = array.size(bullFvgBottoms)
    if bullExtN > 0
        for i = 0 to bullExtN - 1
            box bx = array.get(bullFvgBoxes, i)
            if not na(bx)
                box.set_right(bx, barNum + coreFvgExtendBars)
                bool handled = i < bullHandledN and array.get(bullFvgHandled, i)
                if handled
                    float top = i < bullTopsN ? array.get(bullFvgTops, i) : na
                    float bot = i < bullBottomsN ? array.get(bullFvgBottoms, i) : na
                    if not na(top) and not na(bot)
                        float hi = math.max(top, bot)
                        float lo = math.min(top, bot)
                        float mid = (hi + lo) * 0.5
                        color flipCol = close >= mid ? bullMitigatedFvgColorFinal : bearMitigatedFvgColorFinal
                        color newBg = color.new(flipCol, bullBoxTransp)
                        box.set_bgcolor(bx, newBg)
    int bearExtN = array.size(bearFvgBoxes)
    int bearHandledN = array.size(bearFvgHandled)
    int bearTopsN = array.size(bearFvgTops)
    int bearBottomsN = array.size(bearFvgBottoms)
    if bearExtN > 0
        for i = 0 to bearExtN - 1
            box bx = array.get(bearFvgBoxes, i)
            if not na(bx)
                box.set_right(bx, barNum + coreFvgExtendBars)
                bool handled = i < bearHandledN and array.get(bearFvgHandled, i)
                if handled
                    float top = i < bearTopsN ? array.get(bearFvgTops, i) : na
                    float bot = i < bearBottomsN ? array.get(bearFvgBottoms, i) : na
                    if not na(top) and not na(bot)
                        float hi = math.max(top, bot)
                        float lo = math.min(top, bot)
                        float mid = (hi + lo) * 0.5
                        color flipCol = close >= mid ? bullMitigatedFvgColorFinal : bearMitigatedFvgColorFinal
                        color newBg = color.new(flipCol, bearBoxTransp)
                        box.set_bgcolor(bx, newBg)

ifvglib.renderCoreFvgLabels(showCoreFvgLabels, showBull, showBear, coreFvgTfLabel, showCoreFvgLabelTf,
     bullFvgBoxes, bullFvgLabels, bullFvgInverted, bearFvgBoxes, bearFvgLabels, bearFvgInverted)

if maxCoreFvgCap > 0
    int bullKept = 0
    int bullCapN = array.size(bullFvgBoxes)
    if bullCapN > 0
        for i = bullCapN - 1 to 0
            box bx = array.get(bullFvgBoxes, i)
            if not na(bx)
                bool isEntry = false
                int entryN = array.size(ifvgBoxes)
                if entryN > 0
                    for j = 0 to entryN - 1
                        box entryBox = array.get(ifvgBoxes, j)
                        if not na(entryBox) and box.get_left(bx) == box.get_left(entryBox) and box.get_right(bx) == box.get_right(entryBox) and box.get_top(bx) == box.get_top(entryBox) and box.get_bottom(bx) == box.get_bottom(entryBox)
                            isEntry := true
                            break
                if not isEntry
                    if bullKept < maxCoreFvgCap
                        bullKept += 1
                    else
                        label lb = i < array.size(bullFvgLabels) ? array.get(bullFvgLabels, i) : na
                        box.delete(bx)
                        if not na(lb)
                            label.delete(lb)
                        array.set(bullFvgBoxes, i, na)
                        if i < array.size(bullFvgLabels)
                            array.set(bullFvgLabels, i, na)
    int bearKept = 0
    int bearCapN = array.size(bearFvgBoxes)
    if bearCapN > 0
        for i = bearCapN - 1 to 0
            box bx = array.get(bearFvgBoxes, i)
            if not na(bx)
                bool isEntry = false
                int entryN = array.size(ifvgBoxes)
                if entryN > 0
                    for j = 0 to entryN - 1
                        box entryBox = array.get(ifvgBoxes, j)
                        if not na(entryBox) and box.get_left(bx) == box.get_left(entryBox) and box.get_right(bx) == box.get_right(entryBox) and box.get_top(bx) == box.get_top(entryBox) and box.get_bottom(bx) == box.get_bottom(entryBox)
                            isEntry := true
                            break
                if not isEntry
                    if bearKept < maxCoreFvgCap
                        bearKept += 1
                    else
                        label lb = i < array.size(bearFvgLabels) ? array.get(bearFvgLabels, i) : na
                        box.delete(bx)
                        if not na(lb)
                            label.delete(lb)
                        array.set(bearFvgBoxes, i, na)
                        if i < array.size(bearFvgLabels)
                            array.set(bearFvgLabels, i, na)
if useGapLineFill
    int maxGapAge = 9000

    // Gap band cleanup
    if showMtf1GapBandsPrev and not showMtf1GapBands
        f_gapClearSet(GAP_SET_MTF1)
    if showMtf2GapBandsPrev and not showMtf2GapBands
        f_gapClearSet(GAP_SET_MTF2)
    if showMtf3GapBandsPrev and not showMtf3GapBands
        f_gapClearSet(GAP_SET_MTF3)
    if showMtf4GapBandsPrev and not showMtf4GapBands
        f_gapClearSet(GAP_SET_MTF4)
    if showDailyGapBandsPrev and not showDailyGapBands
        f_gapClearSet(GAP_SET_DAILY)
    if mtf1GapFinderEnabledPrev and not mtf1GapFinderEnabled
        f_gapClearSet(GAP_SET_MTF1)
    if mtf2GapFinderEnabledPrev and not mtf2GapFinderEnabled
        f_gapClearSet(GAP_SET_MTF2)
    if mtf3GapFinderEnabledPrev and not mtf3GapFinderEnabled
        f_gapClearSet(GAP_SET_MTF3)
    if mtf4GapFinderEnabledPrev and not mtf4GapFinderEnabled
        f_gapClearSet(GAP_SET_MTF4)

    // Daily gaps (gap bands with fill progress)
    if showDailyGapBands and newDay and bar_index > 0
        float prevHigh = high[1]
        float prevLow  = low[1]

        bool gapUp   = low > prevHigh
        bool gapDown = high < prevLow

        if gapUp
            float gTop = low
            float gBot = prevHigh
            f_gapAdd(GAP_SET_DAILY, barNum - 1, true, gTop, gBot, gTop, barNum, time, dailyGapBullishColorFinal, true)

        if gapDown
            float gTop2 = prevLow
            float gBot2 = high
            f_gapAdd(GAP_SET_DAILY, barNum - 1, false, gTop2, gBot2, gBot2, barNum, time, dailyGapBearishColorFinal, false)

    // MTF FVG-based gap bands
    f_updateGapBands(GAP_SET_MTF1, mtf1GapFvgTf, gapMtf1Enabled, mtf1GapCap, maxGapAge, mtf1GapUseWick, mtf1GapHideMitigated, mtf1GapOpacity, mtf1GapBullishColorFinal, mtf1GapBearishColorFinal, mtf1GapFullyMitigatedColorFinal, mtf1GapLabelSize, mtf1ShowGapLabels, mtf1ShowGapLabelType, mtf1ShowGapLabelTf, mtf1ShowGapLabelDateTime, mtf1ShowGapLabelPercent, gapMtf1Time, mtf1GapLabelPosition, mtf1GapExtendBars)
    f_updateGapBands(GAP_SET_MTF2, mtf2GapFvgTf, gapMtf2Enabled, mtf2GapCap, maxGapAge, mtf2GapUseWick, mtf2GapHideMitigated, mtf2GapOpacity, mtf2GapBullishColorFinal, mtf2GapBearishColorFinal, mtf2GapFullyMitigatedColorFinal, mtf2GapLabelSize, mtf2ShowGapLabels, mtf2ShowGapLabelType, mtf2ShowGapLabelTf, mtf2ShowGapLabelDateTime, mtf2ShowGapLabelPercent, gapMtf2Time, mtf2GapLabelPosition, mtf2GapExtendBars)
    f_updateGapBands(GAP_SET_MTF3, mtf3GapFvgTf, gapMtf3Enabled, mtf3GapCap, maxGapAge, mtf3GapUseWick, mtf3GapHideMitigated, mtf3GapOpacity, mtf3GapBullishColorFinal, mtf3GapBearishColorFinal, mtf3GapFullyMitigatedColorFinal, mtf3GapLabelSize, mtf3ShowGapLabels, mtf3ShowGapLabelType, mtf3ShowGapLabelTf, mtf3ShowGapLabelDateTime, mtf3ShowGapLabelPercent, gapMtf3Time, mtf3GapLabelPosition, mtf3GapExtendBars)
    f_updateGapBands(GAP_SET_MTF4, mtf4GapFvgTf, gapMtf4Enabled, mtf4GapCap, maxGapAge, mtf4GapUseWick, mtf4GapHideMitigated, mtf4GapOpacity, mtf4GapBullishColorFinal, mtf4GapBearishColorFinal, mtf4GapFullyMitigatedColorFinal, mtf4GapLabelSize, mtf4ShowGapLabels, mtf4ShowGapLabelType, mtf4ShowGapLabelTf, mtf4ShowGapLabelDateTime, mtf4ShowGapLabelPercent, gapMtf4Time, mtf4GapLabelPosition, mtf4GapExtendBars)
    f_updateGapBands(GAP_SET_DAILY, "", showDailyGapBands, dailyGapCap, maxGapAge, dailyGapUseWick, dailyGapHideMitigated, dailyGapOpacity, dailyGapBullishColorFinal, dailyGapBearishColorFinal, dailyGapFullyMitigatedColorFinal, dailyGapLabelSize, dailyShowGapLabels, dailyShowGapLabelType, dailyShowGapLabelTf, dailyShowGapLabelDateTime, dailyShowGapLabelPercent, na, dailyGapLabelPosition, dailyGapExtendBars)

    gapLineCount := f_gapCountEnabled(gapSetId, showDailyGapBands, gapMtf1Enabled, gapMtf2Enabled, gapMtf3Enabled, gapMtf4Enabled)
else
    if useGapLineFillPrev
        f_gapClearSet(GAP_SET_MTF1)
        f_gapClearSet(GAP_SET_MTF2)
        f_gapClearSet(GAP_SET_MTF3)
        f_gapClearSet(GAP_SET_MTF4)
        f_gapClearSet(GAP_SET_DAILY)
    gapLineCount := 0

showMtf1GapBandsPrev := showMtf1GapBands
showMtf2GapBandsPrev := showMtf2GapBands
showMtf3GapBandsPrev := showMtf3GapBands
showMtf4GapBandsPrev := showMtf4GapBands
showDailyGapBandsPrev := showDailyGapBands
mtf1GapFinderEnabledPrev := mtf1GapFinderEnabled
mtf2GapFinderEnabledPrev := mtf2GapFinderEnabled
mtf3GapFinderEnabledPrev := mtf3GapFinderEnabled
mtf4GapFinderEnabledPrev := mtf4GapFinderEnabled
useGapLineFillPrev := useGapLineFill


f_enforceSmtVisualCap(int cap, line[] linesArr, label[] labelsArr) =>
    if cap > 0
        while array.size(linesArr) > cap
            line oldLn = array.shift(linesArr)
            if not na(oldLn)
                line.delete(oldLn)
        while array.size(labelsArr) > cap
            label oldLb = array.shift(labelsArr)
            if not na(oldLb)
                label.delete(oldLb)

f_smtSecurityPack(bool enabled) =>
    if enabled
        request.security(smtSymbol, timeframe.period, [high, low])
    else
        [na, na]

[smtHigh, smtLow] = f_smtSecurityPack(enableSmtDivergence)

float chartPivotLow = na
float chartPivotHigh = na
float smtPivotLow = na
float smtPivotHigh = na
int chartLowLastIdx = bar_index - smtPivotLength
int chartHighLastIdx = bar_index - smtPivotLength
