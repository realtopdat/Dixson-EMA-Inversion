    f_updateHtfZones(htf2BullTops, htf2BullBots, htf2BullTouchedLow, htf2BullTouchedHigh, htf2BullOriginIdx, htf2BullOriginTime, htf2BullBoxes, htf2BullIds,
         htf2BullMitIds, htf2BullMitBars, false, bullCssFinal, fvgOpacity, true, mtf2GapUseWick, gapMtf2Time)
    f_updateHtfZones(htf2BearTops, htf2BearBots, htf2BearTouchedLow, htf2BearTouchedHigh, htf2BearOriginIdx, htf2BearOriginTime, htf2BearBoxes, htf2BearIds,
         htf2BearMitIds, htf2BearMitBars, false, bearCssFinal, fvgOpacity, false, mtf2GapUseWick, gapMtf2Time)
    if hasMitCap
        int htf2Cutoff = barNum - maxMitBars
        ifvglib.cleanupHtfMitigations(htf2BullMitIds, htf2BullMitBars, htf2Cutoff)
        ifvglib.cleanupHtfMitigations(htf2BearMitIds, htf2BearMitBars, htf2Cutoff)
    bool htf2ZonesActive = array.size(htf2BullTops) + array.size(htf2BearTops) > 0
    bool htf2HasMitigated = array.size(htf2BullMitIds) + array.size(htf2BearMitIds) > 0
    if not htf2ZonesActive and not htf2HasMitigated
        ifvglib.clearTouchIds(bullFvgTouchedHtf2Id, bearFvgTouchedHtf2Id)
    zone

