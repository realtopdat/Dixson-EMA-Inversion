f_gapGappedOver(float hi, float lo, int originBar) =>
    barNum > originBar and bar_index > 0 and ((close[1] > hi and open < lo) or (close[1] < lo and open > hi))

f_gapAdd(int setId, int startBar, bool isBull, float top, float bot, float fillStart, int originBar, int originTime, color baseCol, bool frontAnchorTop) =>
    int gapOp = setId == GAP_SET_MTF1 ? mtf1GapOpacity : setId == GAP_SET_MTF2 ? mtf2GapOpacity : setId == GAP_SET_MTF3 ? mtf3GapOpacity : setId == GAP_SET_MTF4 ? mtf4GapOpacity : dailyGapOpacity
    line lTop = line.new(startBar, top, barNum, top, extend=extend.none, color=color.new(baseCol, gapOp))
    line lBot = line.new(startBar, bot, barNum, bot, extend=extend.none, color=color.new(baseCol, gapOp))
    linefill lf = linefill.new(lTop, lBot, color=na)
    line lFront = line.new(startBar, fillStart, barNum, fillStart, extend=extend.none, color=na, style=line.style_dashed)
    linefill lfProg = linefill.new(frontAnchorTop ? lTop : lBot, lFront, color=na)
    array.push(gapTopLine, lTop)
    array.push(gapBotLine, lBot)
    array.push(gapFill, lf)
    array.push(gapFrontLine, lFront)
    array.push(gapProgressFill, lfProg)
    array.push(gapTopVal, top)
    array.push(gapBotVal, bot)
    array.push(gapIsBull, isBull)
    array.push(gapMitigated, false)
    array.push(gapFillVal, fillStart)
    array.push(gapFillStarted, false)
    array.push(gapMitBarIndex, na)
    array.push(gapOriginBar, originBar)
    array.push(gapLabel, na)
    array.push(gapOriginTime, originTime)
    array.push(gapSetId, setId)
    false

float chartTfSecs = timeframe.in_seconds(timeframe.period)

f_gapDetectAndCreate(string tf, int setId, bool detectEnabled, bool plotEnabled) =>
    int gapTime = detectEnabled ? time(tf) : na
    bool gapTimeChanged = ta.change(gapTime) != 0
    bool newGapBar = detectEnabled and gapTimeChanged

    [bullLogicRawLocalTf, topBullRawLocalTf, botBullRawLocalTf, bearLogicRawLocalTf, topBearRawLocalTf, botBearRawLocalTf] =
         f_gapPackForTf(tf, detectEnabled)

    float tfSecs = detectEnabled ? timeframe.in_seconds(tf) : na
    bool isProjectedHtf = detectEnabled and not na(tfSecs) and not na(chartTfSecs) and tfSecs > chartTfSecs
    int startBar = isProjectedHtf ? math.max(0, barNum - 1) : math.max(0, barNum - 2)
    int originTs = not na(gapTime) ? gapTime : time

    bool  bullLogicRawLocal = detectEnabled ? (newGapBar and bullLogicRawLocalTf) : false
    float topBullRawLocal   = detectEnabled ? topBullRawLocalTf : na
    float botBullRawLocal   = detectEnabled ? botBullRawLocalTf : na

    bool  bearLogicRawLocal = detectEnabled ? (newGapBar and bearLogicRawLocalTf) : false
    float topBearRawLocal   = detectEnabled ? topBearRawLocalTf : na
    float botBearRawLocal   = detectEnabled ? botBearRawLocalTf : na

    bool bullLogicLocal = plotEnabled and newGapBar and bullLogicRawLocal and not na(topBullRawLocal) and not na(botBullRawLocal) and f_hasMinWidth(topBullRawLocal, botBullRawLocal)
    bool bearLogicLocal = plotEnabled and newGapBar and bearLogicRawLocal and not na(topBearRawLocal) and not na(botBearRawLocal) and f_hasMinWidth(topBearRawLocal, botBearRawLocal)

    if bullLogicLocal
        float topB = math.max(topBullRawLocal, botBullRawLocal)
        float botB = math.min(topBullRawLocal, botBullRawLocal)
        f_gapAdd(setId, startBar, true, topB, botB, botB, barNum, originTs, setId == GAP_SET_MTF1 ? mtf1GapBearishColorFinal : setId == GAP_SET_MTF2 ? mtf2GapBearishColorFinal : setId == GAP_SET_MTF3 ? mtf3GapBearishColorFinal : setId == GAP_SET_MTF4 ? mtf4GapBearishColorFinal : dailyGapBearishColorFinal, false)

    if bearLogicLocal
        float topS = math.max(topBearRawLocal, botBearRawLocal)
        float botS = math.min(topBearRawLocal, botBearRawLocal)
        f_gapAdd(setId, startBar, false, topS, botS, topS, barNum, originTs, setId == GAP_SET_MTF1 ? mtf1GapBullishColorFinal : setId == GAP_SET_MTF2 ? mtf2GapBullishColorFinal : setId == GAP_SET_MTF3 ? mtf3GapBullishColorFinal : setId == GAP_SET_MTF4 ? mtf4GapBullishColorFinal : dailyGapBullishColorFinal, true)

    [gapTime, newGapBar, bullLogicRawLocal, topBullRawLocal, botBullRawLocal, bearLogicRawLocal, topBearRawLocal, botBearRawLocal, bullLogicLocal, bearLogicLocal]
f_gapRemoveAtIndex(int idx) =>
    line lTop = array.get(gapTopLine, idx)
    line lBot = array.get(gapBotLine, idx)
    linefill lf = array.get(gapFill, idx)
    line lFront = array.get(gapFrontLine, idx)
    linefill lfProg = array.get(gapProgressFill, idx)
    label lbl = array.get(gapLabel, idx)
    if not na(lTop)
        line.delete(lTop)
    if not na(lBot)
        line.delete(lBot)
    if not na(lFront)
        line.delete(lFront)
    if not na(lf)
        linefill.delete(lf)
    if not na(lfProg)
        linefill.delete(lfProg)
    if not na(lbl)
        label.delete(lbl)
    array.remove(gapTopLine, idx)
    array.remove(gapBotLine, idx)
    array.remove(gapFill, idx)
    array.remove(gapFrontLine, idx)
    array.remove(gapProgressFill, idx)
    array.remove(gapTopVal, idx)
    array.remove(gapBotVal, idx)
    array.remove(gapIsBull, idx)
    array.remove(gapMitigated, idx)
    array.remove(gapFillVal, idx)
    array.remove(gapFillStarted, idx)
    array.remove(gapMitBarIndex, idx)
    array.remove(gapOriginBar, idx)
    array.remove(gapLabel, idx)
    array.remove(gapOriginTime, idx)
    array.remove(gapSetId, idx)
    false

f_gapClearSet(int setId) =>
    if array.size(gapSetId) > 0
        for idx = array.size(gapSetId) - 1 to 0
            if array.get(gapSetId, idx) == setId
                f_gapRemoveAtIndex(idx)
    false

f_gapTrimAliveToCap(int setId, int cap, bool isBull) =>
    if cap > 0
        int count = ifvglib.gapCountAliveForSetDir(gapSetId, gapIsBull, gapMitigated, setId, isBull)
        while count > cap
            int farthestIdx = na
            float farthestDist = na
            for idx = 0 to array.size(gapSetId) - 1
                if array.get(gapSetId, idx) == setId and array.get(gapIsBull, idx) == isBull and not array.get(gapMitigated, idx)
                    float hi = array.get(gapTopVal, idx)
                    float lo = array.get(gapBotVal, idx)
                    float dist = ifvglib.gapDistanceToPrice(hi, lo, close)
                    bool take = na(farthestIdx) or dist > farthestDist
                    if take
                        farthestIdx := idx
                        farthestDist := dist
            if not na(farthestIdx)
                f_gapRemoveAtIndex(farthestIdx)
            else
                break
            count := ifvglib.gapCountAliveForSetDir(gapSetId, gapIsBull, gapMitigated, setId, isBull)
    false

f_updateGapBands(int setId, string tfStr, bool plotEnabled, int finderCap, int maxGapAge, bool useWickMit, bool hideMitigated, int gapOpacity, color gapBullCol, color gapBearCol, color gapMitCol, labelSz, bool showLabels, bool showType, bool showTf, bool showDateTime, bool showPercent, int gapTime, string labelPosition, int extendBars) =>
    bool gapLabelRight = labelPosition == "Right"
    gapLabelStyle = gapLabelRight ? label.style_label_left : label.style_label_right
    if plotEnabled and array.size(gapSetId) > 0
        for idx = array.size(gapSetId) - 1 to 0
            if array.get(gapSetId, idx) != setId
                continue
            line lTop = array.get(gapTopLine, idx)
            line lBot = array.get(gapBotLine, idx)
            linefill lf = array.get(gapFill, idx)
            line lFront = array.get(gapFrontLine, idx)
            linefill lfProg = array.get(gapProgressFill, idx)
            label lbl = array.get(gapLabel, idx)
            if na(lTop) or na(lBot) or na(lf) or na(lFront) or na(lfProg)
                f_gapRemoveAtIndex(idx)
                continue

            float topVal = array.get(gapTopVal, idx)
            float botVal = array.get(gapBotVal, idx)
            bool isBullGap = array.get(gapIsBull, idx)
            float hiGap = math.max(topVal, botVal)
            float loGap = math.min(topVal, botVal)
            int originTime = array.get(gapOriginTime, idx)
            int mitBar = array.get(gapMitBarIndex, idx)
            int baseX2 = not na(mitBar) ? mitBar : barNum
            int x2Target = not na(mitBar) ? mitBar : barNum + extendBars
            int ageFromCurrent = barNum - baseX2
            if ageFromCurrent > maxGapAge
                f_gapRemoveAtIndex(idx)
                continue

            int originBarForVisual = array.get(gapOriginBar, idx)
            bool gapVisualActive = ((barstate.islast or barstate.isrealtime) or (not na(originBarForVisual) and bar_index - originBarForVisual <= BACKFILL_ACTIVE_WINDOW))
            if gapVisualActive
                if line.get_x2(lTop) != x2Target
                    line.set_x2(lTop, x2Target)
                if line.get_x2(lBot) != x2Target
                    line.set_x2(lBot, x2Target)
                if line.get_x2(lFront) != x2Target
                    line.set_x2(lFront, x2Target)

            float fillFrontVal = array.get(gapFillVal, idx)
            bool fillStarted = array.get(gapFillStarted, idx)

            if setId == GAP_SET_DAILY
                bool touchesGapD = high >= loGap and low <= hiGap
                if touchesGapD
                    fillStarted := true
                if fillStarted
                    if isBullGap
                        float targetFrontD = math.min(fillFrontVal, low)
                        fillFrontVal := math.max(targetFrontD, loGap)
                    else
                        float targetFrontD = math.max(fillFrontVal, high)
                        fillFrontVal := math.min(targetFrontD, hiGap)
                    array.set(gapFillVal, idx, fillFrontVal)
                    array.set(gapFillStarted, idx, fillStarted)

                float frontY = fillStarted ? fillFrontVal : (isBullGap ? hiGap : loGap)
                if gapVisualActive
                    line.set_y1(lFront, frontY)
                    line.set_y2(lFront, frontY)

                bool isMitPrev = array.get(gapMitigated, idx)
                bool isMit = isMitPrev
                if not isMitPrev
                    bool gappedOver = f_gapGappedOver(hiGap, loGap, originBarForVisual)
                    bool reachedOpposite = isBullGap ? (fillFrontVal <= loGap) : (fillFrontVal >= hiGap)
                    if useWickMit
                        isMit := fillStarted and reachedOpposite
                    else
                        bool bodyCheck = isBullGap ? close <= loGap : close >= hiGap
                        isMit := fillStarted and reachedOpposite and bodyCheck
                    if gappedOver
                        fillStarted := true
                        fillFrontVal := isBullGap ? loGap : hiGap
                        array.set(gapFillVal, idx, fillFrontVal)
                        array.set(gapFillStarted, idx, fillStarted)
                        if gapVisualActive
                            line.set_y1(lFront, fillFrontVal)
                            line.set_y2(lFront, fillFrontVal)
                        isMit := true
                    if isMit
                        array.set(gapMitigated, idx, true)
                        array.set(gapMitBarIndex, idx, barNum)
                        x2Target := barNum
                        if gapVisualActive
                            if line.get_x2(lTop) != x2Target
                                line.set_x2(lTop, x2Target)
                            if line.get_x2(lBot) != x2Target
                                line.set_x2(lBot, x2Target)
                            if line.get_x2(lFront) != x2Target
                                line.set_x2(lFront, x2Target)

                if isMit and hideMitigated
                    f_gapRemoveAtIndex(idx)
                    continue

                color baseColGap = isBullGap ? gapBullCol : gapBearCol
                color gapCol = isMit ? gapMitCol : baseColGap
                color frontCol = fillStarted ? color.new(gapMitCol, gapOpacity) : na

                if gapVisualActive
                    line.set_color(lFront, frontCol)
                    line.set_style(lFront, line.style_dashed)
                    linefill.set_color(lfProg, fillStarted ? color.new(gapMitCol, gapOpacity) : na)
                    line.set_color(lTop, color.new(gapCol, gapOpacity))
                    line.set_color(lBot, color.new(gapCol, gapOpacity))
                    linefill.set_color(lf, color.new(gapCol, gapOpacity))

                    string lblTxtD = showLabels and (barstate.islast or barstate.isrealtime) ? ifvglib.gapLabelText(isBullGap ? "Gap Up" : "Gap Down", "", false, originTime, ifvglib.gapPercent(fillFrontVal, hiGap, loGap, not isBullGap, syminfo.mintick), showType, showTf, showDateTime, showPercent) : (not na(lbl) ? label.get_text(lbl) : "")
                    color lblBgD = color.new(gapCol, gapLabelRight ? 70 : 100)
                    int lblX = line.get_x2(lTop)
                    float lblY = gapLabelRight ? frontY : (hiGap + loGap) * 0.5
                    lbl := ifvglib.upsertGapLabelCore(lbl, lblX, lblY, lblTxtD, lblBgD, labelSz, gapLabelStyle)
                    array.set(gapLabel, idx, lbl)
            else
                int originBar = array.get(gapOriginBar, idx)
                bool isForming = originTime == gapTime
                bool touchesGap = not na(originBar) and barNum >= originBar and high >= loGap and low <= hiGap
                if isForming
                    if touchesGap
                        if isBullGap
                            float shrinkLo = math.max(loGap, math.min(high, hiGap))
                            if shrinkLo != loGap
                                array.set(gapBotVal, idx, shrinkLo)
                                array.set(gapTopVal, idx, hiGap)
                                if gapVisualActive
                                    line.set_y1(lBot, shrinkLo)
                                    line.set_y2(lBot, shrinkLo)
                                if shrinkLo >= hiGap
                                    f_gapRemoveAtIndex(idx)
                                    continue
                        else
                            float shrinkHi = math.min(hiGap, math.max(low, loGap))
                            if shrinkHi != hiGap
                                array.set(gapTopVal, idx, shrinkHi)
                                array.set(gapBotVal, idx, loGap)
                                if gapVisualActive
                                    line.set_y1(lTop, shrinkHi)
                                    line.set_y2(lTop, shrinkHi)
                                if shrinkHi <= loGap
                                    f_gapRemoveAtIndex(idx)
                                    continue
                    fillFrontVal := isBullGap ? array.get(gapBotVal, idx) : array.get(gapTopVal, idx)
                    array.set(gapFillVal, idx, fillFrontVal)
                    array.set(gapFillStarted, idx, false)
                    if gapVisualActive
                        line.set_y1(lFront, fillFrontVal)
                        line.set_y2(lFront, fillFrontVal)
                        line.set_color(lFront, na)
                        linefill.set_color(lfProg, na)
                        color baseColForm = isBullGap ? gapBearCol : gapBullCol
                        line.set_color(lTop, color.new(baseColForm, gapOpacity))
                        line.set_color(lBot, color.new(baseColForm, gapOpacity))
                        linefill.set_color(lf, color.new(baseColForm, gapOpacity))
                        string lblTxtBase = showLabels and (barstate.islast or barstate.isrealtime) ? ifvglib.gapLabelText("FVG", tfStr, true, originTime, float(na), showType, showTf, showDateTime, showPercent) : (not na(lbl) ? label.get_text(lbl) : "")
                        string lblTxt = showLabels ? (str.length(lblTxtBase) > 0 and (barstate.islast or barstate.isrealtime) ? lblTxtBase + "\n(Forming)" : lblTxtBase) : ""
                        color lblBg = color.new(baseColForm, gapLabelRight ? 70 : 100)
                        int lblX = line.get_x2(lTop)
                        float lblY = gapLabelRight ? fillFrontVal : (hiGap + loGap) * 0.5
                        lbl := ifvglib.upsertGapLabelCore(lbl, lblX, lblY, lblTxt, lblBg, labelSz, gapLabelStyle)
                        array.set(gapLabel, idx, lbl)
                    continue

                if touchesGap
                    fillStarted := true

                if fillStarted
                    if isBullGap
                        float targetFront = math.max(fillFrontVal, high)
                        fillFrontVal := math.min(targetFront, hiGap)
                    else
                        float targetFront = math.min(fillFrontVal, low)
                        fillFrontVal := math.max(targetFront, loGap)
                    array.set(gapFillVal, idx, fillFrontVal)
                    array.set(gapFillStarted, idx, fillStarted)

                float frontY = fillFrontVal
                if gapVisualActive
                    line.set_y1(lFront, frontY)
                    line.set_y2(lFront, frontY)

                bool isMitPrev = array.get(gapMitigated, idx)
                bool isMit = isMitPrev
                if not isMitPrev
                    bool gappedOver = f_gapGappedOver(hiGap, loGap, originBar)
                    bool reachedOpposite = isBullGap ? fillFrontVal >= hiGap : fillFrontVal <= loGap
                    if useWickMit
                        isMit := fillStarted and reachedOpposite
                    else
                        isMit := fillStarted and reachedOpposite and (isBullGap ? close >= hiGap : close <= loGap)
                    if gappedOver
                        fillStarted := true
                        fillFrontVal := isBullGap ? hiGap : loGap
                        array.set(gapFillVal, idx, fillFrontVal)
                        array.set(gapFillStarted, idx, fillStarted)
                        if gapVisualActive
                            line.set_y1(lFront, fillFrontVal)
                            line.set_y2(lFront, fillFrontVal)
                        isMit := true
                    if isMit
                        array.set(gapMitigated, idx, true)
                        array.set(gapMitBarIndex, idx, barNum)
                        x2Target := barNum
                        if gapVisualActive
                            if line.get_x2(lTop) != x2Target
                                line.set_x2(lTop, x2Target)
                            if line.get_x2(lBot) != x2Target
                                line.set_x2(lBot, x2Target)
                            if line.get_x2(lFront) != x2Target
                                line.set_x2(lFront, x2Target)

                if isMit and hideMitigated
                    f_gapRemoveAtIndex(idx)
                    continue

                color gapCol = isMit ? gapMitCol : (isBullGap ? gapBearCol : gapBullCol)
                color frontCol = fillStarted ? color.new(gapMitCol, gapOpacity) : na
                if gapVisualActive
                    line.set_color(lFront, frontCol)
                    line.set_style(lFront, line.style_dashed)
                    linefill.set_color(lf, color.new(gapCol, gapOpacity))
                    linefill.set_color(lfProg, fillStarted ? color.new(gapMitCol, gapOpacity) : na)
                    line.set_color(lTop, color.new(gapCol, gapOpacity))
                    line.set_color(lBot, color.new(gapCol, gapOpacity))

                    string lblTxtBase = showLabels and (barstate.islast or barstate.isrealtime) ? ifvglib.gapLabelText("FVG", tfStr, true, originTime, ifvglib.gapPercent(fillFrontVal, hiGap, loGap, isBullGap, syminfo.mintick), showType, showTf, showDateTime, showPercent) : (not na(lbl) ? label.get_text(lbl) : "")
                    string lblTxt = showLabels ? (str.length(lblTxtBase) > 0 and isForming and (barstate.islast or barstate.isrealtime) ? lblTxtBase + "\n(Forming)" : lblTxtBase) : ""
                    color lblBg = color.new(gapCol, gapLabelRight ? 70 : 100)
                    int lblX = line.get_x2(lTop)
                    float lblY = gapLabelRight ? frontY : (hiGap + loGap) * 0.5
                    lbl := ifvglib.upsertGapLabelCore(lbl, lblX, lblY, lblTxt, lblBg, labelSz, gapLabelStyle)
                    array.set(gapLabel, idx, lbl)

    if plotEnabled
        f_gapTrimAliveToCap(setId, finderCap, true)
        f_gapTrimAliveToCap(setId, finderCap, false)
    false
bool gapMtf1DetectEnabled = useGapLineFill and mtf1GapFinderEnabled and (showMtf1GapBands or mtf1DeliveryEnabled)
bool gapMtf2DetectEnabled = useGapLineFill and mtf2GapFinderEnabled and (showMtf2GapBands or mtf2DeliveryEnabled)
bool gapMtf3DetectEnabled = useGapLineFill and mtf3GapFinderEnabled and (showMtf3GapBands or mtf3DeliveryEnabled)
bool gapMtf4DetectEnabled = useGapLineFill and mtf4GapFinderEnabled and (showMtf4GapBands or mtf4DeliveryEnabled)
bool gapMtf1Enabled = useGapLineFill and mtf1GapFinderEnabled and showMtf1GapBands
bool gapMtf2Enabled = useGapLineFill and mtf2GapFinderEnabled and showMtf2GapBands
bool gapMtf3Enabled = useGapLineFill and mtf3GapFinderEnabled and showMtf3GapBands
bool gapMtf4Enabled = useGapLineFill and mtf4GapFinderEnabled and showMtf4GapBands

[gapMtf1Time, newGapMtf1Bar, bullLogicGapMtf1Raw, topBullGapMtf1Raw, botBullGapMtf1Raw, bearLogicGapMtf1Raw, topBearGapMtf1Raw, botBearGapMtf1Raw, bullLogicGapMtf1, bearLogicGapMtf1] =
     f_gapDetectAndCreate(mtf1GapFvgTf, GAP_SET_MTF1, gapMtf1DetectEnabled, gapMtf1Enabled)
[gapMtf2Time, newGapMtf2Bar, bullLogicGapMtf2Raw, topBullGapMtf2Raw, botBullGapMtf2Raw, bearLogicGapMtf2Raw, topBearGapMtf2Raw, botBearGapMtf2Raw, bullLogicGapMtf2, bearLogicGapMtf2] =
     f_gapDetectAndCreate(mtf2GapFvgTf, GAP_SET_MTF2, gapMtf2DetectEnabled, gapMtf2Enabled)
[gapMtf3Time, newGapMtf3Bar, bullLogicGapMtf3Raw, topBullGapMtf3Raw, botBullGapMtf3Raw, bearLogicGapMtf3Raw, topBearGapMtf3Raw, botBearGapMtf3Raw, bullLogicGapMtf3, bearLogicGapMtf3] =
     f_gapDetectAndCreate(mtf3GapFvgTf, GAP_SET_MTF3, gapMtf3DetectEnabled, gapMtf3Enabled)
[gapMtf4Time, newGapMtf4Bar, bullLogicGapMtf4Raw, topBullGapMtf4Raw, botBullGapMtf4Raw, bearLogicGapMtf4Raw, topBearGapMtf4Raw, botBearGapMtf4Raw, bullLogicGapMtf4, bearLogicGapMtf4] =
     f_gapDetectAndCreate(mtf4GapFvgTf, GAP_SET_MTF4, gapMtf4DetectEnabled, gapMtf4Enabled)
f_updateHtfZones(float[] tops, float[] bots, bool[] touchedLowArr, bool[] touchedHighArr, int[] originIdxArr, int[] originTimeArr, box[] boxArr, int[] idArr,
     int[] mitigatedIds, int[] mitigatedBars, bool showBoxes, color zoneColor, int zoneTransp, bool isBull, bool useWick, int currentTfTime) =>
    int n = array.size(tops)
    if n > 0
        for i = n - 1 to 0
            float top = array.get(tops, i)
            float bot = array.get(bots, i)
            int originIdx = array.get(originIdxArr, i)
            float hi = math.max(top, bot)
            float lo = math.min(top, bot)
            int originTime = array.get(originTimeArr, i)
            [hiShrunk, loShrunk, zoneShrunk] = ifvglib.shrinkFormingZone(hi, lo, isBull, originTime, currentTfTime, high, low)
            hi := hiShrunk
            lo := loShrunk
            if zoneShrunk
                array.set(tops, i, hi)
                array.set(bots, i, lo)
            bool inWindow = barNum > originIdx
            wickLow  = low
            wickHigh = high
            touchedLowPrev  = array.get(touchedLowArr, i)
            touchedHighPrev = array.get(touchedHighArr, i)
            [mitigates, touchedLowNew, touchedHighNew] = ifvglib.mitigates(inWindow, lo, hi, wickLow, wickHigh, close, touchedLowPrev, touchedHighPrev, isBull, useWick)
            array.set(touchedLowArr, i, touchedLowNew)
            array.set(touchedHighArr, i, touchedHighNew)
            box bx = array.get(boxArr, i)
            if mitigates
                int mitId = array.get(idArr, i)
                if not na(mitId)
                    array.push(mitigatedIds, mitId)
                    array.push(mitigatedBars, barNum)
                if not na(bx)
                    box.delete(bx)
                array.remove(tops, i)
                array.remove(bots, i)
                array.remove(touchedLowArr, i)
                array.remove(touchedHighArr, i)
                array.remove(originIdxArr, i)
                array.remove(originTimeArr, i)
                array.remove(boxArr, i)
                array.remove(idArr, i)
            else
                if showBoxes
                    if na(bx)
                        bx := box.new(originIdx, lo, barNum, hi, border_color=na, bgcolor=color.new(zoneColor, zoneTransp))
                        array.set(boxArr, i, bx)
                    else
                        box.set_right(bx, barNum)
                else
                    if not na(bx)
                        box.delete(bx)
                        array.set(boxArr, i, na)

    false


f_updateHtfFinder1(int zoneId, bool htfDeliveryEnabled, bool mtfFinder1Enabled, bool gapMtf1DetectEnabled, bool newGapMtf1Bar, int gapMtf1Time,
     bool bullLogicGapMtf1Raw, float topBullGapMtf1Raw, float botBullGapMtf1Raw,
     bool bearLogicGapMtf1Raw, float topBearGapMtf1Raw, float botBearGapMtf1Raw) =>
    int zone = zoneId
    bool htf1Active = htfDeliveryEnabled and mtfFinder1Enabled and gapMtf1DetectEnabled
    bool  bullLogicHtf1Raw = htf1Active ? bullLogicGapMtf1Raw : false
    float topBullHtf1Raw   = htf1Active ? topBullGapMtf1Raw : na
    float botBullHtf1Raw   = htf1Active ? botBullGapMtf1Raw : na
    bool  bearLogicHtf1Raw = htf1Active ? bearLogicGapMtf1Raw : false
    float topBearHtf1Raw   = htf1Active ? topBearGapMtf1Raw : na
    float botBearHtf1Raw   = htf1Active ? botBearGapMtf1Raw : na
    bool bullLogicHtf1 = htf1Active and newGapMtf1Bar and bullLogicHtf1Raw and not na(topBullHtf1Raw) and not na(botBullHtf1Raw) and f_hasMinWidth(topBullHtf1Raw, botBullHtf1Raw)
    bool bearLogicHtf1 = htf1Active and newGapMtf1Bar and bearLogicHtf1Raw and not na(topBearHtf1Raw) and not na(botBearHtf1Raw) and f_hasMinWidth(topBearHtf1Raw, botBearHtf1Raw)
    if bullLogicHtf1
        float rawTopB = topBullHtf1Raw
        float rawBotB = botBullHtf1Raw
        float topB = math.max(rawTopB, rawBotB)
        float botB = math.min(rawTopB, rawBotB)
        zone += 1
        array.push(htf1BullTops, topB)
        array.push(htf1BullBots, botB)
        array.push(htf1BullTouchedLow, false)
        array.push(htf1BullTouchedHigh, false)
        array.push(htf1BullOriginIdx, barNum)
        array.push(htf1BullOriginTime, gapMtf1Time)
        box bx = na
        array.push(htf1BullBoxes, bx)
        array.push(htf1BullIds, zone)
    if bearLogicHtf1
        float rawTopS = topBearHtf1Raw
        float rawBotS = botBearHtf1Raw
        float topS = math.max(rawTopS, rawBotS)
        float botS = math.min(rawTopS, rawBotS)
        zone += 1
        array.push(htf1BearTops, topS)
        array.push(htf1BearBots, botS)
        array.push(htf1BearTouchedLow, false)
        array.push(htf1BearTouchedHigh, false)
        array.push(htf1BearOriginIdx, barNum)
        array.push(htf1BearOriginTime, gapMtf1Time)
        box bxS = na
        array.push(htf1BearBoxes, bxS)
        array.push(htf1BearIds, zone)
    f_updateHtfZones(htf1BullTops, htf1BullBots, htf1BullTouchedLow, htf1BullTouchedHigh, htf1BullOriginIdx, htf1BullOriginTime, htf1BullBoxes, htf1BullIds,
         htf1BullMitIds, htf1BullMitBars, false, bullCssFinal, fvgOpacity, true, mtf1GapUseWick, gapMtf1Time)
    f_updateHtfZones(htf1BearTops, htf1BearBots, htf1BearTouchedLow, htf1BearTouchedHigh, htf1BearOriginIdx, htf1BearOriginTime, htf1BearBoxes, htf1BearIds,
         htf1BearMitIds, htf1BearMitBars, false, bearCssFinal, fvgOpacity, false, mtf1GapUseWick, gapMtf1Time)
    if hasMitCap
        int htf1Cutoff = barNum - maxMitBars
        ifvglib.cleanupHtfMitigations(htf1BullMitIds, htf1BullMitBars, htf1Cutoff)
        ifvglib.cleanupHtfMitigations(htf1BearMitIds, htf1BearMitBars, htf1Cutoff)
    bool htf1ZonesActive = array.size(htf1BullTops) + array.size(htf1BearTops) > 0
    bool htf1HasMitigated = array.size(htf1BullMitIds) + array.size(htf1BearMitIds) > 0
    if not htf1ZonesActive and not htf1HasMitigated
        ifvglib.clearTouchIds(bullFvgTouchedHtf1Id, bearFvgTouchedHtf1Id)
    zone

f_updateHtfFinder2(int zoneId, bool htfDeliveryEnabled, bool mtfFinder2Enabled, bool gapMtf2DetectEnabled, bool newGapMtf2Bar, int gapMtf2Time,
     bool bullLogicGapMtf2Raw, float topBullGapMtf2Raw, float botBullGapMtf2Raw,
     bool bearLogicGapMtf2Raw, float topBearGapMtf2Raw, float botBearGapMtf2Raw) =>
    int zone = zoneId
    bool htf2Active = htfDeliveryEnabled and mtfFinder2Enabled and gapMtf2DetectEnabled
    bool  bullLogicHtf2Raw = htf2Active ? bullLogicGapMtf2Raw : false
    float topBullHtf2Raw   = htf2Active ? topBullGapMtf2Raw : na
    float botBullHtf2Raw   = htf2Active ? botBullGapMtf2Raw : na
    bool  bearLogicHtf2Raw = htf2Active ? bearLogicGapMtf2Raw : false
    float topBearHtf2Raw   = htf2Active ? topBearGapMtf2Raw : na
    float botBearHtf2Raw   = htf2Active ? botBearGapMtf2Raw : na
    bool bullLogicHtf2 = htf2Active and newGapMtf2Bar and bullLogicHtf2Raw and not na(topBullHtf2Raw) and not na(botBullHtf2Raw) and f_hasMinWidth(topBullHtf2Raw, botBullHtf2Raw)
    bool bearLogicHtf2 = htf2Active and newGapMtf2Bar and bearLogicHtf2Raw and not na(topBearHtf2Raw) and not na(botBearHtf2Raw) and f_hasMinWidth(topBearHtf2Raw, botBearHtf2Raw)
    if bullLogicHtf2
        float rawTopB2 = topBullHtf2Raw
        float rawBotB2 = botBullHtf2Raw
        float topB2 = math.max(rawTopB2, rawBotB2)
        float botB2 = math.min(rawTopB2, rawBotB2)
        zone += 1
        array.push(htf2BullTops, topB2)
        array.push(htf2BullBots, botB2)
        array.push(htf2BullTouchedLow, false)
        array.push(htf2BullTouchedHigh, false)
