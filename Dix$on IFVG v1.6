f_trimMsLevels(int cap, line[] linesArr, label[] labelsArr, int[] sessionsArr) =>
    while cap > 0 and array.size(linesArr) > cap
        line ln = array.pop(linesArr)
        if not na(ln)
            line.delete(ln)
        if array.size(labelsArr) > 0
            label lb = array.pop(labelsArr)
            if not na(lb)
                label.delete(lb)
        if array.size(sessionsArr) > 0
            array.pop(sessionsArr)
    false

f_pruneMsSessions(int sessionCap, int currentSession, line[] linesArr, label[] labelsArr, int[] sessionsArr) =>
    if sessionCap > 0
        int oldest = ta.valuewhen(ta.change(currentSession) != 0, currentSession, sessionCap - 1)
        if not na(oldest) and array.size(linesArr) > 0 and array.size(sessionsArr) > 0
            for idx = array.size(linesArr) - 1 to 0
                int sess = array.size(sessionsArr) > idx ? array.get(sessionsArr, idx) : na
                if not na(sess) and sess < oldest
                    line ln = array.remove(linesArr, idx)
                    if not na(ln)
                        line.delete(ln)
                    if array.size(labelsArr) > idx
                        label lb = array.remove(labelsArr, idx)
                        if not na(lb)
                            label.delete(lb)
                    if array.size(sessionsArr) > idx
                        array.remove(sessionsArr, idx)
    false

