            if not locked and not na(b)
                float topTarget = high + pad
                float botTarget = low - pad
                float centerTop = close + pad
                float centerBot = close - pad
                bool started = array.get(macroBoxStarted, i)
                if time < startTs
                    box.set_top(b, centerTop)
                    box.set_bottom(b, centerBot)
                else if inWindow
                    float curTop = box.get_top(b)
                    float curBot = box.get_bottom(b)
                    box.set_top(b, math.max(curTop, topTarget))
                    box.set_bottom(b, math.min(curBot, botTarget))
                    if not started
                        array.set(macroBoxStarted, i, true)
                else if time > endTs
                    array.set(macroBoxLocked, i, true)

                label lb = array.get(macroBoxLabels, i)
                string lblTxt = array.get(macroBoxLabelTexts, i)
                color lblCol = array.get(macroBoxLabelColors, i)
                if showMacroLabels
                    int labelX = int(math.round((startTs + endTs) * 0.5))
                    float labelY = box.get_bottom(b)
                    if na(lb)
                        lb := label.new(labelX, labelY, lblTxt, xloc=xloc.bar_time, style=label.style_label_up, textcolor=color.white, color=color.new(lblCol, 100), size=size.tiny)
                        array.set(macroBoxLabels, i, lb)
                    else
                        label.set_x(lb, labelX)
                        label.set_y(lb, labelY)
                        label.set_text(lb, lblTxt)
                        color macroLabelColor = color.new(lblCol, 100)
                        label.set_color(lb, macroLabelColor)
                        label.set_textcolor(lb, color.white)
                        label.set_style(lb, label.style_label_up)
                        label.set_size(lb, size.tiny)
                else if not na(lb)
                    label.delete(lb)
                    array.set(macroBoxLabels, i, na)
color bodyColor = showBarColors ? (currentTradeDirStored == 1 ? tradeLongColorFinal : currentTradeDirStored == -1 ? tradeShortColorFinal : color.gray) : na
barcolor(bodyColor)
plotcandle(open, high, low, close, title="Dix$on FVG Trade Candles", color=bodyColor, wickcolor=bodyColor, bordercolor=bodyColor)
