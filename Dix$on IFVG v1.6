f_gapCountEnabled(int[] gapSetId, bool useDaily, bool useM1, bool useM2, bool useM3, bool useM4) =>
    int count = 0
    int n = array.size(gapSetId)
    if n > 0
        for idx = 0 to n - 1
            int setId = array.get(gapSetId, idx)
            bool include =
                 (useDaily and setId == GAP_SET_DAILY) or
                 (useM1 and setId == GAP_SET_MTF1) or
                 (useM2 and setId == GAP_SET_MTF2) or
                 (useM3 and setId == GAP_SET_MTF3) or
                 (useM4 and setId == GAP_SET_MTF4)
            if include
                count += 1
    count


