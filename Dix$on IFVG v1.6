f_trackIFVGLabel(label lb, int sess) =>
    if not na(lb)
        array.push(ifvgLabels, lb)
        array.push(ifvgLabelSession, sess)

f_cleanupIfvgObjects(int cutoffSess) =>
    if ifvgSessionLookback == 0
        false
    else
        int nLbl = array.size(ifvgLabels)
        if nLbl > 0
            for i = nLbl - 1 to 0
                int sess = array.get(ifvgLabelSession, i)
                if sess < cutoffSess
                    label lb = array.get(ifvgLabels, i)
                    if not na(lb)
                        label.delete(lb)
                    array.remove(ifvgLabels, i)
                    array.remove(ifvgLabelSession, i)

        int nBox = array.size(ifvgBoxes)
        if nBox > 0
            for i = nBox - 1 to 0
                int sess = array.get(ifvgBoxSession, i)
                if sess < cutoffSess
                    box bx = array.get(ifvgBoxes, i)
                    if not na(bx)
                        box.delete(bx)
                    array.remove(ifvgBoxes, i)
                    array.remove(ifvgBoxSession, i)

        int nLine = array.size(ifvgLines)
        if nLine > 0
            for i = nLine - 1 to 0
                int sess = array.get(ifvgLineSession, i)
                if sess < cutoffSess
                    line ln = array.get(ifvgLines, i)
                    if not na(ln)
                        line.delete(ln)
                    array.remove(ifvgLines, i)
                    array.remove(ifvgLineSession, i)

        int nFill = array.size(ifvgFills)
        if nFill > 0
            for i = nFill - 1 to 0
                int sess = array.get(ifvgFillSession, i)
                if sess < cutoffSess
                    linefill lf = array.get(ifvgFills, i)
                    if not na(lf)
                        linefill.delete(lf)
                    array.remove(ifvgFills, i)
                    array.remove(ifvgFillSession, i)

        false

