f_liqLevelLabelText(int idx, bool isHigh, float price, int[] tfFlagsArr) =>
    string baseTxt = (isHigh ? "BSL" : "SSL") + " • $" + str.tostring(price, format.mintick)
    int flags = array.size(tfFlagsArr) > idx ? array.get(tfFlagsArr, idx) : TF_NONE
