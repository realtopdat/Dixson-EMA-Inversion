f_noDailyGapIn3BarsCore() =>
    bool newDayLocal = ta.change(time("D")) != 0
    bool gapBetween0and1 = newDayLocal and (low > high[1] or high < low[1])
    bool gapBetween1and2 = newDayLocal[1] and (low[1] > high[2] or high[1] < low[2])
    not (gapBetween0and1 or gapBetween1and2)

f_ifvgSecurityPack() =>
