f_addLiquidityLevel(float level, int startTime, bool isHigh, int cls, int sessionId, int maxPerSession,
     float[] prices, bool[] isHighs, int[] classes, line[] linesArr, label[] labelsArr, int[] sweeps, int[] sweepTimes, int[] sessions, int[] startBars, int[] startTimes,
     bool[] isReqArr, box[] zoneBoxes, bool[] zoneBrokenTopArr, bool[] zoneBrokenBtmArr, bool[] zoneBrokenArr,
     int[] tfFlagsArr, float[] pivPricesA, bool[] pivIsHighA) =>
    float threshold = reqThresholdTicks * syminfo.mintick
    int processCap = math.min(array.size(prices), liqConfluencePoolCap)
    int keepIdx = na
    float mergedPrice = level
    int[] matchIdxs = array.new_int()

    if enableRelativeEqualMerge and array.size(prices) > 0
        int mergeStart = math.max(array.size(prices) - processCap, 0)
        for idx = mergeStart to array.size(prices) - 1
            int sweepBar = array.size(sweeps) > idx ? array.get(sweeps, idx) : na
            bool isAlive = na(sweepBar)
            bool sameSide = array.size(isHighs) > idx and array.get(isHighs, idx) == isHigh
            float existingPrice = array.size(prices) > idx ? array.get(prices, idx) : na
            bool within = not na(existingPrice) and math.abs(existingPrice - level) <= threshold
            if isAlive and sameSide and within
                if na(keepIdx)
                    keepIdx := idx
                array.push(matchIdxs, idx)
                mergedPrice := isHigh ? math.max(mergedPrice, existingPrice) : math.min(mergedPrice, existingPrice)

    if array.size(matchIdxs) > 0 and not na(keepIdx)
        int mergedFlags = TF_BASE
        for i = 0 to array.size(matchIdxs) - 1
            int idxForFlags = array.get(matchIdxs, i)
            if array.size(tfFlagsArr) > idxForFlags
                mergedFlags := ifvglib.flagOrBit(mergedFlags, array.get(tfFlagsArr, idxForFlags), TF_BIT_MASKS)
        mergedFlags := ifvglib.flagOrBit(mergedFlags, ifvglib.computeLevelTfFlags(mergedPrice, isHigh, enableConfA, reqThresholdTicks, syminfo.mintick, TF_BASE, TF_A, pivPricesA, pivIsHighA), TF_BIT_MASKS)
        array.set(prices, keepIdx, mergedPrice)
        array.set(isReqArr, keepIdx, true)
        array.set(sessions, keepIdx, sessionId)
        if array.size(tfFlagsArr) > keepIdx
            array.set(tfFlagsArr, keepIdx, mergedFlags)
        line keepLine = array.size(linesArr) > keepIdx ? array.get(linesArr, keepIdx) : na
        color keepZoneColor = f_liqLevelColor(true)
        if not na(keepLine)
            line.set_y1(keepLine, mergedPrice)
            line.set_y2(keepLine, mergedPrice)
            line.set_color(keepLine, keepZoneColor)
        label keepLabel = array.size(labelsArr) > keepIdx ? array.get(labelsArr, keepIdx) : na
        int keepSweepBar = array.size(sweeps) > keepIdx ? array.get(sweeps, keepIdx) : na
        bool allowMergedVisual = barstate.islast and not na(keepLine) and ((na(keepSweepBar) and showAliveLiquidityLevels) or (not na(keepSweepBar) and showDeadLiquidityLevels))
        if allowMergedVisual
            float labelPrice = mergedPrice
            keepLabel := f_upsertLiqLabel(keepLabel, bar_index, labelPrice, f_liqLevelLabelText(keepIdx, isHigh, mergedPrice, tfFlagsArr),
                 keepZoneColor, xloc.bar_index, isHigh ? label.style_label_lower_right : label.style_label_upper_right, yloc.price, text.align_right)
            if array.size(labelsArr) > keepIdx
                array.set(labelsArr, keepIdx, keepLabel)
        else if not na(keepLabel)
            label.delete(keepLabel)
            if array.size(labelsArr) > keepIdx
                array.set(labelsArr, keepIdx, na)
        for i = array.size(matchIdxs) - 1 to 0
            int idx = array.get(matchIdxs, i)
            if idx != keepIdx
                f_removeLiquidityAtIndex(idx, prices, isHighs, classes, linesArr, labelsArr, sweeps, sweepTimes, sessions, startBars,
                     startTimes, isReqArr, zoneBoxes, zoneBrokenTopArr, zoneBrokenBtmArr, zoneBrokenArr, tfFlagsArr)
        keepLine
    else
        color lineCol = f_liqLevelColor(false)
        int createdStartBar = bar_index
        int initialSweepBar = na
        int initialSweepTime = na
        int confirmLookback = math.min(math.max(externalPivotRight, 1), bar_index)
        if confirmLookback > 0
            for offset = confirmLookback - 1 to 0
                if isHigh ? high[offset] > level : low[offset] < level
                    initialSweepBar := (bar_index + 1) - offset
                    initialSweepTime := time[offset]
                    break
        bool isDeadOnCreate = not na(initialSweepBar)
        bool plotNow = barstate.islast and ((not isDeadOnCreate and showAliveLiquidityLevels) or (isDeadOnCreate and showDeadLiquidityLevels))
        int lineEnd = not na(initialSweepTime) ? initialSweepTime : time
        line ln = plotNow ? line.new(startTime, level, lineEnd, level, extend=extend.none, color=lineCol,
             style=f_liqLineStyle(), width=liquidityLineWidth, xloc=xloc.bar_time) : na
        array.push(prices, level)
        array.push(isHighs, isHigh)
        array.push(classes, cls)
        array.push(linesArr, ln)
        array.push(labelsArr, na)
        array.push(sweeps, initialSweepBar)
        array.push(sweepTimes, initialSweepTime)
        array.push(sessions, sessionId)
        array.push(startBars, createdStartBar)
        array.push(startTimes, startTime)
        array.push(isReqArr, false)
        array.push(tfFlagsArr, ifvglib.flagOrBit(TF_BASE, ifvglib.computeLevelTfFlags(level, isHigh, enableConfA, reqThresholdTicks, syminfo.mintick, TF_BASE, TF_A, pivPricesA, pivIsHighA), TF_BIT_MASKS))
        box bx = na
        array.push(zoneBoxes, bx)
        array.push(zoneBrokenTopArr, false)
        array.push(zoneBrokenBtmArr, false)
        array.push(zoneBrokenArr, false)
        ln

f_reclassifyLiquidity(float rangeHigh, float rangeLow, bool rangeValid, float[] prices, bool[] isHighs, int[] classes,
     line[] linesArr, label[] labelsArr, int[] sweeps, bool[] isReqArr, int[] tfFlagsArr) =>
    if array.size(linesArr) > 0
        for idx = 0 to array.size(linesArr) - 1
            int sweepBar = array.size(sweeps) > idx ? array.get(sweeps, idx) : na
            if not na(sweepBar)
                continue
            float lvl = array.size(prices) > idx ? array.get(prices, idx) : na
            bool isHigh = array.size(isHighs) > idx ? array.get(isHighs, idx) : false
            int currentClass = array.size(classes) > idx ? array.get(classes, idx) : LIQ_CLASS_UNKNOWN
            int newClass = f_classifyLiquidity(lvl, isHigh, rangeValid, rangeHigh, rangeLow)
            if newClass != currentClass
                array.set(classes, idx, newClass)
                line ln = array.get(linesArr, idx)
                bool isReq = array.size(isReqArr) > idx ? array.get(isReqArr, idx) : false
                color lineCol = f_liqLevelColor(isReq)
                if not na(ln)
                    line.set_color(ln, lineCol)
                    line.set_style(ln, f_liqLineStyle())
                label lb = array.size(labelsArr) > idx ? array.get(labelsArr, idx) : na
                if not na(ln)
                    float labelPrice = lvl
                    lb := f_upsertLiqLabel(lb, bar_index, labelPrice, f_liqLevelLabelText(idx, isHigh, lvl, tfFlagsArr),
                         lineCol, xloc.bar_index, isHigh ? label.style_label_lower_right : label.style_label_upper_right, yloc.price, text.align_right)
                    if array.size(labelsArr) > idx
                        array.set(labelsArr, idx, lb)
                else if not na(lb)
                    label.delete(lb)
                    if array.size(labelsArr) > idx
                        array.set(labelsArr, idx, na)


f_updateLiquidityLevels(int sweepLookback, float[] prices, bool[] isHighs, int[] classes, line[] linesArr, label[] labelsArr,
     int[] sweeps, int[] sweepTimes, int[] startBars, int[] startTimes, bool[] isReqArr, box[] zoneBoxes, bool[] zoneBrokenTopArr,
     bool[] zoneBrokenBtmArr, bool[] zoneBrokenArr, int[] tfFlagsArr) =>
    bool sweepHit = false
    bool sweepBuysideHit = false
    bool sweepSellsideHit = false
    bool sweepInternalHit = false
    bool sweepExternalHit = false
    bool sweepUnknownHit = false
    bool sweepInternalBuysideHit = false
    bool sweepInternalSellsideHit = false
    bool sweepExternalBuysideHit = false
    bool sweepExternalSellsideHit = false
    bool sweepUnknownBuysideHit = false
    bool sweepUnknownSellsideHit = false
    bool sweepExternalHighHit = false
    bool sweepExternalLowHit = false
    int sweepIdx = na
    int sweepBarOut = na
    if array.size(linesArr) > 0
        int processCap = math.min(array.size(linesArr), liqConfluencePoolCap)
        int scanStart = math.max(array.size(linesArr) - processCap, 0)
        for idx = scanStart to array.size(linesArr) - 1
            line ln = array.size(linesArr) > idx ? array.get(linesArr, idx) : na
            float lvl = array.size(prices) > idx ? array.get(prices, idx) : na
            bool isHigh = array.size(isHighs) > idx ? array.get(isHighs, idx) : false
            int cls = array.size(classes) > idx ? array.get(classes, idx) : LIQ_CLASS_UNKNOWN
            bool isReq = array.size(isReqArr) > idx ? array.get(isReqArr, idx) : false
            color lineCol = f_liqLevelColor(isReq)
            int sweepBar = array.size(sweeps) > idx ? array.get(sweeps, idx) : na
            int sweepTime = array.size(sweepTimes) > idx ? array.get(sweepTimes, idx) : na
            bool hasSwept = not na(sweepBar)
            bool touchedNow = isHigh ? high > lvl : low < lvl
            bool swept = not hasSwept and touchedNow
            if swept
                sweepBar := na(sweepBar) ? bar_index + 1 : sweepBar
                if array.size(sweeps) > idx
                    array.set(sweeps, idx, sweepBar)
                sweepTime := time
                if array.size(sweepTimes) > idx
                    array.set(sweepTimes, idx, sweepTime)
                sweepIdx := idx
                sweepBarOut := sweepBar
            int lineStartBar = array.size(startBars) > idx ? array.get(startBars, idx) : na
            bool doVisualUpdate = ((barstate.islast or barstate.isrealtime) or (not na(lineStartBar) and bar_index - lineStartBar <= BACKFILL_ACTIVE_WINDOW))
            if not na(ln) and doVisualUpdate
                int lineEnd = not na(sweepTime) ? sweepTime : time
                int storedStartTime = array.size(startTimes) > idx ? array.get(startTimes, idx) : na
                int startOffset = not na(lineStartBar) ? math.min(math.max(bar_index - lineStartBar, 0), BACKFILL_HISTORY_CAP) : na
                int startTime = not na(storedStartTime) ? storedStartTime : not na(startOffset) ? time[startOffset] : time
                line.set_x1(ln, startTime)
                line.set_x2(ln, lineEnd)
                line.set_y1(ln, lvl)
                line.set_y2(ln, lvl)
                line.set_color(ln, lineCol)
                line.set_style(ln, f_liqLineStyle())
            sweepHit := sweepHit or swept
            if swept
                sweepBuysideHit := sweepBuysideHit or isHigh
                sweepSellsideHit := sweepSellsideHit or not isHigh
                sweepInternalHit := sweepInternalHit or (cls == LIQ_CLASS_INTERNAL)
                sweepExternalHit := sweepExternalHit or (cls == LIQ_CLASS_EXTERNAL)
                sweepUnknownHit := sweepUnknownHit or (cls == LIQ_CLASS_UNKNOWN)
                sweepInternalBuysideHit := sweepInternalBuysideHit or (cls == LIQ_CLASS_INTERNAL and isHigh)
                sweepInternalSellsideHit := sweepInternalSellsideHit or (cls == LIQ_CLASS_INTERNAL and not isHigh)
                sweepExternalBuysideHit := sweepExternalBuysideHit or (cls == LIQ_CLASS_EXTERNAL and isHigh)
                sweepExternalSellsideHit := sweepExternalSellsideHit or (cls == LIQ_CLASS_EXTERNAL and not isHigh)
                sweepUnknownBuysideHit := sweepUnknownBuysideHit or (cls == LIQ_CLASS_UNKNOWN and isHigh)
                sweepUnknownSellsideHit := sweepUnknownSellsideHit or (cls == LIQ_CLASS_UNKNOWN and not isHigh)
                sweepExternalHighHit := sweepExternalHighHit or (cls == LIQ_CLASS_EXTERNAL and isHigh)
                sweepExternalLowHit := sweepExternalLowHit or (cls == LIQ_CLASS_EXTERNAL and not isHigh)
            if not na(ln) and doVisualUpdate
                label lb = array.size(labelsArr) > idx ? array.get(labelsArr, idx) : na
                float labelPrice = lvl
                string liqLblTxt = (barstate.islast or barstate.isrealtime) ? f_liqLevelLabelText(idx, isHigh, lvl, tfFlagsArr) : (not na(lb) ? label.get_text(lb) : "")
                lb := f_upsertLiqLabel(lb, bar_index, labelPrice, liqLblTxt,
                     lineCol, xloc.bar_index, isHigh ? label.style_label_lower_right : label.style_label_upper_right, yloc.price, text.align_right)
                if array.size(labelsArr) > idx
                    array.set(labelsArr, idx, lb)

            // liquidity zone boxes removed
    [sweepHit, sweepBuysideHit, sweepSellsideHit, sweepInternalHit, sweepExternalHit, sweepUnknownHit, sweepInternalBuysideHit, sweepInternalSellsideHit, sweepExternalBuysideHit, sweepExternalSellsideHit, sweepUnknownBuysideHit, sweepUnknownSellsideHit, sweepExternalHighHit, sweepExternalLowHit, sweepIdx, sweepBarOut]

f_applyLiquidityDisplayCap(int cap, int[] forceSweepBars, float[] prices, bool[] isHighs, int[] classes, line[] linesArr, label[] labelsArr,
     int[] sweeps, int[] sweepTimes, int[] sessions, int[] startBars, int[] startTimes, bool[] isReqArr, int oldestSess, int[] tfFlagsArr) =>
    int sz = array.size(prices)
    if (barstate.islast or barstate.isrealtime) and sz > 0
        int aliveBuysideShown = 0
        int aliveSellsideShown = 0
        int deadBuysideShown = 0
        int deadSellsideShown = 0
        int totalShown = 0
        int maxVisible = cap > 0 ? cap : 500
        int processCap = math.min(sz, liqConfluencePoolCap)

        for rev = 0 to processCap - 1
            int idx = sz - 1 - rev
            int sess = array.size(sessions) > idx ? array.get(sessions, idx) : na
            int sweepBar = array.size(sweeps) > idx ? array.get(sweeps, idx) : na
            bool isDead = not na(sweepBar)
            bool isHigh = array.size(isHighs) > idx ? array.get(isHighs, idx) : false
            float lvl = array.size(prices) > idx ? array.get(prices, idx) : na
            bool inSession = liquiditySessionCap == 0 or na(oldestSess) or (not na(sess) and sess >= oldestSess)
            bool forceShow = (not na(sweepBar) and array.includes(forceSweepBars, sweepBar))

            int closerSameTypeCount = 0
            if not forceShow and inSession and not na(lvl)
                float refDist = math.abs(lvl - close)
                for cmpRev = 0 to processCap - 1
                    int cmpIdx = sz - 1 - cmpRev
                    if cmpIdx == idx
                        continue
                    int cmpSess = array.size(sessions) > cmpIdx ? array.get(sessions, cmpIdx) : na
                    bool cmpInSession = liquiditySessionCap == 0 or na(oldestSess) or (not na(cmpSess) and cmpSess >= oldestSess)
                    if not cmpInSession
                        continue
                    int cmpSweep = array.size(sweeps) > cmpIdx ? array.get(sweeps, cmpIdx) : na
                    bool cmpIsDead = not na(cmpSweep)
                    bool cmpIsHigh = array.size(isHighs) > cmpIdx ? array.get(isHighs, cmpIdx) : false
                    if cmpIsDead != isDead or cmpIsHigh != isHigh
                        continue
                    float cmpLvl = array.size(prices) > cmpIdx ? array.get(prices, cmpIdx) : na
                    if na(cmpLvl)
                        continue
                    float cmpDist = math.abs(cmpLvl - close)
                    if cmpDist < refDist or (cmpDist == refDist and cmpIdx > idx)
                        closerSameTypeCount += 1

            bool allowType = forceShow or (isDead ? (liquidityDeadLevelCap == 0 or closerSameTypeCount < liquidityDeadLevelCap) : (liquidityAliveLevelCap == 0 or closerSameTypeCount < liquidityAliveLevelCap))
            bool allowVisual = (forceShow or (na(sweepBar) and showAliveLiquidityLevels) or (not na(sweepBar) and showDeadLiquidityLevels))
            bool allowBudget = forceShow or totalShown < maxVisible
            bool allow = (forceShow or (inSession and allowType)) and allowVisual and allowBudget
            line ln = array.size(linesArr) > idx ? array.get(linesArr, idx) : na
            label lb = array.size(labelsArr) > idx ? array.get(labelsArr, idx) : na
            if allow
                if isDead
                    if isHigh
                        deadBuysideShown += 1
                    else
                        deadSellsideShown += 1
                else
                    if isHigh
                        aliveBuysideShown += 1
                    else
                        aliveSellsideShown += 1
                totalShown += 1
                bool isReq = array.size(isReqArr) > idx ? array.get(isReqArr, idx) : false
                color lineCol = f_liqLevelColor(isReq)
                int sweepTime = array.size(sweepTimes) > idx ? array.get(sweepTimes, idx) : na
                int lineEnd = not na(sweepTime) ? sweepTime : time
                int startBar = array.size(startBars) > idx ? array.get(startBars, idx) : na
                int storedStartTime = array.size(startTimes) > idx ? array.get(startTimes, idx) : na
                int startOffset = not na(startBar) ? math.min(math.max(bar_index - startBar, 0), BACKFILL_HISTORY_CAP) : na
                int startTime = not na(storedStartTime) ? storedStartTime : not na(startOffset) ? time[startOffset] : time
                if na(ln)
                    ln := line.new(startTime, lvl, lineEnd, lvl, extend=extend.none,
                         color=lineCol,
                         style=f_liqLineStyle(), width=liquidityLineWidth, xloc=xloc.bar_time)
                    if array.size(linesArr) > idx
                        array.set(linesArr, idx, ln)
                else
                    line.set_x1(ln, startTime)
                    line.set_x2(ln, lineEnd)
                    line.set_y1(ln, lvl)
                    line.set_y2(ln, lvl)
                    line.set_color(ln, lineCol)
                    line.set_style(ln, f_liqLineStyle())
                float labelPrice = lvl
                lb := f_upsertLiqLabel(lb, lineEnd, labelPrice, f_liqLevelLabelText(idx, isHigh, lvl, tfFlagsArr),
                     lineCol, xloc.bar_time, isHigh ? label.style_label_lower_right : label.style_label_upper_right, yloc.price, text.align_right)
                if array.size(labelsArr) > idx
                    array.set(labelsArr, idx, lb)
            else
                if not na(ln)
                    line.delete(ln)
                    if array.size(linesArr) > idx
                        array.set(linesArr, idx, na)
                if not na(lb)
                    label.delete(lb)
                    if array.size(labelsArr) > idx
                        array.set(labelsArr, idx, na)

