f_addMacroBox(bool enabled, string sessionStr, color fillColor, int sessionId) =>
    if enabled
        string[] parts = str.split(sessionStr, "-")
        string startStr = array.size(parts) > 0 ? array.get(parts, 0) : ""
        string endStr = array.size(parts) > 1 ? array.get(parts, 1) : ""
        string startClean = str.length(startStr) == 3 ? "0" + startStr : startStr
        string endClean = str.length(endStr) == 3 ? "0" + endStr : endStr
        int startHr = int(str.tonumber(str.substring(startClean, 0, 2)))
        int startMin = int(str.tonumber(str.substring(startClean, 2, 4)))
        int endHr = int(str.tonumber(str.substring(endClean, 0, 2)))
        int endMin = int(str.tonumber(str.substring(endClean, 2, 4)))
        bool ok = not na(startHr) and not na(startMin) and not na(endHr) and not na(endMin)
        int startTs = ok ? timestamp(syminfo.timezone, year, month, dayofmonth, startHr, startMin) : na
        int endTs = ok ? timestamp(syminfo.timezone, year, month, dayofmonth, endHr, endMin) : na
        if not na(startTs) and not na(endTs)
            string labelTxt = ok ? ((startHr < 10 ? "0" : "") + str.tostring(startHr) + ":" + (startMin < 10 ? "0" : "") + str.tostring(startMin) + "-" + (endHr < 10 ? "0" : "") + str.tostring(endHr) + ":" + (endMin < 10 ? "0" : "") + str.tostring(endMin) + " Macro") : (sessionStr + " Macro")
            box b = box.new(startTs, 1e10, endTs, -1e10, xloc=xloc.bar_time, bgcolor=fillColor, border_color=na)
            array.push(macroBoxes, b)
            array.push(macroBoxSessions, sessionId)
            array.push(macroBoxStarts, startTs)
            array.push(macroBoxEnds, endTs)
            array.push(macroBoxStarted, false)
            array.push(macroBoxLocked, false)
            array.push(macroBoxLabels, na)
            array.push(macroBoxLabelTexts, labelTxt)
            array.push(macroBoxLabelColors, fillColor)

