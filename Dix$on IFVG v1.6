f_pushConfPivot(float pivotPrice, bool isHigh, float[] pivPrices, bool[] pivIsHigh, int maxPivots) =>
    if not na(pivotPrice)
        bool isDup = array.size(pivPrices) > 0 and array.size(pivIsHigh) > 0 and array.get(pivIsHigh, array.size(pivIsHigh) - 1) == isHigh and array.get(pivPrices, array.size(pivPrices) - 1) == pivotPrice
        if not isDup
            array.push(pivPrices, pivotPrice)
            array.push(pivIsHigh, isHigh)
            if maxPivots > 0
                while array.size(pivPrices) > maxPivots
                    array.shift(pivPrices)
                    if array.size(pivIsHigh) > 0
                        array.shift(pivIsHigh)

f_removeLiquidityAtIndex(int idx, float[] prices, bool[] isHighs, int[] classes, line[] linesArr, label[] labelsArr,
     int[] sweeps, int[] sweepTimes, int[] sessions, int[] startBars, int[] startTimes, bool[] isReqArr, box[] zoneBoxes,
     bool[] zoneBrokenTopArr, bool[] zoneBrokenBtmArr, bool[] zoneBrokenArr, int[] tfFlagsArr) =>
    line ln = array.size(linesArr) > idx ? array.get(linesArr, idx) : na
    label lb = array.size(labelsArr) > idx ? array.get(labelsArr, idx) : na
    box bx = array.size(zoneBoxes) > idx ? array.get(zoneBoxes, idx) : na
    if not na(ln)
        line.delete(ln)
    if not na(lb)
        label.delete(lb)
    if not na(bx)
        box.delete(bx)
    if array.size(prices) > idx
        array.remove(prices, idx)
    if array.size(isHighs) > idx
        array.remove(isHighs, idx)
    if array.size(classes) > idx
        array.remove(classes, idx)
    if array.size(linesArr) > idx
        array.remove(linesArr, idx)
    if array.size(labelsArr) > idx
        array.remove(labelsArr, idx)
    if array.size(sweeps) > idx
        array.remove(sweeps, idx)
    if array.size(sweepTimes) > idx
        array.remove(sweepTimes, idx)
    if array.size(sessions) > idx
        array.remove(sessions, idx)
    if array.size(startBars) > idx
        array.remove(startBars, idx)
    if array.size(startTimes) > idx
        array.remove(startTimes, idx)
    if array.size(isReqArr) > idx
        array.remove(isReqArr, idx)
    if array.size(zoneBoxes) > idx
        array.remove(zoneBoxes, idx)
    if array.size(zoneBrokenTopArr) > idx
        array.remove(zoneBrokenTopArr, idx)
    if array.size(zoneBrokenBtmArr) > idx
        array.remove(zoneBrokenBtmArr, idx)
    if array.size(zoneBrokenArr) > idx
        array.remove(zoneBrokenArr, idx)
    if array.size(tfFlagsArr) > idx
        array.remove(tfFlagsArr, idx)
    false


f_checkSweep(bool isHigh, float level) =>
    showLiquiditySweeps and (isHigh ?
        ((high > level and close < level) or (high[1] > level and close < level)) :
        ((low < level and close > level) or (low[1] < level and close > level)))

