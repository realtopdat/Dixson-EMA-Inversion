// Helpers
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
pmHighAccum(_inNonMktHrs) =>
    var float result = na
    if _inNonMktHrs and not _inNonMktHrs[1]
        result := high
    else if _inNonMktHrs
        result := math.max(result, high)
    result

pmLowAccum(_inNonMktHrs) =>
    var float result = na
    if _inNonMktHrs and not _inNonMktHrs[1]
        result := low
    else if _inNonMktHrs
        result := math.min(result, low)
    result

pmOpenTime(_sess) =>
    var int _openTime = na
    if _sess and not _sess[1]
        _openTime := time
    _openTime

// Day ordinal (st/nd/rd/th) without superscripts
pmDayOrdinal(_t) =>
    ddStr = str.format_time(_t, "dd", "America/New_York")
    dd    = str.tonumber(ddStr)
    last2 = dd % 100
    last1 = dd % 10
    suf   = (last2 >= 11 and last2 <= 13) ? "th" : last1 == 1 ? "st" : last1 == 2 ? "nd" : last1 == 3 ? "rd" : "th"
    str.tostring(dd) + suf

pmDowLabel(_t) =>
    _dow = dayofweek(_t, "America/New_York")
    _dow == 1 ? "Sun" : _dow == 2 ? "Mon" : _dow == 3 ? "Tue" : _dow == 4 ? "Wed" : _dow == 5 ? "Thu" : _dow == 6 ? "Fri" : "Sat"

// "PM High | Fri 17th | $687.98 "
pmBuildLabel(_isHigh, _t, _px) =>
    side = _isHigh ? "PM High" : "PM Low"
    dow  = pmDowLabel(_t)
    dom  = pmDayOrdinal(_t)
    priceTxt = "$" + str.tostring(_px, "#.00")
    side + " | " + dow + " " + dom + " | " + priceTxt + " "

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Globals (for alerts)
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
var float lastPreMktHi = na
var float lastPreMktLo = na

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Main
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
colorNone = color.new(color.white, 100)

if pmTog
    inNonMktHrs = not na(time(timeframe.period, pmNonMktSession, "America/New_York"))
    inRegSess   = not na(time(timeframe.period, pmRegSession,    "America/New_York"))

    // Track the last in-RTH bar time; used to cap lines at RTH close
    var int rthLastBarTime = na
    rthLastBarTime := inRegSess ? time : nz(rthLastBarTime[1])

    // Detect RTH close on this bar
    justClosedRTH = inRegSess[1] and not inRegSess

    // Compute once per bar (prevents consistency warnings)
    prevRthCloseTime = ta.valuewhen(inRegSess[1] and not inRegSess, rthLastBarTime[1], 0)

    // Extended-session source for pre-market extremes
    extendedTicker   = ticker.modify(syminfo.ticker, session=session.extended)
    tickerExtHighest = request.security(extendedTicker, timeframe.period, pmHighAccum(inNonMktHrs)[1], lookahead=barmerge.lookahead_on)
    tickerExtLowest  = request.security(extendedTicker, timeframe.period, pmLowAccum(inNonMktHrs)[1],  lookahead=barmerge.lookahead_on)
    nonMktHrsStart   = request.security(extendedTicker, timeframe.period, pmOpenTime(inNonMktHrs))

    // State
    var line     pmHiLine = na
    var label    pmHiLab  = na
    var line[]   pmHiArr  = array.new_line()
    var label[]  pmHiLabArr = array.new_label()

    var line     pmLoLine = na
    var label    pmLoLab  = na
    var line[]   pmLoArr  = array.new_line()
    var label[]  pmLoLabArr = array.new_label()

    // Track which array indexes belong to the *current* session
    var int currHiIdx = na
    var int currLoIdx = na

    // If RTH just closed, hard-cap the current session lines at their own RTH last bar and clear indices
    if justClosedRTH
        if not na(currHiIdx) and currHiIdx < array.size(pmHiArr)
            _hl   = array.get(pmHiArr, currHiIdx)
            line.set_x2(_hl, rthLastBarTime[1])
            _hlab = array.get(pmHiLabArr, currHiIdx)
            label.set_x(_hlab, rthLastBarTime[1])
        if not na(currLoIdx) and currLoIdx < array.size(pmLoArr)
            _ll   = array.get(pmLoArr, currLoIdx)
            line.set_x2(_ll, rthLastBarTime[1])
            _llab = array.get(pmLoLabArr, currLoIdx)
            label.set_x(_llab, rthLastBarTime[1])
        currHiIdx := na
        currLoIdx := na

    // â”€â”€ New session HIGH (first RTH bar)
    condNewHi = (syminfo.type == "stock" or syminfo.type == "fund") ? (session.isfirstbar_regular and pmShowHighs)
                                                                   : (inNonMktHrs[1] and not inNonMktHrs and pmShowHighs)
    if condNewHi
        lastPreMktHi := tickerExtHighest
        pmHiLine := line.new(nonMktHrsStart, tickerExtHighest, time, tickerExtHighest,
                             xloc=xloc.bar_time, style=pmLineStyle,
                             color=(pmShowLines ? pmLineColH : colorNone), width=pmLineWidth)
        txtH = pmShowLabels ? (pmShowDayDate ? pmBuildLabel(true, time, tickerExtHighest)
                                             : ("PM High | " + "$" + str.tostring(tickerExtHighest, "#.00") + " ")) : ""
        pmHiLab := label.new(time, tickerExtHighest, text=txtH,
                             style=label.style_label_left, color=colorNone,
                             textcolor=pmTextCol, xloc=xloc.bar_time, size=pmTextSize)

        array.push(pmHiArr, pmHiLine)
        array.push(pmHiLabArr, pmHiLab)

        // Mark as current-session high
        currHiIdx := array.size(pmHiArr) - 1

        // Cap the PRIOR session high at its own RTH close (hard stop)
        if array.size(pmHiArr) > 1 and not na(prevRthCloseTime)
            _prior   = array.get(pmHiArr, array.size(pmHiArr) - 2)
            _priorLb = array.get(pmHiLabArr, array.size(pmHiLabArr) - 2)
            line.set_x2(_prior, prevRthCloseTime)
            label.set_x(_priorLb, prevRthCloseTime)

        // Trim history to limit
        if array.size(pmHiArr) > pmMaxDayLines
            line.delete(array.shift(pmHiArr))
            label.delete(array.shift(pmHiLabArr))
            // Current index now points to last element
            currHiIdx := array.size(pmHiArr) - 1

    // â”€â”€ New session LOW (first RTH bar)
    condNewLo = (syminfo.type == "stock" or syminfo.type == "fund") ? (session.isfirstbar_regular and pmShowLows)
                                                                   : (inNonMktHrs[1] and not inNonMktHrs and pmShowLows)
    if condNewLo
        lastPreMktLo := tickerExtLowest
        pmLoLine := line.new(nonMktHrsStart, tickerExtLowest, time, tickerExtLowest,
                             xloc=xloc.bar_time, style=pmLineStyle,
                             color=(pmShowLines ? pmLineColL : colorNone), width=pmLineWidth)
        txtL = pmShowLabels ? (pmShowDayDate ? pmBuildLabel(false, time, tickerExtLowest)
                                             : ("PM Low | " + "$" + str.tostring(tickerExtLowest, "#.00") + " ")) : ""
        pmLoLab := label.new(time, tickerExtLowest, text=txtL,
                             style=label.style_label_left, color=colorNone,
                             textcolor=pmTextCol, xloc=xloc.bar_time, size=pmTextSize)

        array.push(pmLoArr, pmLoLine)
        array.push(pmLoLabArr, pmLoLab)

        // Mark as current-session low
        currLoIdx := array.size(pmLoArr) - 1

        // Cap the PRIOR session low at its own RTH close (hard stop)
        if array.size(pmLoArr) > 1 and not na(prevRthCloseTime)
            _prior   = array.get(pmLoArr, array.size(pmLoArr) - 2)
            _priorLb = array.get(pmLoLabArr, array.size(pmLoLabArr) - 2)
            line.set_x2(_prior, prevRthCloseTime)
            label.set_x(_priorLb, prevRthCloseTime)

        // Trim history to limit
        if array.size(pmLoArr) > pmMaxDayLines
            line.delete(array.shift(pmLoArr))
            label.delete(array.shift(pmLoLabArr))
            currLoIdx := array.size(pmLoArr) - 1

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Extend ONLY the *current* session lines each bar (during RTH)
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if inRegSess
        if not na(currHiIdx) and currHiIdx < array.size(pmHiArr)
            _currHi = array.get(pmHiArr, currHiIdx)
            line.set_x2(_currHi, time)
            _hlab = array.get(pmHiLabArr, currHiIdx)
            label.set_x(_hlab, time)

        if not na(currLoIdx) and currLoIdx < array.size(pmLoArr)
            _currLo = array.get(pmLoArr, currLoIdx)
            line.set_x2(_currLo, time)
            _llab = array.get(pmLoLabArr, currLoIdx)
            label.set_x(_llab, time)

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Alerts (unchanged)
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
pmCrossOverRaw  = ta.crossover(high, lastPreMktHi)
pmCrossUnderRaw = ta.crossunder(low,  lastPreMktLo)
pmAlertOver  = pmTog and not na(lastPreMktHi) and pmCrossOverRaw
pmAlertUnder = pmTog and not na(lastPreMktLo) and pmCrossUnderRaw
