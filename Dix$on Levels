// Kalman + avg helpers
kalman_filter(src, length, R = 0.01, Q = 0.1) =>
    var float estimate    = na
    var float error_est   = 1.0
    var float error_meas  = R * (length)
    var float kalman_gain = 0.0
    var float prediction  = na
    if na(estimate)
        estimate := src[1]
    prediction   := estimate
    kalman_gain  := error_est / (error_est + error_meas)
    estimate     := prediction + kalman_gain * (src - prediction)
    error_est    := (1 - kalman_gain) * error_est + Q / (length)
    estimate

f_getAvgByType(_type, _src, _len) =>
    _type == "EMA" ? ta.ema(_src, _len) :
     _type == "MA" ? ta.sma(_src, _len) :
     kalman_filter(_src, _len)

f_getConvertedDense(_tf, _src, _len, _type) =>
    avg = f_getAvgByType(_type, _src, _len)
    _tf == "" ? avg : request.security(syminfo.tickerid, _tf, avg, lookahead=barmerge.lookahead_on)

f_getConvertedSparse(_tf, _src, _len, _type) =>
    avg = f_getAvgByType(_type, _src, _len)
    if not i_mtf_mode
        _tf == "" ? avg : request.security(syminfo.tickerid, _tf, avg)
    else
        if _tf == ""
            avg
        else
            [m, b] = request.security(syminfo.tickerid, _tf, [avg, bar_index])
            var int lastBar = na
            lastBar := na(lastBar[1]) or b > lastBar[1] ? b : lastBar[1]
            (lastBar != lastBar[1] or barstate.islast) ? m : na

f_getConvertedStep(_tf, _src, _len, _type) =>
    avg = f_getAvgByType(_type, _src, _len)
    if _tf == "" or not i_mtf_mode
        avg
    else
        [m, b] = request.security(syminfo.tickerid, _tf, [avg, bar_index])
        var float held = na
        var int   lastB = na
        newTick = na(lastB) or b > lastB
        if newTick
            held := m
            lastB := b
        held

