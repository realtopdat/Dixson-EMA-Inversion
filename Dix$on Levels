var float short_last_sparse = na
var bool  shortVizSlopeUp   = true
if s_new and not na(short_dma_vis)
    shortVizSlopeUp := na(short_last_sparse) ? true : (short_dma_vis >= short_last_sparse)
    short_last_sparse := short_dma_vis
bool  short_slope_for_color = (i_mtf_mode and short_tf != "") ? shortVizSlopeUp : short_slope_dense

color short_line_col = short_slope_for_color ? upper_col : lower_col
color trend_col      = trend_up_smoothed ? upper_col : lower_col

// Plots + fill
p1  = plot(dktEnable and dktLinesAndFillOn and dktShowShortLine ? short_dma_vis : na, title="Short DMA", color=short_line_col, linewidth=dktLineWShort)
p2  = plot(dktEnable and dktLinesAndFillOn and dktShowLongLine  ? long_dma_vis  : na, title="Long DMA",  color=trend_col,     linewidth=dktLineWLong)
p1h = plot(dktEnable and dktLinesAndFillOn ? short_dma_step : na, title="Short DMA (fill anchor)", color=color.new(color.gray, 100), display=display.none)
p2h = plot(dktEnable and dktLinesAndFillOn ? long_dma_step  : na, title="Long DMA (fill anchor)",  color=color.new(color.gray, 100), display=display.none)
fill(p1h, p2h, short_dma_step, long_dma_step, na, (dktLinesAndFillOn and dktShowFill) ? color.new(trend_col, dktFillTransp) : na)

// Entries â€” strict gating (continuations only in trend direction)
crossUp_raw = dktEnable and not na(short_dma_step) and not na(short_dma_step[1]) and close[1] < short_dma_step[1] and close > short_dma_step
crossDn_raw = dktEnable and not na(short_dma_step) and not na(short_dma_step[1]) and close[1] > short_dma_step[1] and close < short_dma_step
bool entryUpT = dktEnable and trend_up_now     and crossUp_raw
bool entryDnT = dktEnable and not trend_up_now and crossDn_raw
int  entryUpTrend = entryUpT ? 1 : 0
int  entryDnTrend = entryDnT ? 1 : 0

// Flip arrow labels (restored)
if dktEnable and dktArrowsOn
    // Single label on fast MA with minimal offset
    float flipPad = math.max(ta.tr * 1, syminfo.mintick * 8)

    if flipUp
        // Golden below the MA
        f_placeCrossLbl(short_dma_step, "✝️\nGolden", true, flipPad * -1)

    if flipDn
        // Death above the MA
        f_placeCrossLbl(short_dma_step, "✝️\nDeath", false, flipPad * -1)

// Candle paint
color _barCol = na
if dktEnable and dktBarOn
    _barCol := trend_up_now and short_slope_dense ? dktBarUpCol :
               (not trend_up_now and not short_slope_dense ? dktBarDownCol : dktBarNeutralCol)
bool dktFlip = flipUp or flipDn
color _entryHL = na
if dktEnable and dktEntryBarHLOn
    _entryHL := ((entryUpT or entryDnT) or dktFlip) ? dktEntryConColor : na
color _bodyColor = na(_entryHL) ? _barCol : _entryHL
barcolor(dktBarOn and dktEnable ? _bodyColor : na)
plotcandle(open, high, low, close, color=color.new(_barCol, 100), wickcolor=_barCol, bordercolor=_barCol)

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ZONES â€” example logic (bar_index anchors) + strict lookback + merge no-stack
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Day/session tracking for zone lookback
int   _dayChangeRaw = ta.change(time("D"))
int   _dayChange    = na(_dayChangeRaw) ? 0 : _dayChangeRaw
bool  _newDay       = _dayChange != 0
float _dayId        = ta.cum(_newDay ? 1.0 : 0.0)
int   _currDayId    = int(_dayId)

int   _keepDays     = dktBoxesLookbackSessions - 1
int   _minDayId     = _currDayId - _keepDays

// Arrays (bar_index anchors like your example)
var line[]     _zoneTop   = array.new_line()
var line[]     _zoneBot   = array.new_line()
var linefill[] _zoneFill  = array.new_linefill()
var int[]      _zoneDayId = array.new_int()
var int[]      _zoneLeft  = array.new_int()   // bar_index anchor (left)
var bool[]     _zoneIsLow = array.new_bool()
var float[]    _zoneTopY  = array.new_float()
var float[]    _zoneBotY  = array.new_float()

// Day â†’ EndIndex map (for Extend=None clamp)
var int[] _dayIds  = array.new_int()
var int[] _dayEnds = array.new_int()

if _newDay
    int prevId = _currDayId - 1
    if prevId >= 0
        int pos = na
        int dn  = array.size(_dayIds)
        if dn > 0
            for j = dn - 1 to 0
                if array.get(_dayIds, j) == prevId
                    pos := j
                    break
        if na(pos)
            array.push(_dayIds, prevId)
            array.push(_dayEnds, bar_index - 1)
        else
            array.set(_dayEnds, pos, bar_index - 1)

f_getDayEndIdx(_d) =>
    if _d == _currDayId
        bar_index
    else
        int ee = na
        int n  = array.size(_dayIds)
        for k = n - 1 to 0
            if array.get(_dayIds, k) == _d
                ee := array.get(_dayEnds, k)
                break
        na(ee) ? bar_index : ee

// Overlap test for post-pass coalesce
f_overlapOrNear(aTop, aBot, bTop, bBot, thr) =>
    overlap = not (aBot > bTop or aTop < bBot)
    nearAB  = math.abs(aTop - bTop) <= thr or math.abs(aBot - bBot) <= thr
    crossAB = math.abs(aBot - bTop) <= thr or math.abs(aTop - bBot) <= thr
    overlap or nearAB or crossAB

// Merge NEW zone into an existing one (first hit, most recent-first)
f_tryMergeZone(_topY, _botY, _isLow) =>
    if not dktMergeZones
        na
    else
        float thr = math.max(dktMergeATRx * dktATR, syminfo.mintick)
        int sz = array.size(_zoneTop)
        int hit = na
        if sz > 0
            for i = sz - 1 to 0
                float eTop = array.get(_zoneTopY, i)
                float eBot = array.get(_zoneBotY, i)
                if f_overlapOrNear(_topY, _botY, eTop, eBot, thr)
                    hit := i
                    break
        if na(hit)
            na
        else
            float nTop = math.max(_topY, array.get(_zoneTopY, hit))
            float nBot = math.min(_botY, array.get(_zoneBotY, hit))
            array.set(_zoneTopY, hit, nTop)
            array.set(_zoneBotY, hit, nBot)
            // keep earliest left anchor
            array.set(_zoneLeft, hit, math.min(array.get(_zoneLeft, hit), bar_index))
            line lt = array.get(_zoneTop, hit)
            line lb = array.get(_zoneBot, hit)
            line.set_y1(lt, nTop), line.set_y2(lt, nTop)
            line.set_y1(lb, nBot), line.set_y2(lb, nBot)
            hit

// Latest indices for optional retest
var int latestLowIdx  = na
var int latestHighIdx = na

// Create zones on flips (two horizontal lines + linefill) â€” like your example
if dktEnable
    if flipUp and dktBoxesOn
        float topY = low + dktATR
        float botY = low
        int merged = f_tryMergeZone(topY, botY, true)
        if na(merged)
            line lt = line.new(bar_index, topY, bar_index, topY, xloc=xloc.bar_index, extend=extend.none, color=color.new(dktZoneLowBaseCol, dktZoneTransp), width=dktZoneLineWidth)
            line lb = line.new(bar_index, botY, bar_index, botY, xloc=xloc.bar_index, extend=extend.none, color=color.new(dktZoneLowBaseCol, dktZoneTransp), width=dktZoneLineWidth)
            linefill lf = linefill.new(lt, lb, color.new(dktZoneLowBaseCol, dktZoneTransp))
            array.push(_zoneTop,   lt)
            array.push(_zoneBot,   lb)
            array.push(_zoneFill,  lf)
            array.push(_zoneDayId, _currDayId)
            array.push(_zoneLeft,  bar_index)
            array.push(_zoneIsLow, true)
            array.push(_zoneTopY,  topY)
            array.push(_zoneBotY,  botY)
            latestLowIdx := array.size(_zoneTop) - 1
        else
            latestLowIdx := merged

    if flipDn and dktBoxesOn
        float topY = high
        float botY = high - dktATR
        int merged = f_tryMergeZone(topY, botY, false)
        if na(merged)
            line lt = line.new(bar_index, topY, bar_index, topY, xloc=xloc.bar_index, extend=extend.none, color=color.new(dktZoneHighBaseCol, dktZoneTransp), width=dktZoneLineWidth)
            line lb = line.new(bar_index, botY, bar_index, botY, xloc=xloc.bar_index, extend=extend.none, color=color.new(dktZoneHighBaseCol, dktZoneTransp), width=dktZoneLineWidth)
            linefill lf = linefill.new(lt, lb, color.new(dktZoneHighBaseCol, dktZoneTransp))
            array.push(_zoneTop,   lt)
            array.push(_zoneBot,   lb)
            array.push(_zoneFill,  lf)
            array.push(_zoneDayId, _currDayId)
            array.push(_zoneLeft,  bar_index)
            array.push(_zoneIsLow, false)
            array.push(_zoneTopY,  topY)
            array.push(_zoneBotY,  botY)
            latestHighIdx := array.size(_zoneTop) - 1
        else
            latestHighIdx := merged

// Maintain zones each bar: prune by lookback + extend + dynamic color
if dktEnable and dktBoxesOn
    bool extRight = dktBoxesExtendDir == "Right" or dktBoxesExtendDir == "Both"
    bool extLeft  = dktBoxesExtendDir == "Left"  or dktBoxesExtendDir == "Both"
    bool extNone  = dktBoxesExtendDir == "None"

    // Post-pass coalesce (no stacking when Merge is ON)
    if dktMergeZones
        float thrP = math.max(dktMergeATRx * dktATR, syminfo.mintick)
        int nZ = array.size(_zoneTop)
        if nZ > 1
            for a = nZ - 1 to 0
                if a < array.size(_zoneTop)
                    float aTop = array.get(_zoneTopY, a)
                    float aBot = array.get(_zoneBotY, a)
                    if a > 0
                        for b = a - 1 to 0
                            if b < array.size(_zoneTop)
                                float bTop = array.get(_zoneTopY, b)
                                float bBot = array.get(_zoneBotY, b)
                                if f_overlapOrNear(aTop, aBot, bTop, bBot, thrP)
                                    float mT = math.max(aTop, bTop)
                                    float mB = math.min(aBot, bBot)
                                    int   mL = math.min(array.get(_zoneLeft, a), array.get(_zoneLeft, b))
                                    array.set(_zoneTopY, b, mT)
                                    array.set(_zoneBotY, b, mB)
                                    array.set(_zoneLeft, b, mL)
                                    line ltB = array.get(_zoneTop, b)
                                    line lbB = array.get(_zoneBot, b)
                                    line.set_y1(ltB, mT), line.set_y2(ltB, mT)
                                    line.set_y1(lbB, mB), line.set_y2(lbB, mB)
                                    // delete a
                                    linefill lfA = array.get(_zoneFill, a)
                                    if not na(lfA)
                                        linefill.delete(lfA)
                                    line ltA = array.get(_zoneTop, a)
                                    line lbA = array.get(_zoneBot, a)
                                    if not na(ltA)
                                        line.delete(ltA)
                                    if not na(lbA)
                                        line.delete(lbA)
                                    array.remove(_zoneTop, a)
                                    array.remove(_zoneBot, a)
                                    array.remove(_zoneFill, a)
                                    array.remove(_zoneDayId, a)
                                    array.remove(_zoneLeft, a)
                                    array.remove(_zoneIsLow, a)
                                    array.remove(_zoneTopY, a)
                                    array.remove(_zoneBotY, a)
                                    // shift latest indices safely
                                    if not na(latestLowIdx)
                                        latestLowIdx  := latestLowIdx  > a ? latestLowIdx  - 1 : (latestLowIdx  == a ? na : latestLowIdx)
                                    if not na(latestHighIdx)
                                        latestHighIdx := latestHighIdx > a ? latestHighIdx - 1 : (latestHighIdx == a ? na : latestHighIdx)
                                    break

    int sz = array.size(_zoneTop)
    if sz > 0
        for i = sz - 1 to 0
            int dId = array.get(_zoneDayId, i)

            // Prune by lookback
            if dId < _minDayId
                if not na(latestLowIdx)
                    latestLowIdx  := latestLowIdx  > i ? latestLowIdx  - 1 : (latestLowIdx  == i ? na : latestLowIdx)
                if not na(latestHighIdx)
                    latestHighIdx := latestHighIdx > i ? latestHighIdx - 1 : (latestHighIdx == i ? na : latestHighIdx)
                line lt = array.get(_zoneTop, i)
                line lb = array.get(_zoneBot, i)
                linefill lf = array.get(_zoneFill, i)
                if not na(lf)
                    linefill.delete(lf)
                if not na(lt)
                    line.delete(lt)
                if not na(lb)
                    line.delete(lb)
                array.remove(_zoneTop, i)
                array.remove(_zoneBot, i)
                array.remove(_zoneFill, i)
                array.remove(_zoneDayId, i)
                array.remove(_zoneLeft, i)
                array.remove(_zoneIsLow, i)
                array.remove(_zoneTopY, i)
                array.remove(_zoneBotY, i)
            else
                // Keep + extend
                line lt = array.get(_zoneTop, i)
                line lb = array.get(_zoneBot, i)
                linefill lf = array.get(_zoneFill, i)
                int  lX = array.get(_zoneLeft, i)
                float topY = array.get(_zoneTopY, i)
                float botY = array.get(_zoneBotY, i)
                bool isLow = array.get(_zoneIsLow, i)

                // Flat Y + dynamic color
                line.set_y1(lt, topY), line.set_y2(lt, topY)
                line.set_y1(lb, botY), line.set_y2(lb, botY)
                color baseCol = isLow ? dktZoneLowBaseCol : dktZoneHighBaseCol
                color currCol = close > topY ? dktZoneAboveCol : close < botY ? dktZoneBelowCol : baseCol
                color currColT = color.new(currCol, dktZoneTransp)
                line.set_color(lt, currColT)
                line.set_color(lb, currColT)
                if not na(lf)
                    linefill.set_color(lf, color.new(currCol, dktZoneTransp))

                // Safe anchors (avoid "x1 too far" by using extend when very old)
                int MAX_BACK = 20000  // safe window; increase if needed
                int dx = bar_index - lX
                if dx <= MAX_BACK
                    line.set_x1(lt, lX), line.set_x2(lt, bar_index)
                    line.set_x1(lb, lX), line.set_x2(lb, bar_index)
                else
                    // draw from a safe window and extend left so it looks identical
                    int leftSafe = bar_index - MAX_BACK
                    line.set_x1(lt, leftSafe), line.set_x2(lt, bar_index)
                    line.set_x1(lb, leftSafe), line.set_x2(lb, bar_index)
                    line.set_extend(lt, extend.left)
                    line.set_extend(lb, extend.left)

                // Clamp to session end when Extend=None
                if dktBoxesExtendDir == "None"
                    int eX = f_getDayEndIdx(dId)
                    line.set_extend(lt, extend.none)
                    line.set_extend(lb, extend.none)
                    line.set_x2(lt, eX)
                    line.set_x2(lb, eX)
                else
                    bool createdThisBar = (bar_index == lX)
                    if createdThisBar
                        line.set_extend(lt, extend.none)
                        line.set_extend(lb, extend.none)
                    else
                        if dktBoxesExtendDir == "Both"
                            line.set_extend(lt, extend.both)
                            line.set_extend(lb, extend.both)
                        else if dktBoxesExtendDir == "Right"
                            line.set_extend(lt, extend.right)
                            line.set_extend(lb, extend.right)
                        else if dktBoxesExtendDir == "Left"
                            line.set_extend(lt, extend.left)
                            line.set_extend(lb, extend.left)

// Retest signals (optional)
if dktEnable and dktBoxesOn and retest_sig
    int sz2 = array.size(_zoneTop)
    if not na(latestHighIdx)
        int idxU = latestHighIdx
        if sz2 > 0 and idxU >= 0 and idxU < sz2
            float uBot = array.get(_zoneBotY, idxU)
            if high < uBot and high[1] >= uBot
                label.new(bar_index - 1, high[1], "x", color=color.new(color.black, 100), textcolor=lower_col, style=label.style_label_down, size=size.normal)
    if not na(latestLowIdx)
        int idxL = latestLowIdx
        if sz2 > 0 and idxL >= 0 and idxL < sz2
            float lTop = array.get(_zoneTopY, idxL)
            if low > lTop and low[1] <= lTop
                label.new(bar_index - 1, low[1],  "+", color=color.new(color.black, 100), textcolor=upper_col, style=label.style_label_up, size=size.normal)

// Labels
var label dktShortLab = na
var label dktLongLab  = na
if dktEnable
    float aShort = f_anglePct_now(short_dma_dns)
    float aLong  = f_anglePct_now(long_dma_dns)
    string shortName = short_type == "Kalman" ? "kema" : short_type == "EMA" ? "ema" : "ma"
    string longName  = long_type  == "Kalman" ? "kema" : long_type  == "EMA" ? "ema" : "ma"
    string txtShort = f_buildLabel(short_len, short_dma_step, aShort, dktLblNameOn, dktLblPriceOn, dktLblSlopeOn, dktLblSlopeWord, shortName)
    string txtLong  = f_buildLabel(long_len,  long_dma_step,  aLong,  dktLblNameOn, dktLblPriceOn, dktLblSlopeOn, dktLblSlopeWord, longName)
    if barstate.islast
        if not na(dktShortLab)
            label.delete(dktShortLab)
        if not na(dktLongLab)
            label.delete(dktLongLab)
        if dktShortLblOn and not na(short_dma_step) and dktLinesAndFillOn
            dktShortLab := label.new(x=bar_index, y=short_dma_step, text=txtShort, color=color.new(color.black, 100), textcolor=short_line_col, style=label.style_label_left, textalign=text.align_left, yloc=yloc.price, size=f_lblSize(dktLblSizeStr))
        if dktLongLblOn and not na(long_dma_step) and dktLinesAndFillOn
            dktLongLab := label.new(x=bar_index, y=long_dma_step, text=txtLong, color=color.new(color.black, 100), textcolor=trend_col, style=label.style_label_left, textalign=text.align_left, yloc=yloc.price, size=f_lblSize(dktLblSizeStr))
else
    if not na(dktShortLab)
        label.delete(dktShortLab), dktShortLab := na
    if not na(dktLongLab)
        label.delete(dktLongLab),  dktLongLab := na

// Entry arrows / letters
plotarrow(dktEnable and dktEntryArrowsOn ? entryUpTrend : na,  title="DKT Conservative Up Entry Arrow",   colorup=upper_col,  maxheight=30, minheight=30)
plotarrow(dktEnable and dktEntryArrowsOn ? -entryDnTrend : na, title="DKT Conservative Down Entry Arrow", colordown=lower_col, maxheight=30, minheight=30)
float tr = ta.tr

// Price text on entry signals
if dktEnable and dktEntryPriceOn
    string entryPriceTxt = "$" + str.tostring(close, "#.00")
    float entryPad = math.max(tr, syminfo.mintick * 8)
    if entryUpT
        label.new(bar_index, low - entryPad, entryPriceTxt, style=label.style_label_up, yloc=yloc.price,
                  color=color.new(color.black, 100), textcolor=upper_col, size=size.small)
    if entryDnT
        label.new(bar_index, high + entryPad, entryPriceTxt, style=label.style_label_down, yloc=yloc.price,
                  color=color.new(color.black, 100), textcolor=lower_col, size=size.small)

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ALERT: DTZ Flip + New Zone / Level
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
