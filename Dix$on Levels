//@version=6 v1
indicator("Dix$on Levels", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=1200)

groupM  = "------------------------ Master Toggles ------------------------"


//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === DTR DEVIATIONS (Daily anchor) â€” seed Â±3 at open, grow with price ===
//     Auto step = (Multiplier Ã— ATR). Rungs persist once created.
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
groupATRD        = "------------ Dix$on True Range Deviations ------------"

// Master enable
enableATRD       = input.bool( true, "Enable Dix$on True Range Deviations", group=groupM, display=display.none, tooltip="Turn Dix$on True Range (ATR-based) deviation ladders on/off." )

// Lookback
// NOTE: When set to 1, ONLY the current day will be shown (no archived days kept).
atrdLookbackDays = input.int( 1, "DTR Session Lookback", minval=1, maxval=100, group=groupATRD, display=display.none, tooltip="How many days of DTR to keep visible (includes today)." )

// ATR config
atrdLen          = input.int( 14, "DTR Length (Daily)", minval=1, group=groupATRD, display=display.none, tooltip="DTR period used for spacing the DTR ladder." )
atrdBaseTF       = input.timeframe( "D", "DTR Anchor Timeframe", group=groupATRD, display=display.none, tooltip="Timeframe used to compute DTR (intraday uses a predictive daily ATR).")

// Adjustable multiplier (UI as percent: 38.0 = 0.38x)
atrdStepMult     = input.float( 37.5, "DTR Step Multiplier", minval=1.0, step=1.0, group=groupATRD, display=display.none, tooltip="Spacing between rungs = DTR Ã— (this % / 100). Example: 38.0 = 0.38Ã— ATR." )

// Line styling
atrdExtendStr    = input.string( "Both", "Line Extend", options=["None","Left","Right","Both"], group=groupATRD, display=display.none, tooltip="How lines extend beyond their endpoints." )
atrdLineWidth    = input.int( 1, "Line Width", minval=1, maxval=5, group=groupATRD, display=display.none, tooltip="Stroke width for all DTR lines.")
atrdLineStyleStr = input.string( "Dashed", "Line Style", options=["Solid","Dashed","Dotted"], group=groupATRD, display=display.none, tooltip="Stroke style for all DTR lines." )

// Colors & labels
atrdColorZero    = input.color( color.new(color.yellow, 40), "Dev 0 Color", group=groupATRD, display=display.none, tooltip="Color of the DTR centerline (Dev 0)." )
atrdColorUp      = input.color( color.new(color.yellow, 40), "Up Deviation Color", group=groupATRD, display=display.none, tooltip="Color of the positive (+) deviation lines." )
atrdColorDn      = input.color( color.new(color.yellow, 40), "Down Deviation Color", group=groupATRD, display=display.none, tooltip="Color of the negative (âˆ’) deviation lines.")
atrdShowLabels   = input.bool( true, "Show Deviation Labels", group=groupATRD, display=display.none, tooltip="Toggle price labels for Dev 0 and each deviation rung.")
atrdLabelSizeStr = input.string( "Tiny", "Label Size", options=["Tiny","Small","Normal","Large","Huge"], group=groupATRD, display=display.none, tooltip="Font size for DTR labels." )

// Enums
atrdExtend = atrdExtendStr == "Left"  ? extend.left  :
             atrdExtendStr == "Right" ? extend.right :
             atrdExtendStr == "Both"  ? extend.both  : extend.none
atrdStyle  = atrdLineStyleStr == "Solid" ? line.style_solid :
             atrdLineStyleStr == "Dashed"? line.style_dashed : line.style_dotted

// â”€â”€ Helper: choose label style based on extend
f_atrd_lbl_style(_ext) =>
    (_ext == extend.right or _ext == extend.both) ? label.style_none : label.style_label_left

// Day & ATR (lookahead_on so today's ATR is available intraday as a prediction)
isNewDay_ATRD = ta.change(time("D")) != 0
float atrdATR = request.security(syminfo.tickerid, atrdBaseTF, ta.atr(atrdLen), lookahead=barmerge.lookahead_on)

// â”€â”€ DTR step with tick guard (uses adjustable multiplier) + HARD GUARD
float __rawStep = atrdATR * (atrdStepMult * 0.01)   // <-- percent UI (38.0 -> 0.38)
float atrdStep  = math.max(syminfo.mintick, __rawStep)
atrdStep := na(atrdStep) or atrdStep <= 0 ? syminfo.mintick : atrdStep  // <-- guard against na/0

// IDs
atrdDayId = year(time) * 10000 + month(time) * 100 + dayofmonth(time)

// Containers (current day)
var float atrdDayOpen = na
var line  atrdZeroLn  = na
var label atrdZeroLab = na

type _atrd_targ
    line ln
    label lab

var _atrd_targ[] atrdUpTargs = array.new<_atrd_targ>()   // +1, +2, â€¦
var _atrd_targ[] atrdDnTargs = array.new<_atrd_targ>()   // -1, -2, â€¦
var int atrdUpCount = 0
var int atrdDnCount = 0
var int atrdCurDaySid = na

// History (keyed per day so trimming is exact)
var int   __atrdCounter    = 0
var int[] __atrdDayKeys    = array.new_int()     // archived day ids kept (EXCLUDES current day)
var line[] __atrdZeroLines = array.new_line()    // archived Dev0 lines
var int[]  __atrdZeroKeys  = array.new_int()     // day key for each archived Dev0 line
var line[] __atrdUpLines   = array.new_line()
var int[]  __atrdUpKeys    = array.new_int()
var line[] __atrdDnLines   = array.new_line()
var int[]  __atrdDnKeys    = array.new_int()

// Label helper
f_size_atrd(s) => s=="Tiny"?size.tiny:s=="Small"?size.small:s=="Normal"?size.normal:s=="Large"?size.large:size.huge
f_atrd_lbl(_sign, _idx, _price) =>
    _sign == 0 ? "DTR 0 / $" + str.tostring(_price, format.mintick)
               : "DTR " + (_sign > 0 ? "+" : "-") + str.tostring(_idx) + " / $" + str.tostring(_price, format.mintick)

// Seed exactly Â±3 levels each new day
const int ATRD_SEED = 3

// ============= Day change: archive prior day, seed new day =============
if enableATRD and isNewDay_ATRD
    int prevKey = nz(atrdDayId[1], atrdDayId)
    int maxArchivedDays = math.max(0, atrdLookbackDays - 1)

    // Archive zero line + delete prior zero label
    if not na(atrdZeroLn)
        line.set_x2(atrdZeroLn, bar_index - 1)
        if maxArchivedDays > 0
            array.push(__atrdZeroLines, atrdZeroLn), array.push(__atrdZeroKeys, prevKey)
        else
            line.delete(atrdZeroLn)
        atrdZeroLn := na
    if not na(atrdZeroLab)
        label.delete(atrdZeroLab)
        atrdZeroLab := na

    // Archive up deviations
    int _upN = array.size(atrdUpTargs)
    if _upN > 0
        for i = 0 to _upN - 1
            _atrd_targ t = array.get(atrdUpTargs, i)
            if not na(t.ln)
                line.set_x2(t.ln, bar_index - 1)
                if maxArchivedDays > 0
                    array.push(__atrdUpLines, t.ln), array.push(__atrdUpKeys, prevKey)
                else
                    line.delete(t.ln)
            if not na(t.lab)
                label.delete(t.lab)

    // Archive down deviations
    int _dnN = array.size(atrdDnTargs)
    if _dnN > 0
        for i = 0 to _dnN - 1
            _atrd_targ t = array.get(atrdDnTargs, i)
            if not na(t.ln)
                line.set_x2(t.ln, bar_index - 1)
                if maxArchivedDays > 0
                    array.push(__atrdDnLines, t.ln), array.push(__atrdDnKeys, prevKey)
                else
                    line.delete(t.ln)
            if not na(t.lab)
                label.delete(t.lab)

    // Clear live containers
    array.clear(atrdUpTargs)
    array.clear(atrdDnTargs)
    atrdUpCount := 0
    atrdDnCount := 0

    // Queue yesterday only if we actually keep archived days
    if maxArchivedDays > 0
        array.push(__atrdDayKeys, prevKey)

        // Trim history to the most recent maxArchivedDays (hard cap)
        if array.size(__atrdDayKeys) > maxArchivedDays
            int toRemove = array.size(__atrdDayKeys) - maxArchivedDays
            for _ = 1 to toRemove
                int removedKey = array.shift(__atrdDayKeys)

                // delete archived zero lines with that key
                int i0 = 0
                while i0 < array.size(__atrdZeroKeys)
                    if array.get(__atrdZeroKeys, i0) == removedKey
                        line z = array.get(__atrdZeroLines, i0)
                        if not na(z)
                            line.delete(z)
                        array.remove(__atrdZeroLines, i0)
                        array.remove(__atrdZeroKeys,  i0)
                    else
                        i0 += 1

                // delete archived up lines with that key
                int iu = 0
                while iu < array.size(__atrdUpKeys)
                    if array.get(__atrdUpKeys, iu) == removedKey
                        line lnU = array.get(__atrdUpLines, iu)
                        if not na(lnU)
                            line.delete(lnU)
                        array.remove(__atrdUpLines, iu)
                        array.remove(__atrdUpKeys,  iu)
                    else
                        iu += 1

                // delete archived down lines with that key
                int id = 0
                while id < array.size(__atrdDnKeys)
                    if array.get(__atrdDnKeys, id) == removedKey
                        line lnD = array.get(__atrdDnLines, id)
                        if not na(lnD)
                            line.delete(lnD)
                        array.remove(__atrdDnLines, id)
                        array.remove(__atrdDnKeys,  id)
                    else
                        id += 1

    // Start new day from first bar open
    atrdDayOpen  := open
    __atrdCounter += 1
    atrdCurDaySid := __atrdCounter

    // Chosen label style based on current extend
    lblStyleNow = f_atrd_lbl_style(atrdExtend)

    // Dev 0 line + label (create as real segment, then set extend â†’ avoids vertical flash)
    atrdZeroLn := line.new( bar_index - 1, atrdDayOpen, bar_index,     atrdDayOpen, color=atrdColorZero, width=atrdLineWidth, style=atrdStyle, extend=extend.none)
    line.set_extend(atrdZeroLn, atrdExtend)

    if atrdShowLabels
        atrdZeroLab := label.new(bar_index, atrdDayOpen, f_atrd_lbl(0, 0, atrdDayOpen),
                                 style=lblStyleNow, yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                 color=color.new(color.black, 100), textcolor=color.new(color.white, 0))
    else
        atrdZeroLab := na

    // Seed EXACTLY +1..+3 and -1..-3
    for k = 1 to ATRD_SEED
        float yu = atrdDayOpen + atrdStep * k
        float yd = atrdDayOpen - atrdStep * k

        if not na(yu)
            // create horizontal segment first, then set extend (prevents vertical artifact)
            line lnu = line.new( bar_index - 1, yu, bar_index,     yu, color=atrdColorUp, width=atrdLineWidth, style=atrdStyle, extend=extend.none)
            line.set_extend(lnu, atrdExtend)
            label lbu = na
            if atrdShowLabels
                lbu := label.new(bar_index, yu, f_atrd_lbl(+1, k, yu), style=lblStyleNow, yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                 color=color.new(color.black, 100), textcolor=color.new(atrdColorUp, 0))
            array.push(atrdUpTargs, _atrd_targ.new(lnu, lbu))

        if not na(yd)
            line lnd = line.new( bar_index - 1, yd, bar_index,     yd, color=atrdColorDn, width=atrdLineWidth, style=atrdStyle, extend=extend.none)
            line.set_extend(lnd, atrdExtend)
            label lbd = na
            if atrdShowLabels
                lbd := label.new(bar_index, yd, f_atrd_lbl(-1, k, yd), style=lblStyleNow, yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                 color=color.new(color.black, 100), textcolor=color.new(atrdColorDn, 0))
            array.push(atrdDnTargs, _atrd_targ.new(lnd, lbd))

    atrdUpCount := array.size(atrdUpTargs)
    atrdDnCount := array.size(atrdDnTargs)

// ================= Intraday maintenance: Rungs PERSIST once created =================
if enableATRD and not isNewDay_ATRD and not na(atrdDayOpen)
    // Keep endpoints fresh & obey styling
    if not na(atrdZeroLn)
        line.set_x2(atrdZeroLn, bar_index)
        line.set_extend(atrdZeroLn, atrdExtend)
        line.set_style(atrdZeroLn, atrdStyle)
        line.set_width(atrdZeroLn, atrdLineWidth)
        line.set_color(atrdZeroLn, atrdColorZero)

    // Move Dev 0 label to the far/right end (or hide if toggled off)
    if atrdShowLabels
        if not na(atrdZeroLab)
            label.set_x(atrdZeroLab, bar_index)
        else
            // recreate if user toggled labels back on
            atrdZeroLab := label.new(bar_index, atrdDayOpen, f_atrd_lbl(0, 0, atrdDayOpen),
                                     style=f_atrd_lbl_style(atrdExtend), yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                     color=color.new(color.black, 100), textcolor=color.new(color.white, 0))
    else
        if not na(atrdZeroLab)
            label.delete(atrdZeroLab)
            atrdZeroLab := na

    // Maintain all existing up/down lines & labels (NO HIDING ON PULLBACK)
    for i = 0 to array.size(atrdUpTargs) - 1
        _atrd_targ t = array.get(atrdUpTargs, i)
        if not na(t.ln)
            line.set_x2(t.ln, bar_index)
            line.set_style(t.ln, atrdStyle)
            line.set_width(t.ln, atrdLineWidth)
            line.set_color(t.ln, atrdColorUp)
            line.set_extend(t.ln, atrdExtend)
        if atrdShowLabels
            if na(t.lab)
                // recreate missing label if labels were toggled back on
                float y = line.get_price(t.ln, bar_index)
                t.lab := label.new(bar_index, y, f_atrd_lbl(+1, i+1, y), style=f_atrd_lbl_style(atrdExtend),
                                   yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                   color=color.new(color.black, 100), textcolor=color.new(atrdColorUp, 0))
                array.set(atrdUpTargs, i, t)
            else
                label.set_x(t.lab, bar_index)
        else
            if not na(t.lab)
                label.delete(t.lab)
                t.lab := na
                array.set(atrdUpTargs, i, t)

    for i = 0 to array.size(atrdDnTargs) - 1
        _atrd_targ t = array.get(atrdDnTargs, i)
        if not na(t.ln)
            line.set_x2(t.ln, bar_index)
            line.set_style(t.ln, atrdStyle)
            line.set_width(t.ln, atrdLineWidth)
            line.set_color(t.ln, atrdColorDn)
            line.set_extend(t.ln, atrdExtend)
        if atrdShowLabels
            if na(t.lab)
                float y = line.get_price(t.ln, bar_index)
                t.lab := label.new(bar_index, y, f_atrd_lbl(-1, i+1, y), style=f_atrd_lbl_style(atrdExtend),
                                   yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr),
                                   color=color.new(color.black, 100), textcolor=color.new(atrdColorDn, 0))
                array.set(atrdDnTargs, i, t)
            else
                label.set_x(t.lab, bar_index)
        else
            if not na(t.lab)
                label.delete(t.lab)
                t.lab := na
                array.set(atrdDnTargs, i, t)

    // Grow ladders as needed based on current price location (new rungs persist)
    float posUpRaw = (close - atrdDayOpen) / atrdStep
    float posDnRaw = (atrdDayOpen - close) / atrdStep
    int   curUpIdx = math.max(0, int(math.floor(posUpRaw)))  // 0,1,2,â€¦
    int   curDnIdx = math.max(0, int(math.floor(posDnRaw)))  // 0,1,2,â€¦
    int   wantUpTop = math.max(ATRD_SEED, curUpIdx + 3)
    int   wantDnTop = math.max(ATRD_SEED, curDnIdx + 3)

    lblStyleNowIntraday = f_atrd_lbl_style(atrdExtend)

    if wantUpTop > atrdUpCount
        for k = atrdUpCount + 1 to wantUpTop
            float y = atrdDayOpen + atrdStep * k
            if not na(y)
                // create horizontal segment first, then set extend
                line l  = line.new( bar_index - 1, y, bar_index,     y, color=atrdColorUp, width=atrdLineWidth, style=atrdStyle, extend=extend.none)
                line.set_extend(l, atrdExtend)
                label lb = na
                if atrdShowLabels
                    lb := label.new(bar_index, y, f_atrd_lbl(+1, k, y), style=lblStyleNowIntraday, yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr), color=color.new(color.black, 100), textcolor=color.new(atrdColorUp, 0))
                array.push(atrdUpTargs, _atrd_targ.new(l, lb))
        atrdUpCount := array.size(atrdUpTargs)

    if wantDnTop > atrdDnCount
        for k = atrdDnCount + 1 to wantDnTop
            float y = atrdDayOpen - atrdStep * k
            if not na(y)
                // create horizontal segment first, then set extend
                line l  = line.new( bar_index - 1, y, bar_index,     y, color=atrdColorDn, width=atrdLineWidth, style=atrdStyle, extend=extend.none)
                line.set_extend(l, atrdExtend)
                label lb = na
                if atrdShowLabels
                    lb := label.new(bar_index, y, f_atrd_lbl(-1, k, y), style=lblStyleNowIntraday, yloc=yloc.price, size=f_size_atrd(atrdLabelSizeStr), color=color.new(color.black, 100), textcolor=color.new(atrdColorDn, 0))
                array.push(atrdDnTargs, _atrd_targ.new(l, lb))
        atrdDnCount := array.size(atrdDnTargs)

// â”€â”€ Centerlines (Dev-0) for lookback: show exactly atrdLookbackDays total (current + last N-1 archived)
if enableATRD
    int haveZ = array.size(__atrdZeroLines)
    int needArchived = math.max(0, atrdLookbackDays - 1)
    if haveZ > 0
        int startIdx = math.max(0, haveZ - needArchived)
        for i = 0 to haveZ - 1
            line z = array.get(__atrdZeroLines, i)
            if not na(z)
                bool within = i >= startIdx
                // Keep their per-day span; just restyle and fade extras if any
                line.set_extend(z, atrdExtend)
                line.set_style(z, atrdStyle)
                line.set_width(z, atrdLineWidth)
                line.set_color(z, within ? atrdColorZero : color.new(atrdColorZero, 100))

// Disable â†’ clean live (history thatâ€™s already archived remains)
if not enableATRD
    if not na(atrdZeroLn)
        line.delete(atrdZeroLn)
        atrdZeroLn := na
    if not na(atrdZeroLab)
        label.delete(atrdZeroLab)
        atrdZeroLab := na

    if array.size(atrdUpTargs) > 0
        for t in atrdUpTargs
            if not na(t.ln)
                line.delete(t.ln)
            if not na(t.lab)
                label.delete(t.lab)
        array.clear(atrdUpTargs)

    if array.size(atrdDnTargs) > 0
        for t in atrdDnTargs
            if not na(t.ln)
                line.delete(t.ln)
            if not na(t.lab)
                label.delete(t.lab)
        array.clear(atrdDnTargs)

    atrdUpCount := 0
    atrdDnCount := 0






//@version=6
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === DIX$ON OPENING RANGE (DORD) â€” unified inputs (with ATR scope fix) ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
groupDORD  = "------------ Dix$on Opening Range Deviations ------------"
enableDORD = input.bool(true, "Enable Dix$on Opening Range Deviations", group=groupM, tooltip="Master on/off for the Dix$on Opening Range Deviations feature set.", display=display.none)

// DORD session/timeframe & lookback (same group)
dord_tf             = input.timeframe("15", "Opening Range Session Timeframe", group=groupDORD, tooltip="Timeframe used to define DORD sessions", display=display.none)
dordSessionLookback = input.int(1, "Opening Range Session Lookback", minval=1, maxval=100, group=groupDORD, tooltip="How many previous DORD sessions to keep objects for", display=display.none)

// â”€â”€ Auto/Manual deviation % control
dordUseManualPer    = input.bool(false, "Use Manual Deviation % Override", group=groupDORD, display=display.none, tooltip="ON = use your custom % below. OFF = auto-pick: 37.5% for WIDE ORs, 75% for TIGHT ORs.")
dordPerInp          = input.float(37.5, "Deviation % of Opening Range Width", minval=1, step=1, group=groupDORD, tooltip="Manual % distance for each deviation step (used only when override is ON).", display=display.none)
dordDispType        = input.string("Adaptive", "Deviation Display", options=["Adaptive","Extended"], group=groupDORD, tooltip="Adaptive shows ~2 nearest deviations around price; Extended shows all to current bar", display=display.none)

// DORD line extend (same group)
dordExtendHLStr     = input.string("None", "Opening Range Line Extension Mode", options=["None","Left","Right","Both"], group=groupDORD, display=display.none)

// Deviation + Midline style/width (unchanged)
dordLineWidth       = input.int(1, "Deviation/Mid Line Width", minval=1, maxval=5, group=groupDORD, display=display.none)
dordLineStyleStr    = input.string("Dashed", "Deviation Line Style", options=["Solid","Dashed","Dotted"], group=groupDORD, display=display.none)

// Shared OR High/Low style/width (one set for both)
dordHLLineWidth     = input.int(2, "OR High/Low Line Width", minval=1, maxval=5, group=groupDORD, display=display.none)
dordHLLineStyleStr  = input.string("Solid", "OR High/Low Line Style", options=["Solid","Dashed","Dotted"], group=groupDORD, display=display.none)

// Colors (separate per element)
dordHighColor       = input.color(color.new(#089981, 40), "Opening Range High Color", group=groupDORD, display=display.none)
dordLowColor        = input.color(color.new(#f23645, 40), "Opening Range Low Color",  group=groupDORD, display=display.none)
dordMidColor        = input.color(color.new(color.gray, 40), "Opening Range Midline Color", group=groupDORD, display=display.none)
dordColorUp         = input.color(color.new(color.gray, 40), "Bull OR Deviation Color", group=groupDORD, display=display.none)
dordColorDn         = input.color(color.new(color.gray, 40), "Bear OR Deviation Color", group=groupDORD, display=display.none)

// Labels & deviations (same group)
dordShowHLLabels    = input.bool(true, "Show Opening Range Hi/Low Labels", group=groupDORD, display=display.none)
dordHLLabelColor    = input.color(color.white, "OR Hi/Low Label Text Color", group=groupDORD, display=display.none)
dordShowDevLabels   = input.bool(true, "Show OR Dev Labels", group=groupDORD, display=display.none)

dordLabelSize       = input.string("Tiny", "Label Size (HL/Dev/Mid)", options=["Tiny","Small","Normal","Large","Huge"], group=groupDORD, display=display.none)
// Toggle for centerline label (forced OFF when deviations are hidden)
dordShowMidLabel    = input.bool(true, "Show OR Mid Label", group=groupDORD, display=display.none)

// Toggle to show/hide DORD deviations; hides the midline too (keeps only OR High/Low)
dordShowDevLines    = input.bool(true, "Show OR Deviation Lines", group=groupDORD, display=display.none, tooltip="Turn OFF to hide DORD deviation lines/labels and the OR midline/label, leaving only the OR High & Low.")

// DORD Pre-OR (forming) Hi/Low dotted trackers
preORHiLoTog = input.bool(true, "Enable Pre-OR Hi/Low Dotted Lines", group=groupDORD, tooltip="Track the evolving OR High/Low from session open until the OR confirms.", display=display.none)
preORHiColor = input.color(color.new(color.lime, 0), "Pre-OR High Color", group=groupDORD, display=display.none)
preORLoColor = input.color(color.new(color.red, 0),  "Pre-OR Low Color",  group=groupDORD, display=display.none)
preORWidth   = input.int(1, "Pre-OR Hi/Low Width", minval=1, maxval=5, group=groupDORD, display=display.none)
preORStyleStr= input.string("Dotted", "Pre-OR Hi/Low Style", options=["Solid","Dashed","Dotted"], group=groupDORD, display=display.none)

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === ENUM PARSING ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
preORStyle        = preORStyleStr    == "Solid" ? line.style_solid : preORStyleStr    == "Dashed" ? line.style_dashed : line.style_dotted
dordLineStyle     = dordLineStyleStr == "Solid" ? line.style_solid : dordLineStyleStr == "Dashed" ? line.style_dashed : line.style_dotted
dordExtend        = dordExtendHLStr  == "Left"  ? extend.left       : dordExtendHLStr == "Right"  ? extend.right      : dordExtendHLStr== "Both" ? extend.both : extend.none
// OR HL style map
dordHLLineStyle   = dordHLLineStyleStr == "Solid" ? line.style_solid : dordHLLineStyleStr == "Dashed" ? line.style_dashed : line.style_dotted

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === HELPERS ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
f_size(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

// Label text
f_lblText(_tf, _type, _price)        => _tf + " OR "   + _type + " / $" + str.tostring(_price, format.mintick)
f_dordLblText(_tf, _type, _price)    => _tf + " DORD " + _type + " / $" + str.tostring(_price, format.mintick)
f_dordDevLblText(_sign, _idx, _price)=> " DORD Dev "   + _sign + str.tostring(_idx) + " / $" + str.tostring(_price, format.mintick)

// Label style chooser: Both/Right â†’ upper_left; None/Left â†’ left
f_dord_lbl_style(_ext) =>
    (_ext == extend.right or _ext == extend.both) ? label.style_none : label.style_label_left

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === PRECOMPUTE ATR(14) ON OR TF EACH BAR (scope-consistent) ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
float atrOR = request.security(syminfo.tickerid, dord_tf, ta.atr(14))

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  
// === DORD SESSIONS, HL/Mid + DORD DEVIATIONS ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
var bool dord_sesh  = false
new_tf = timeframe.change(dord_tf)
if enableDORD
    if session.isfirstbar
        dord_sesh := true
    else if not session.isfirstbar and new_tf
        dord_sesh := false
else
    dord_sesh := false

dord_start = dord_sesh and not dord_sesh[1]
dord_end   = dord_sesh[1] and not dord_sesh

// Forming trackers
var float dordFormHi = na
var float dordFormLo = na
var line  dordFormHiLn = na
var line  dordFormLoLn = na
preDordWidth = preORWidth
preDordStyle = preORStyle
preDordHiCol = preORHiColor
preDordLoCol = preORLoColor

// Finalized values & handles
var float dordH = na
var float dordL = na
var float dordW = na
var float dordM = na
var line  dH    = na
var line  dL    = na
var line  dM    = na
var label dordHiLab  = na
var label dordLoLab  = na
var label dordMidLab = na

// Targets
type _targ
    line ln
    label lab
var _targ[] dordUpTargs = array.new<_targ>()
var _targ[] dordDnTargs = array.new<_targ>()
var int   up_count = 0
var int   dn_count = 0
var float hst = na
var float lst = na

// Per-session % (fraction) chosen at OR finalize
var float dordPerSession = na   // e.g., 0.375 (37.5%) or 0.75 (75%)

// Step sources
float h_src = close
float l_src = close

// Lookback containers
var int   __dordCounter  = 0
var int[] __sessIds      = array.new_int()
var line[] __sessHigh    = array.new_line()
var line[] __sessLow     = array.new_line()
var line[] __sessMid     = array.new_line()

var line[]  __histUpLines   = array.new_line()
var label[] __histUpLabels  = array.new_label()
var int[]   __histUpSessId  = array.new_int()

var line[]  __histDnLines   = array.new_line()
var label[] __histDnLabels  = array.new_label()
var int[]   __histDnSessId  = array.new_int()

// START of DORD window
if enableDORD and dord_start
    if __dordCounter > 0
        // Archive UP targets
        int _uN = array.size(dordUpTargs)
        if _uN > 0
            for i = 0 to _uN - 1
                _targ t = array.get(dordUpTargs, i)
                if not na(t.ln)
                    line.set_x2(t.ln, bar_index - 1)
                    array.push(__histUpLines, t.ln)
                    array.push(__histUpLabels, na)
                    array.push(__histUpSessId, __dordCounter)
                if not na(t.lab)
                    label.delete(t.lab)
        // Archive DOWN targets
        int _dN = array.size(dordDnTargs)
        if _dN > 0
            for i = 0 to _dN - 1
                _targ t = array.get(dordDnTargs, i)
                if not na(t.ln)
                    line.set_x2(t.ln, bar_index - 1)
                    array.push(__histDnLines, t.ln)
                    array.push(__histDnLabels, na)
                    array.push(__histDnSessId, __dordCounter)
                if not na(t.lab)
                    label.delete(t.lab)

        // Clear current containers
        array.clear(dordUpTargs)
        array.clear(dordDnTargs)
        up_count := 0
        dn_count := 0

        // Trim deviation history
        int __keepFromDev = __dordCounter - dordSessionLookback + 2
        int __k = 0
        while __k < array.size(__histUpSessId)
            int sid = array.get(__histUpSessId, __k)
            if sid < __keepFromDev
                line ln = array.get(__histUpLines, __k)
                label lb = array.get(__histUpLabels, __k)
                if not na(ln)
                    line.delete(ln)
                if not na(lb)
                    label.delete(lb)
                array.remove(__histUpLines, __k)
                array.remove(__histUpLabels, __k)
                array.remove(__histUpSessId, __k)
            else
                __k += 1
        __k := 0
        while __k < array.size(__histDnSessId)
            int sid = array.get(__histDnSessId, __k)
            if sid < __keepFromDev
                line ln = array.get(__histDnLines, __k)
                label lb = array.get(__histDnLabels, __k)
                if not na(ln)
                    line.delete(ln)
                if not na(lb)
                    label.delete(lb)
                array.remove(__histDnLines, __k)
                array.remove(__histDnLabels, __k)
                array.remove(__histDnSessId, __k)
            else
                __k += 1

    // initialize forming range
    dordFormHi := high
    dordFormLo := low

    // reset per-session % until finalized
    dordPerSession := na

    // remove leftover dotted lines
    if not na(dordFormHiLn)
        line.delete(dordFormHiLn)
        dordFormHiLn := na
    if not na(dordFormLoLn)
        line.delete(dordFormLoLn)
        dordFormLoLn := na

    // clear labels
    label.delete(dordHiLab), label.delete(dordLoLab), label.delete(dordMidLab)
    dordHiLab := na
    dordLoLab := na
    dordMidLab := na

// LIVE (forming) window
if enableDORD and dord_sesh
    float _prevHi = na(dordFormHi) ? high : dordFormHi
    float _prevLo = na(dordFormLo) ? low  : dordFormLo

    dordFormHi := math.max(na(dordFormHi) ? high : dordFormHi, high)
    dordFormLo := math.min(na(dordFormLo) ? low  : dordFormLo,  low)

    if na(dordFormHiLn) and preORHiLoTog
        dordFormHiLn := line.new(bar_index - 1, _prevHi, bar_index, dordFormHi, width=preDordWidth, style=preDordStyle, color=preDordHiCol, extend=extend.none)
    else if not na(dordFormHiLn)
        line.set_xy1(dordFormHiLn, bar_index - 1, _prevHi)
        line.set_xy2(dordFormHiLn, bar_index,     dordFormHi)
        line.set_style(dordFormHiLn, preDordStyle)
        line.set_width(dordFormHiLn, preDordWidth)
        line.set_color(dordFormHiLn, preDordHiCol)
        line.set_extend(dordFormHiLn, extend.none)

    if na(dordFormLoLn) and preORHiLoTog
        dordFormLoLn := line.new(bar_index - 1, _prevLo, bar_index, dordFormLo, width=preDordWidth, style=preDordStyle, color=preDordLoCol, extend=extend.none)
    else if not na(dordFormLoLn)
        line.set_xy1(dordFormLoLn, bar_index - 1, _prevLo)
        line.set_xy2(dordFormLoLn, bar_index,     dordFormLo)
        line.set_style(dordFormLoLn, preDordStyle)
        line.set_width(dordFormLoLn, preDordWidth)
        line.set_color(dordFormLoLn, preDordLoCol)
        line.set_extend(dordFormLoLn, extend.none)

// END of window â†’ freeze H/L/Mid, seed targets and choose % (auto or manual)
if enableDORD and dord_end
    if not na(dordFormHiLn)
        line.delete(dordFormHiLn)
        dordFormHiLn := na
    if not na(dordFormLoLn)
        line.delete(dordFormLoLn)
        dordFormLoLn := na

    dordH := dordFormHi
    dordL := dordFormLo
    dordW := math.abs(dordH - dordL)
    dordM := math.avg(dordH, dordL)

    // AUTO wide/tight via ATR(14) on OR timeframe (uses precomputed atrOR)
    float _autoPer = na(atrOR) ? 37.5 : (dordW >= atrOR ? 37.5 : 75.0)
    dordPerSession := (dordUseManualPer ? dordPerInp : _autoPer) * 0.01

    // â”€â”€ FIX: seed HL/Mid with a 1-bar span to avoid vertical tick on first bar
    dH := line.new(bar_index - 1, dordH, bar_index, dordH, color=dordHighColor, width=dordHLLineWidth, style=dordHLLineStyle, extend=dordExtend)
    dL := line.new(bar_index - 1, dordL, bar_index, dordL, color=dordLowColor,  width=dordHLLineWidth, style=dordHLLineStyle, extend=dordExtend)
    dM := line.new(bar_index - 1, dordM, bar_index, dordM, color=dordMidColor,  width=dordLineWidth,     style=line.style_dashed,  extend=dordExtend)

    __dordCounter += 1
    array.push(__sessIds, __dordCounter)
    array.push(__sessHigh, dH)
    array.push(__sessLow,  dL)
    array.push(__sessMid,  dM)

    int __keepFrom = __dordCounter - dordSessionLookback + 1
    int __i = 0
    while __i < array.size(__sessIds)
        int sid = array.get(__sessIds, __i)
        if sid < __keepFrom
            line lh = array.get(__sessHigh, __i)
            line ll = array.get(__sessLow,  __i)
            line lm = array.get(__sessMid,  __i)
            if not na(lh)
                line.delete(lh)
            if not na(ll)
                line.delete(ll)
            if not na(lm)
                line.delete(lm)
            array.remove(__sessIds, __i)
            array.remove(__sessHigh, __i)
            array.remove(__sessLow,  __i)
            array.remove(__sessMid,  __i)
        else
            __i += 1

    // labels (ALL use dordLabelSize)
    label.delete(dordHiLab), label.delete(dordLoLab), label.delete(dordMidLab)
    string _tfTxt = str.tostring(dord_tf)
    lblStyleNow = f_dord_lbl_style(dordExtend)

    if dordShowHLLabels
        dordHiLab := label.new(bar_index, dordH, text = _tfTxt + " OR High / $" + str.tostring(dordH, format.mintick), style=lblStyleNow, yloc=yloc.price, size=f_size(dordLabelSize), color=color.new(color.black, 100), textcolor=dordHLLabelColor)
        dordLoLab := label.new(bar_index, dordL, text = _tfTxt + " OR Low / $" + str.tostring(dordL, format.mintick),  style=lblStyleNow, yloc=yloc.price, size=f_size(dordLabelSize), color=color.new(color.black, 100), textcolor=dordHLLabelColor)
    else
        dordHiLab := na
        dordLoLab := na

    if dordShowMidLabel and dordShowDevLines  // force hidden when deviations hidden
        dordMidLab := label.new(bar_index, dordM, text = "OR 0 / $" + str.tostring(dordM, format.mintick), style=lblStyleNow, yloc=yloc.price, size=f_size(dordLabelSize), color=color.new(color.black, 100), textcolor=dordMidColor)
    else
        dordMidLab := na

    float _per = na(dordPerSession) ? (dordUseManualPer ? dordPerInp * 0.01 : 0.375) : dordPerSession
    hst := dordH + dordW * _per
    lst := dordL - dordW * _per
    up_count := 0
    dn_count := 0

// Outside the window â†’ extend & manage targets
if enableDORD and not dord_sesh and not na(dordH) and not na(dordL)
    if not na(dH)
        line.set_x2(dH, bar_index)
        line.set_extend(dH, dordExtend)
    if not na(dL)
        line.set_x2(dL, bar_index)
        line.set_extend(dL, dordExtend)
    if not na(dM)
        line.set_x2(dM, bar_index)
        line.set_extend(dM, dordExtend)

    if dordShowHLLabels
        if not na(dordHiLab)
            label.set_x(dordHiLab, bar_index)
        if not na(dordLoLab)
            label.set_x(dordLoLab, bar_index)
    else
        if not na(dordHiLab)
            label.delete(dordHiLab)
            dordHiLab := na
        if not na(dordLoLab)
            label.delete(dordLoLab)
            dordLoLab := na

    // Mid label only if both toggles allow it
    if dordShowMidLabel and dordShowDevLines
        if not na(dordMidLab)
            label.set_x(dordMidLab, bar_index)
    else
        if not na(dordMidLab)
            label.delete(dordMidLab)
            dordMidLab := na

    // If deviations are hidden, also hide the midline visually
    if not dordShowDevLines and not na(dM)
        line.set_color(dM, color.new(dordMidColor, 100))
    else if dordShowDevLines and not na(dM)
        line.set_color(dM, dordMidColor)

    float _per = na(dordPerSession) ? (dordUseManualPer ? dordPerInp * 0.01 : 0.375) : dordPerSession

    if h_src > hst
        hst := h_src
    if l_src < lst
        lst := l_src

    up_max = int(math.ceil((hst - dordH) / (dordW * _per)))
    dn_max = int(math.ceil((dordL - lst) / (dordW * _per)))
    up_max := math.max(0, up_max)
    dn_max := math.max(0, dn_max)

    // â”€â”€â”€â”€â”€ Add NEW targets only if we are showing dev lines â”€â”€â”€â”€â”€
    lblStyleNowIntraday = f_dord_lbl_style(dordExtend)
    if dordShowDevLines
        if up_count < up_max
            for i = (up_count + 1) to up_max
                float y = dordH + dordW * _per * i
                line ln = line.new(bar_index - 1, y, bar_index, y, color=dordColorUp, width=dordLineWidth, style=dordLineStyle, extend=dordExtend)
                string txt = dordShowDevLabels ? ("OR +" + str.tostring(i) + " / $" + str.tostring(y, format.mintick)) : ""
                label lb  = label.new(bar_index, y, txt, style=lblStyleNowIntraday,
                                      textcolor=dordShowDevLabels ? color.new(dordColorUp, 0) : color.new(color.black, 100),
                                      color=color.new(color.black, 100), size=f_size(dordLabelSize))
                array.push(dordUpTargs, _targ.new(ln, lb))
        up_count := up_max

        if dn_count < dn_max
            for i = (dn_count + 1) to dn_max
                float y = dordL - dordW * _per * i
                line ln = line.new(bar_index - 1, y, bar_index, y, color=dordColorDn, width=dordLineWidth, style=dordLineStyle, extend=dordExtend)
                string txt = dordShowDevLabels ? ("OR -" + str.tostring(i) + " / $" + str.tostring(y, format.mintick)) : ""
                label lb  = label.new(bar_index, y, txt, style=lblStyleNowIntraday,
                                      textcolor=dordShowDevLabels ? color.new(dordColorDn, 0) : color.new(color.black, 100),
                                      color=color.new(color.black, 100), size=f_size(dordLabelSize))
                array.push(dordDnTargs, _targ.new(ln, lb))
        dn_count := dn_max

    // â”€â”€â”€â”€â”€ Display mode for CURRENT targets â€” guarded by sizes â”€â”€â”€â”€â”€
    if dordShowDevLines
        if dordDispType == "Extended"
            int _nu = array.size(dordUpTargs)
            if _nu > 0
                for i = 0 to _nu - 1
                    _targ t = array.get(dordUpTargs, i)
                    if not na(t.ln)
                        line.set_x2(t.ln, bar_index)
                        line.set_extend(t.ln, dordExtend)
                    if not na(t.lab)
                        label.set_x(t.lab, bar_index)

            int _nd = array.size(dordDnTargs)
            if _nd > 0
                for i = 0 to _nd - 1
                    _targ t = array.get(dordDnTargs, i)
                    if not na(t.ln)
                        line.set_x2(t.ln, bar_index)
                        line.set_extend(t.ln, dordExtend)
                    if not na(t.lab)
                        label.set_x(t.lab, bar_index)
        else
            // Adaptive
            up_cur = int(math.max(0, math.ceil((close - dordH) / (dordW * _per))))
            dn_cur = int(math.max(0, math.ceil((dordL - close) / (dordW * _per))))

            int _nu = array.size(dordUpTargs)
            if _nu > 0
                for i = 0 to _nu - 1
                    _targ t = array.get(dordUpTargs, i)
                    bool show = (i + 1) <= up_cur and (i + 1) >= math.max(1, up_cur - 1)
                    if not na(t.ln)
                        line.set_x2(t.ln, show ? bar_index + 1 : bar_index)
                        line.set_extend(t.ln, dordExtend)
                    if not na(t.lab)
                        label.set_x(t.lab, show ? bar_index + 1 : bar_index)

            int _nd = array.size(dordDnTargs)
            if _nd > 0
                for i = 0 to _nd - 1
                    _targ t = array.get(dordDnTargs, i)
                    bool show = (i + 1) <= dn_cur and (i + 1) >= math.max(1, dn_cur - 1)
                    if not na(t.ln)
                        line.set_x2(t.ln, show ? bar_index + 1 : bar_index)
                        line.set_extend(t.ln, dordExtend)
                    if not na(t.lab)
                        label.set_x(t.lab, show ? bar_index + 1 : bar_index)
    else
        // Deviation lines toggle OFF â†’ fade any existing current session targets (no new ones added)
        int _nu = array.size(dordUpTargs)
        if _nu > 0
            for i = 0 to _nu - 1
                _targ t = array.get(dordUpTargs, i)
                if not na(t.ln)
                    line.set_color(t.ln, color.new(dordColorUp, 100))
                if not na(t.lab)
                    label.set_textcolor(t.lab, color.new(dordColorUp, 100))
        int _nd = array.size(dordDnTargs)
        if _nd > 0
            for i = 0 to _nd - 1
                _targ t = array.get(dordDnTargs, i)
                if not na(t.ln)
                    line.set_color(t.ln, color.new(dordColorDn, 100))
                if not na(t.lab)
                    label.set_textcolor(t.lab, color.new(dordColorDn, 100))

// Apply extend to all kept lines
if enableDORD
    int __nSess = math.min( math.min(array.size(__sessIds), array.size(__sessHigh)), math.min(array.size(__sessLow),  array.size(__sessMid)))
    if __nSess > 0
        for j = 0 to __nSess - 1
            line lh = array.get(__sessHigh, j)
            line ll = array.get(__sessLow,  j)
            line lm = array.get(__sessMid,  j)
            if not na(lh)
                line.set_extend(lh, dordExtend)
            if not na(ll)
                line.set_extend(ll, dordExtend)
            if not na(lm)
                line.set_extend(lm, dordExtend)

    if not na(dH)
        line.set_extend(dH, dordExtend)
    if not na(dL)
        line.set_extend(dL, dordExtend)
    if not na(dM)
        line.set_extend(dM, dordExtend)

    // Deviation lines (history) â€” extension only
    int __nUpHist = array.size(__histUpLines)
    if __nUpHist > 0
        for i = 0 to __nUpHist - 1
            line ln = array.get(__histUpLines, i)
            if not na(ln)
                line.set_extend(ln, dordExtend)
    int __nDnHist = array.size(__histDnLines)
    if __nDnHist > 0
        for i = 0 to __nDnHist - 1
            line ln = array.get(__histDnLines, i)
            if not na(ln)
                line.set_extend(ln, dordExtend)

    // Deviation lines (current) â€” respect visibility toggle
    if dordShowDevLines
        int __nUpCur = array.size(dordUpTargs)
        if __nUpCur > 0
            for i = 0 to __nUpCur - 1
                _targ t = array.get(dordUpTargs, i)
                if not na(t.ln)
                    line.set_extend(t.ln, dordExtend)
        int __nDnCur = array.size(dordDnTargs)
        if __nDnCur > 0
            for i = 0 to __nDnCur - 1
                _targ t = array.get(dordDnTargs, i)
                if not na(t.ln)
                    line.set_extend(t.ln, dordExtend)



//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// LOOKBACK HIGH/LOW 
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// === LOOKBACK HIGH/LOW SETTINGS ===
groupLookback = "------------ Lookback High/Low Settings ------------"
enableLookbackHL    = input.bool(true, "Enable Lookback High/Low", group=groupM, tooltip="Toggle to show high/low levels from past higher timeframe candles", display=display.none)
lookbackTF          = input.timeframe("D", "Lookback Timeframe", group=groupLookback, tooltip="Timeframe from which highs/lows are retrieved", display=display.none)
lookbackBars        = input.int(2, "Lookback Candles", minval=1, maxval=500, group=groupLookback, tooltip="How many HTF candles back to show lines for", display=display.none)
lbExtendStr         = input.string("Both", "Line Extend", options=["None", "Left", "Right", "Both"], group=groupLookback, tooltip="Extension style for lookback lines", display=display.none)
lookbackLineWidth   = input.int(1, "Line Width", minval=1, maxval=5, group=groupLookback, display=display.none)
lookbackLineStyle   = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"], group=groupLookback, display=display.none)
lookbackLineColorHi = input.color(color.new(#00ff08, 0), "High Color", group=groupLookback, display=display.none)
lookbackLineColorLo = input.color(color.new(#ff0000, 0), "Low Color",  group=groupLookback, display=display.none)

// NEW: label controls (match DTR/DORD behavior)
lookbackShowLabels  = input.bool(true, "Show Labels", group=groupLookback, display=display.none, tooltip="Show/Hide lookback High/Low labels pinned to the right edge.")
lookbackLabelSize   = input.string("Tiny", "Label Size", options=["Tiny","Small","Normal","Large","Huge"], group=groupLookback, display=display.none, tooltip="Font size for lookback High/Low labels.")

//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// === ENUM PARSING ===
//â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
lbStyle  = lookbackLineStyle == "Solid" ? line.style_solid : lookbackLineStyle == "Dashed" ? line.style_dashed : line.style_dotted
lbExtend = lbExtendStr == "Left" ? extend.left : lbExtendStr == "Right" ? extend.right : lbExtendStr == "Both" ? extend.both : extend.none

// Match DTR/DORD label behavior by extend setting
lbLabelStyle = (lbExtendStr == "Right" or lbExtendStr == "Both") ? label.style_none : label.style_label_left

// Size helper
f_lb_size(s) =>
    s=="Tiny"?size.tiny:s=="Small"?size.small:s=="Normal"?size.normal:s=="Large"?size.large:s=="Huge"?size.huge:size.small

// Arrays
var float[] lbHighs   = array.new_float()
var float[] lbLows    = array.new_float()
var int[]   lbTimes   = array.new_int()
var line[]  lbHiLines = array.new_line()
var line[]  lbLoLines = array.new_line()
var label[] lbHiLabs  = array.new_label()
var label[] lbLoLabs  = array.new_label()

// HTF streams
lookbackHighNow = request.security(syminfo.tickerid, lookbackTF, high, lookahead=barmerge.lookahead_on)
lookbackLowNow  = request.security(syminfo.tickerid, lookbackTF, low,  lookahead=barmerge.lookahead_on)
lookbackTimeNow = request.security(syminfo.tickerid, lookbackTF, time, lookahead=barmerge.lookahead_on)
isNewHTFBar     = ta.change(lookbackTimeNow) != 0

// Collect rolling HTF values
if enableLookbackHL and isNewHTFBar
    if array.size(lbTimes) == 0 or lookbackTimeNow != array.get(lbTimes, 0)
        array.unshift(lbHighs, lookbackHighNow)
        array.unshift(lbLows,  lookbackLowNow)
        array.unshift(lbTimes, lookbackTimeNow)
        if array.size(lbHighs) > lookbackBars
            array.pop(lbHighs)
            array.pop(lbLows)
            array.pop(lbTimes)

if enableLookbackHL and array.size(lbTimes) > 0
    array.set(lbHighs, 0, lookbackHighNow)
    array.set(lbLows,  0, lookbackLowNow)

// Helper: build label text per index + price (timeframe-aware)
// â€¢ Daily: leave as-is (no TF tag)
// â€¢ 1â€“4H: format as hours ("1H", "4H")
// â€¢ Intraday minutes: "5m", "15m", etc.
// â€¢ "Prev"/"Last" always in front of the timeframe text.
// â€¢ Weekly/monthly "Wk of" rows drop the raw TF ("1W", "1M") to avoid redundancy.
f_lb_text(idx, isHigh, price) =>
    tf        = lookbackTF
    tfUpper   = str.upper(tf)
    isDaily   = str.contains(tfUpper, "D")
    isWeekly  = str.contains(tfUpper, "W")
    isMonthly = str.contains(tfUpper, "M")
    isNumeric = not na(str.tonumber(tf))  // intraday like "5", "15", "60", "240", etc.

    // Human-readable timeframe (5m, 1Hâ€“4H, monthly "Mo", fallback = raw tf)
    string tfPretty = tf
    if isNumeric
        float nRaw = str.tonumber(tf)
        if not na(nRaw)
            int nMins = int(nRaw)
            if nMins >= 60 and nMins <= 240 and nMins % 60 == 0
                // 60, 120, 180, 240 -> 1Hâ€“4H
                int h = nMins / 60
                tfPretty := str.tostring(h) + "H"
            else
                // All other numeric intraday -> minutes
                tfPretty := str.tostring(nMins) + "m"
    else
        // Non-numeric: adjust monthly to use "Mo" instead of bare "M"
        if isMonthly
            tfPretty := str.replace(tfPretty, "M", "Mo")

    string base = ""

    if isDaily
        // Daily: NO timeframe tag at all (keep original behavior)
        if idx == 0
            base := isHigh ? "High" : "Low"
        else if idx == 1
            base := isHigh ? "Prev High" : "Prev Low"
        else
            t = array.get(lbTimes, idx)
            base := str.tostring(month(t)) + "/" + str.tostring(dayofmonth(t)) + (isHigh ? " High" : " Low")
    else
        // Non-daily: include timeframe where it isn't redundant
        if idx == 0
            // Current bar: "<TF> High/Low"
            base := tfPretty + " " + (isHigh ? "High" : "Low")
        else if idx == 1
            // Previous bar: "Prev <TF> High/Low" or "Last <TF> High/Low" for W/M
            if isWeekly or isMonthly
                base := "Last " + tfPretty + " " + (isHigh ? "High" : "Low")
            else
                base := "Prev " + tfPretty + " " + (isHigh ? "High" : "Low")
        else
            if isWeekly or isMonthly
                // Older weekly/monthly: "Wk of MM/DD High/Low" (no "1W"/"1M" prefix)
                t = array.get(lbTimes, idx)
                base := "Wk of " + str.tostring(month(t)) + "/" + str.tostring(dayofmonth(t)) + (isHigh ? " High" : " Low")
            else
                // Older intraday: "<TF> High/Low -N"
                base := tfPretty + " " + (isHigh ? "High" : "Low") + " -" + str.tostring(idx)

    priceStr = "$" + str.tostring(price, format.mintick)
    base + " / " + priceStr

if enableLookbackHL and array.size(lbHighs) > 0 and array.size(lbLows) > 0
    int need = array.size(lbHighs)

    // Grow lines (always)
    while array.size(lbHiLines) < need
        int idx = array.size(lbHiLines)
        float hiV = array.get(lbHighs, idx)
        float loV = array.get(lbLows,  idx)
        line hLn = line.new(bar_index, hiV, bar_index - 500, hiV, color=lookbackLineColorHi, width=lookbackLineWidth, style=lbStyle, extend=lbExtend)
        line lLn = line.new(bar_index, loV, bar_index - 500, loV, color=lookbackLineColorLo, width=lookbackLineWidth, style=lbStyle, extend=lbExtend)
        array.push(lbHiLines, hLn)
        array.push(lbLoLines, lLn)

        // Create labels only if toggle is on
        if lookbackShowLabels
            string hiTxt = f_lb_text(idx, true, hiV)
            string loTxt = f_lb_text(idx, false, loV)
            label hiLb = label.new(timenow, hiV, hiTxt, xloc=xloc.bar_time, style=lbLabelStyle, yloc=yloc.price, size=f_lb_size(lookbackLabelSize), color=color.new(color.black, 100), textcolor=lookbackLineColorHi)
            label loLb = label.new(timenow, loV, loTxt, xloc=xloc.bar_time, style=lbLabelStyle, yloc=yloc.price, size=f_lb_size(lookbackLabelSize), color=color.new(color.black, 100), textcolor=lookbackLineColorLo)
            array.push(lbHiLabs, hiLb)
            array.push(lbLoLabs, loLb)

    // Trim extras (lines + labels)
    while array.size(lbHiLines) > need
        line.delete(array.pop(lbHiLines))
        line.delete(array.pop(lbLoLines))
        if array.size(lbHiLabs) > 0
            label.delete(array.pop(lbHiLabs))
        if array.size(lbLoLabs) > 0
            label.delete(array.pop(lbLoLabs))

    // If labels are toggled OFF, delete any existing labels and clear arrays
    if not lookbackShowLabels
        if array.size(lbHiLabs) > 0
            for lbDel in lbHiLabs
                if not na(lbDel)
                    label.delete(lbDel)
            array.clear(lbHiLabs)
        if array.size(lbLoLabs) > 0
            for lbDel in lbLoLabs
                if not na(lbDel)
                    label.delete(lbDel)
            array.clear(lbLoLabs)

    // Update lines every bar
    for i = 0 to need - 1
        float hiV = array.get(lbHighs, i)
        float loV = array.get(lbLows,  i)
        line hLn = array.get(lbHiLines, i)
        line lLn = array.get(lbLoLines, i)
        line.set_y1(hLn, hiV), line.set_y2(hLn, hiV)
        line.set_y1(lLn, loV), line.set_y2(lLn, loV)
        line.set_extend(hLn, lbExtend), line.set_extend(lLn, lbExtend)
        line.set_style(hLn, lbStyle),   line.set_style(lLn, lbStyle)
        line.set_width(hLn, lookbackLineWidth), line.set_width(lLn, lookbackLineWidth)
        line.set_color(hLn, lookbackLineColorHi), line.set_color(lLn, lookbackLineColorLo)

        // Update labels only if toggle is ON
        if lookbackShowLabels
            // Ensure we have a label slot for this index
            if array.size(lbHiLabs) <= i
                array.push(lbHiLabs, label.new(timenow, hiV, "", xloc=xloc.bar_time, style=lbLabelStyle, yloc=yloc.price, size=f_lb_size(lookbackLabelSize), color=color.new(color.black, 100), textcolor=lookbackLineColorHi))
            if array.size(lbLoLabs) <= i
                array.push(lbLoLabs, label.new(timenow, loV, "", xloc=xloc.bar_time, style=lbLabelStyle, yloc=yloc.price, size=f_lb_size(lookbackLabelSize), color=color.new(color.black, 100), textcolor=lookbackLineColorLo))

            label hiLb = array.get(lbHiLabs, i)
            label loLb = array.get(lbLoLabs, i)
            if not na(hiLb)
                label.set_x(hiLb, timenow)
                label.set_y(hiLb, hiV)
                label.set_text(hiLb, f_lb_text(i, true, hiV))
                label.set_textcolor(hiLb, lookbackLineColorHi)
                label.set_style(hiLb, lbLabelStyle)
                label.set_size(hiLb, f_lb_size(lookbackLabelSize))
            if not na(loLb)
                label.set_x(loLb, timenow)
                label.set_y(loLb, loV)
                label.set_text(loLb, f_lb_text(i, false, loV))
                label.set_textcolor(loLb, lookbackLineColorLo)
                label.set_style(loLb, lbLabelStyle)
                label.set_size(loLb, f_lb_size(lookbackLabelSize))
else
    // Clean up everything when disabled or no data
    if array.size(lbHiLines) > 0
        for lnDel in lbHiLines
            if not na(lnDel)
                line.delete(lnDel)
        array.clear(lbHiLines)
    if array.size(lbLoLines) > 0
        for lnDel in lbLoLines
            if not na(lnDel)
                line.delete(lnDel)
        array.clear(lbLoLines)
    if array.size(lbHiLabs) > 0
        for lbDel in lbHiLabs
            if not na(lbDel)
                label.delete(lbDel)
        array.clear(lbHiLabs)
    if array.size(lbLoLabs) > 0
        for lbDel in lbLoLabs
            if not na(lbDel)
                label.delete(lbDel)
        array.clear(lbLoLabs)




