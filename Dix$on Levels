f_lblSize(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : _s == "Large" ? size.large : size.huge

f_intPctStr(_v) =>
    v = nz(_v, 0.0)
    r = math.round(v)
    r == 0 ? "0" : str.tostring(r)

f_anglePct_now(_series) =>
    now  = _series
    prev = _series[1]
    mt   = syminfo.mintick
    na(now) or na(prev) or mt == 0.0 ? 0.0 :
         (math.atan((now - prev) / mt) / (math.pi / 2)) * 100.0

f_buildLabel(_len, _val, _anglePct, _nameOn, _priceOn, _slopeOn, _slopeWord, _nameTag) =>
    string namePart  = _nameOn  ? (str.tostring(_len) + " " + _nameTag) : ""
    string pricePart = _priceOn ? ("$" + str.tostring(_val, format.mintick)) : ""
    string leftSide =
         namePart != "" and pricePart != "" ? (namePart + " / " + pricePart) :
         namePart != "" ? namePart :
         pricePart
    string slopePart = ""
    if _slopeOn
        if str.length(leftSide) > 0
            slopePart := (_slopeWord ? " | slope " : " | ") + f_intPctStr(_anglePct) + "%"
        else
            slopePart := (_slopeWord ? "slope " : "") + f_intPctStr(_anglePct) + "%"
    (leftSide + slopePart)

// Helper to place cross labels on a DMA with a small offset from the line
f_placeCrossLbl(_y, _txt, _isUp, _pad) =>
    if not na(_y)
        float adj = _isUp ? _pad : -_pad
        labelStyle = _isUp ? label.style_label_up : label.style_label_down
        label.new(
            bar_index,  // plot exactly on the cross bar
            _y + adj,
            _txt,
            yloc=yloc.price,
            color=color.new(color.black, 100),
            textcolor=_isUp ? color.new(#FFD700, 0) : color.red,
            style=labelStyle,
            size=size.normal)

