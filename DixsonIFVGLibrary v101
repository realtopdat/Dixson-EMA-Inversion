findNthDirectionalLiquidity(float entryLevel, int tradeDir, int nthTarget, bool useMergeBands, float reqThresholdTicks, float minTick, float[] liqPrices, int[] liqSweeps) =>
    float out = na
    int found = 0
    float lastFound = na
    float mergeThreshold = useMergeBands ? (reqThresholdTicks * minTick) : 0.0
    int liqCount = array.size(liqPrices)
    if liqCount > 0 and nthTarget > 0
        for step = 1 to nthTarget
            float nextLevel = na
            for i = 0 to liqCount - 1
                float lvl = array.get(liqPrices, i)
                int sweepBar = array.size(liqSweeps) > i ? array.get(liqSweeps, i) : na
                bool isAlive = na(sweepBar)
                bool dirOk = tradeDir == 1 ? lvl > entryLevel : lvl < entryLevel
                bool afterLast = na(lastFound) ? true : tradeDir == 1 ? lvl > (lastFound + mergeThreshold) : lvl < (lastFound - mergeThreshold)
                if isAlive and dirOk and afterLast
                    nextLevel := na(nextLevel) ? lvl : tradeDir == 1 ? math.min(nextLevel, lvl) : math.max(nextLevel, lvl)
            if not na(nextLevel)
                found += 1
                lastFound := nextLevel
                if found == nthTarget
                    out := nextLevel
    out

findDirectionalLiquidityWithMinMove(float entryLevel, int tradeDir, int nthQualified, float minMove, bool useMergeBands, float reqThresholdTicks, float minTick, float[] liqPrices, int[] liqSweeps) =>
    float outLevel = na
    int outRawNth = na
    int qualifiedCount = 0
    int liqCount = array.size(liqPrices)
    int maxScan = liqCount > 0 ? liqCount : 0
    if maxScan > 0 and nthQualified > 0
        for rawNth = 1 to maxScan
            float candidate = findNthDirectionalLiquidity(entryLevel, tradeDir, rawNth, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
            if na(candidate)
                break
            float move = math.abs(candidate - entryLevel)
            if move >= minMove
                qualifiedCount += 1
                if qualifiedCount == nthQualified
                    outLevel := candidate
                    outRawNth := rawNth
                    break
    [outLevel, outRawNth]

export computeTradeTargets(int tradeDir, float entryLevel, int originBar, int[] msZZDir, float[] msZZY, int[] msZZX, bool[] liqIsHighs, float[] liqPrices, int[] liqStartBars,
     int[] liqSweeps, bool useMergeBands, float reqThresholdTicks, float minTick) =>
