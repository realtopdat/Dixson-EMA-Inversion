    float liq1Level = findNthDirectionalLiquidity(entryLevel, tradeDir, 1, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
    float liq2Level = findNthDirectionalLiquidity(entryLevel, tradeDir, 2, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
    float liq3Level = findNthDirectionalLiquidity(entryLevel, tradeDir, 3, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
    [stopLevel, liq1Level, liq2Level, liq3Level]

