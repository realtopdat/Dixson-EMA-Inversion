export flagHasBit(int flags, int bitMask) =>
    math.floor(flags / bitMask) % 2 == 1

export flagOrBit(int baseFlags, int addFlags, int[] bitMasks) =>
    int out = baseFlags
    int bitCount = array.size(bitMasks)
    if bitCount > 0
        for i = 0 to bitCount - 1
            int bitMask = array.get(bitMasks, i)
            if flagHasBit(addFlags, bitMask) and not flagHasBit(out, bitMask)
                out += bitMask
    out

export computeLevelTfFlags(float lvl, bool isHigh, bool enableConfA, float reqThresholdTicks, float minTick, int tfBaseMask, int tfAMask, float[] pivPricesA, bool[] pivIsHighA) =>
    int flags = tfBaseMask
    if enableConfA
        float threshold = reqThresholdTicks * minTick
        int sz = math.min(array.size(pivPricesA), array.size(pivIsHighA))
        bool matched = false
        if sz > 0
            for i = sz - 1 to 0
                bool sameSide = array.get(pivIsHighA, i) == isHigh
                float pivotPrice = array.get(pivPricesA, i)
                if sameSide and math.abs(lvl - pivotPrice) <= threshold
                    matched := true
                    break
        if matched
            int[] bitMasks = array.from(tfAMask, tfBaseMask)
            flags := flagOrBit(flags, tfAMask, bitMasks)
    flags

export mitigates(bool inWindow, float loBand, float hiBand, float wickLow, float wickHigh, float closePx, bool touchedLow, bool touchedHigh, bool isBull, bool useWick) =>
    bool newTouchedLow = touchedLow
    bool newTouchedHigh = touchedHigh
    if inWindow
        if wickLow <= loBand
            newTouchedLow := true
        if wickHigh >= hiBand
            newTouchedHigh := true
    bool isMitigated = false
    if inWindow
        if useWick
            isMitigated := newTouchedLow and newTouchedHigh
        else
            isMitigated := isBull ? (newTouchedLow and newTouchedHigh and closePx >= hiBand) : (newTouchedLow and newTouchedHigh and closePx <= loBand)
    [isMitigated, newTouchedLow, newTouchedHigh]

export shrinkFormingZone(float hi, float lo, bool isBull, int originTime, int currentTfTime, float barHigh, float barLow) =>
    float outHi = hi
    float outLo = lo
    bool changed = false
    bool isForming = not na(originTime) and originTime == currentTfTime
    if isForming and barHigh >= lo and barLow <= hi
        if isBull
            float shrinkLo = math.max(lo, math.min(barHigh, hi))
            if shrinkLo != lo
                outLo := shrinkLo
                changed := true
        else
            float shrinkHi = math.min(hi, math.max(barLow, lo))
            if shrinkHi != hi
                outHi := shrinkHi
                changed := true
    [outHi, outLo, changed]

export cleanupHtfMitigations(int[] mitigatedIds, int[] mitigatedBars, int cutoffBar) =>
    int n = array.size(mitigatedIds)
    if n > 0
        for i = n - 1 to 0
