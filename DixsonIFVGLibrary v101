export htfEligibleId(int id, int[] activeIds, int[] mitigatedIds, int[] mitigatedBars, int originIdx, int maxBars) =>
    bool active = false
    if not na(id)
        int nIds = array.size(activeIds)
        if nIds > 0
            for i = 0 to nIds - 1
                if array.get(activeIds, i) == id
                    active := true
                    break
    bool mitigatedOk = false
    bool noCap = maxBars <= 0
    if not active and not na(id)
        int n = array.size(mitigatedIds)
        if n > 0
            for i = 0 to n - 1
                if array.get(mitigatedIds, i) == id
                    int mitBar = array.get(mitigatedBars, i)
                    mitigatedOk := not na(mitBar) and mitBar >= originIdx and (noCap or mitBar <= originIdx + maxBars)
                    break
    active or mitigatedOk

