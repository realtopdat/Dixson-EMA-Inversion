    else
        if na(out)
            out := label.new(x, y, txt, style=labelStyle, textcolor=color.white, color=bg, size=sz)
        else
            if label.get_x(out) != x
                label.set_x(out, x)
            if label.get_y(out) != y
                label.set_y(out, y)
            if label.get_text(out) != txt
                label.set_text(out, txt)
            label.set_color(out, bg)
            label.set_textcolor(out, color.white)
            label.set_size(out, sz)
            label.set_style(out, labelStyle)
    out


