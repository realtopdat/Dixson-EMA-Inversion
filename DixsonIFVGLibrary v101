export pruneTradeState(int cap, int[] tradeDirs, float[] tradeStops, float[] tradeBEs, float[] tradeR1s, float[] tradeR2s, float[] tradeTP1s, float[] tradeTP2s, bool[] tradeActive, bool[] tradeStopMoved) =>
    if cap > 0
        while array.size(tradeDirs) > cap
            int removeIdx = na
            int stateCount = array.size(tradeDirs)
            if stateCount > 0
                for i = 0 to stateCount - 1
                    bool isActive = array.size(tradeActive) > i ? array.get(tradeActive, i) : false
                    if not isActive
                        removeIdx := i
                        break
            if na(removeIdx)
                break
            array.remove(tradeDirs, removeIdx)
            array.remove(tradeStops, removeIdx)
            array.remove(tradeBEs, removeIdx)
            array.remove(tradeR1s, removeIdx)
            array.remove(tradeR2s, removeIdx)
            array.remove(tradeTP1s, removeIdx)
            array.remove(tradeTP2s, removeIdx)
            array.remove(tradeActive, removeIdx)
            array.remove(tradeStopMoved, removeIdx)

export updateActiveTradeLifecycle(float currentTradeStopStored, float currentTradeEntryStored, int[] tradeDirs, float[] tradeStops, float[] tradeBEs, float[] tradeR1s, float[] tradeR2s, float[] tradeTP1s, float[] tradeTP2s, bool[] tradeActive, bool[] tradeStopMoved,
     line[] tradeEntryLines, line[] tradeStopLines, line[] tradeBeLines, line[] tradeR1Lines, line[] tradeR2Lines, line[] tradeTp1Lines, line[] tradeTp2Lines,
     label[] tradeEntryLabels, label[] tradeStopLabels, label[] tradeBeLabels, label[] tradeR1Labels, label[] tradeR2Labels, label[] tradeTp1Labels, label[] tradeTp2Labels,
     string beTriggerMode, string tp1TargetMode, string tp2TargetMode, string endTradeLevel, bool keepEndedTradeLevels) =>
    float outCurrentStop = currentTradeStopStored
    bool trackedTradeActive = false
    int tradeCount = array.size(tradeActive)
    if tradeCount > 0
        for activeTradeIdx = 0 to tradeCount - 1
            if not array.get(tradeActive, activeTradeIdx)
                continue
            bool hasVisualRow = array.size(tradeEntryLines) > activeTradeIdx and array.size(tradeStopLines) > activeTradeIdx and array.size(tradeBeLines) > activeTradeIdx and
                 array.size(tradeR1Lines) > activeTradeIdx and array.size(tradeR2Lines) > activeTradeIdx and array.size(tradeTp1Lines) > activeTradeIdx and array.size(tradeTp2Lines) > activeTradeIdx and
                 array.size(tradeEntryLabels) > activeTradeIdx and array.size(tradeStopLabels) > activeTradeIdx and array.size(tradeBeLabels) > activeTradeIdx and
                 array.size(tradeR1Labels) > activeTradeIdx and array.size(tradeR2Labels) > activeTradeIdx and array.size(tradeTp1Labels) > activeTradeIdx and array.size(tradeTp2Labels) > activeTradeIdx
            if not hasVisualRow
                array.set(tradeActive, activeTradeIdx, false)
                continue
            int tDir = array.get(tradeDirs, activeTradeIdx)
            float tStop = array.get(tradeStops, activeTradeIdx)
            float tBe = array.get(tradeBEs, activeTradeIdx)
            float tR1 = array.get(tradeR1s, activeTradeIdx)
            float tR2 = array.get(tradeR2s, activeTradeIdx)
            float tTp1 = array.get(tradeTP1s, activeTradeIdx)
            float tTp2 = array.get(tradeTP2s, activeTradeIdx)
            line activeEntryLine = array.get(tradeEntryLines, activeTradeIdx)
            float tEntry = not na(activeEntryLine) ? line.get_y1(activeEntryLine) : na
            bool movedToBe = array.get(tradeStopMoved, activeTradeIdx)
            line slLn = array.get(tradeStopLines, activeTradeIdx)
            label slLb = array.get(tradeStopLabels, activeTradeIdx)
            float beTriggerLevel = tBe
            bool hitBeTrigger = tDir == 1 ? (not na(beTriggerLevel) and high >= beTriggerLevel) : (not na(beTriggerLevel) and low <= beTriggerLevel)
            if not movedToBe and hitBeTrigger and not na(tEntry)
                movedToBe := true
                tStop := tEntry
                array.set(tradeStopMoved, activeTradeIdx, true)
                array.set(tradeStops, activeTradeIdx, tStop)
            if movedToBe
                if not na(slLn)
                    line.delete(slLn)
                    array.set(tradeStopLines, activeTradeIdx, na)
                if not na(slLb)
                    label.delete(slLb)
                    array.set(tradeStopLabels, activeTradeIdx, na)
            bool stopBrokenClose = tDir == 1 ? close < tStop : close > tStop
            float endTarget = endTradeLevel == "1R" ? tR1 : endTradeLevel == "2R" ? tR2 : endTradeLevel == "TP1" ? tTp1 : tTp2
            bool endTargetHit = tDir == 1 ? (not na(endTarget) and high >= endTarget) : (not na(endTarget) and low <= endTarget)
            bool tradeDone = stopBrokenClose or endTargetHit
            int endX = tradeDone ? bar_index : bar_index + 5
            bool beSharesR1 = (beTriggerMode == "1R") or (not na(tBe) and not na(tR1) and tBe == tR1)
            bool tp1SharesR1 = (tp1TargetMode == "1R") or (not na(tTp1) and not na(tR1) and tTp1 == tR1)
            bool tp2SharesR2 = (tp2TargetMode == "2R") or (not na(tTp2) and not na(tR2) and tTp2 == tR2)
            string r1Title = "1R" + (beSharesR1 ? " / BE" : "") + (tp1SharesR1 ? " / TP1" : "")
            string r2Title = "2R" + (tp2SharesR2 ? " / TP2" : "")
            string beTitle = beSharesR1 ? r1Title : "BE"
            string tp1Title = tp1SharesR1 ? r1Title : "TP1"
            string tp2Title = tp2SharesR2 ? r2Title : "TP2"
            string entryTitle = movedToBe ? "Entry/SL" : "Entry"
            updateTradeLevelVisual(activeEntryLine, array.get(tradeEntryLabels, activeTradeIdx), tEntry, entryTitle, endX)
            updateTradeLevelVisual(array.get(tradeStopLines, activeTradeIdx), array.get(tradeStopLabels, activeTradeIdx), tStop, "SL", endX)
            updateTradeLevelVisual(array.get(tradeBeLines, activeTradeIdx), array.get(tradeBeLabels, activeTradeIdx), tBe, beTitle, endX)
            updateTradeLevelVisual(array.get(tradeR1Lines, activeTradeIdx), array.get(tradeR1Labels, activeTradeIdx), tR1, r1Title, endX)
            updateTradeLevelVisual(array.get(tradeR2Lines, activeTradeIdx), array.get(tradeR2Labels, activeTradeIdx), tR2, r2Title, endX)
            updateTradeLevelVisual(array.get(tradeTp1Lines, activeTradeIdx), array.get(tradeTp1Labels, activeTradeIdx), tTp1, tp1Title, endX)
            updateTradeLevelVisual(array.get(tradeTp2Lines, activeTradeIdx), array.get(tradeTp2Labels, activeTradeIdx), tTp2, tp2Title, endX)
            bool isTrackedTrade = not na(currentTradeEntryStored) and not na(tEntry) and tEntry == currentTradeEntryStored
            if tradeDone
                array.set(tradeActive, activeTradeIdx, false)
                if not keepEndedTradeLevels
                    deleteTradeVisualRow(activeTradeIdx, tradeEntryLines, tradeStopLines, tradeBeLines, tradeR1Lines, tradeR2Lines, tradeTp1Lines, tradeTp2Lines,
                         tradeEntryLabels, tradeStopLabels, tradeBeLabels, tradeR1Labels, tradeR2Labels, tradeTp1Labels, tradeTp2Labels)
            else if isTrackedTrade
                trackedTradeActive := true
                outCurrentStop := tStop
    [outCurrentStop, trackedTradeActive]

export processTradeEvent(bool bullEntryTrade, float bullEntryPrice, float bearEntryPrice, int bullMitOriginIdx, int bearMitOriginIdx,
     int enabledEntryFilterCount, int bullPassFilterCount, int bearPassFilterCount, int[] msZZDir, float[] msZZY, int[] msZZX, bool[] liqIsHighs, float[] liqPrices, int[] liqStartBars, int[] liqSweeps,
     bool useMergeBands, float reqThresholdTicks, float minTick,
     bool showEntryLevel, bool showStopLevel, bool showBeLevel, bool showR1Level, bool showR2Level, bool showTp1Level, bool showTp2Level,
     bool showEntryPriceLabel, bool showStopPriceLabel, bool showBePriceLabel, bool showR1PriceLabel, bool showR2PriceLabel, bool showTp1PriceLabel, bool showTp2PriceLabel,
     color entryLineColor, color stopLineColor, color beLineColor, color r1LineColor, color r2LineColor, color tp1LineColor, color tp2LineColor,
     string beTargetMode, string tp1TargetMode, string tp2TargetMode,
     line[] tradeEntryLines, line[] tradeStopLines, line[] tradeBeLines, line[] tradeR1Lines, line[] tradeR2Lines, line[] tradeTp1Lines, line[] tradeTp2Lines,
     label[] tradeEntryLabels, label[] tradeStopLabels, label[] tradeBeLabels, label[] tradeR1Labels, label[] tradeR2Labels, label[] tradeTp1Labels, label[] tradeTp2Labels,
     int[] tradeDirs, float[] tradeStops, float[] tradeBEs, float[] tradeR1s, float[] tradeR2s, float[] tradeTP1s, float[] tradeTP2s, bool[] tradeActive, bool[] tradeStopMoved,
     bool keepActiveTrades, int activeTradeCap, bool keepEndedTradeLevels) =>
    int activeCount = 0
    int tradeCountBefore = array.size(tradeActive)
    if tradeCountBefore > 0
        for i = 0 to tradeCountBefore - 1
            if array.get(tradeActive, i)
                activeCount += 1
    int forcedCloseCount = 0
    if not keepActiveTrades
        forcedCloseCount := activeCount
    else if activeTradeCap > 0 and activeCount >= activeTradeCap
        forcedCloseCount := activeCount - activeTradeCap + 1
    if forcedCloseCount > 0 and tradeCountBefore > 0
        for closeN = 0 to forcedCloseCount - 1
            int closeIdx = na
            for i = 0 to array.size(tradeActive) - 1
                if array.get(tradeActive, i)
                    closeIdx := i
                    break
            if na(closeIdx)
                break
            endTradeVisualRow(closeIdx, bar_index, tradeEntryLines, tradeStopLines, tradeBeLines, tradeR1Lines, tradeR2Lines, tradeTp1Lines, tradeTp2Lines,
                 tradeEntryLabels, tradeStopLabels, tradeBeLabels, tradeR1Labels, tradeR2Labels, tradeTp1Labels, tradeTp2Labels)
            array.set(tradeActive, closeIdx, false)
            if not keepEndedTradeLevels
                deleteTradeVisualRow(closeIdx, tradeEntryLines, tradeStopLines, tradeBeLines, tradeR1Lines, tradeR2Lines, tradeTp1Lines, tradeTp2Lines,
                     tradeEntryLabels, tradeStopLabels, tradeBeLabels, tradeR1Labels, tradeR2Labels, tradeTp1Labels, tradeTp2Labels)
    int tradeDir = bullEntryTrade ? 1 : -1
    float entryLevel = bullEntryTrade ? bullEntryPrice : bearEntryPrice
    int originBar = bullEntryTrade ? bullMitOriginIdx : bearMitOriginIdx
    float mitigationWindowStop = mitigationStopFromWindow(tradeDir, originBar)
    float formationStop = originFormationStop(tradeDir, originBar)
    float stopPlacementWindow = na(mitigationWindowStop) ? formationStop : na(formationStop) ? mitigationWindowStop : tradeDir == 1 ? math.min(mitigationWindowStop, formationStop) : math.max(mitigationWindowStop, formationStop)
    [stopLevel, liq1Level, liq2Level, liq3Level] = computeTradeTargets(tradeDir, entryLevel, originBar, msZZDir, msZZY, msZZX, liqIsHighs, liqPrices, liqStartBars, liqSweeps, useMergeBands, reqThresholdTicks, minTick)
    stopLevel := not na(stopPlacementWindow) ? stopPlacementWindow : stopLevel
    float riskR = tradeDir == 1 ? entryLevel - stopLevel : stopLevel - entryLevel
    float r1Level = na
    float r2Level = na
    float beLevel = na
    float tp1Level = na
    float tp2Level = na
    if not na(riskR) and riskR > 0
        r1Level := tradeDir == 1 ? entryLevel + riskR : entryLevel - riskR
        r2Level := tradeDir == 1 ? entryLevel + (riskR * 2.0) : entryLevel - (riskR * 2.0)
    int beRawNth = 1
    float beLiquidityLevel = liq1Level
    if beTargetMode == "Liquidity 1" and not na(riskR) and riskR > 0
        float minBeMove = riskR * 0.5
        [beLiquidityLevelTmp, beRawNthTmp] = findDirectionalLiquidityWithMinMove(entryLevel, tradeDir, 1, minBeMove, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
        beLiquidityLevel := beLiquidityLevelTmp
        beRawNth := not na(beRawNthTmp) ? beRawNthTmp : 1
    float tp1LiquidityLevel = findNthDirectionalLiquidity(entryLevel, tradeDir, beTargetMode == "Liquidity 1" ? beRawNth + 1 : 2, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
    float tp2LiquidityLevel = findNthDirectionalLiquidity(entryLevel, tradeDir, beTargetMode == "Liquidity 1" ? beRawNth + 2 : 3, useMergeBands, reqThresholdTicks, minTick, liqPrices, liqSweeps)
    bool beLiquidityMode = beTargetMode == "Liquidity 1"
    bool tp1LiquidityMode = tp1TargetMode == "Liquidity 2"
    bool tp2LiquidityMode = tp2TargetMode == "Liquidity 3"
    beLevel := beLiquidityMode ? beLiquidityLevel : r1Level
    tp1Level := tp1LiquidityMode ? tp1LiquidityLevel : r1Level
    tp2Level := tp2LiquidityMode ? tp2LiquidityLevel : r2Level
    if beLiquidityMode and na(beLevel)
        beLevel := r1Level
    if tp1LiquidityMode and na(tp1Level)
        tp1Level := r1Level
    if tp2LiquidityMode and na(tp2Level)
        tp2Level := r2Level
    if not na(beLevel) and not na(tp1Level)
        if tradeDir == 1 and tp1Level < beLevel
            tp1Level := beLevel
        if tradeDir == -1 and tp1Level > beLevel
            tp1Level := beLevel
    if not na(tp1Level) and not na(tp2Level)
        if tradeDir == 1 and tp2Level < tp1Level
            tp2Level := tp1Level
        if tradeDir == -1 and tp2Level > tp1Level
            tp2Level := tp1Level
    bool beSharesR1 = not na(beLevel) and not na(r1Level) and beLevel == r1Level
