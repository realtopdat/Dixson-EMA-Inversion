export findWindowSweepBar(bool wantBuyside, int windowStartBar, int[] sweeps, bool[] isHighs, int scanCap) =>
    int out = na
    if not na(windowStartBar) and array.size(sweeps) > 0
        int processCap = math.min(array.size(sweeps), scanCap)
        int scanStart = math.max(array.size(sweeps) - processCap, 0)
        for idx = scanStart to array.size(sweeps) - 1
            int sweepBar = array.size(sweeps) > idx ? array.get(sweeps, idx) : na
            bool isHigh = array.size(isHighs) > idx ? array.get(isHighs, idx) : false
            if not na(sweepBar) and isHigh == wantBuyside and sweepBar >= windowStartBar and sweepBar <= bar_index + 1
                out := na(out) ? sweepBar : math.max(out, sweepBar)
    out

export bridgeOriginIdx(int[] fvgIndices, int currentOriginIdx, int bridgeBars) =>
    int out = currentOriginIdx
    if not na(currentOriginIdx) and bridgeBars > 0 and array.size(fvgIndices) > 0
        int prevIdx = na
        for i = 0 to array.size(fvgIndices) - 1
            int idx = array.get(fvgIndices, i)
            if idx < currentOriginIdx
                prevIdx := na(prevIdx) ? idx : math.max(prevIdx, idx)
        if not na(prevIdx) and currentOriginIdx - prevIdx <= bridgeBars
            out := prevIdx
    out

