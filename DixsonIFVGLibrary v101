            if na(mitBar) or mitBar < cutoffBar
                array.remove(mitigatedIds, i)
                array.remove(mitigatedBars, i)
    false

export htfTouchIdSide(float wickLow, float wickHigh, float[] tops, float[] bots, int[] ids) =>
    int outId = na
    int nZones = array.size(tops)
    if nZones > 0
        for i = 0 to nZones - 1
            int idx = nZones - 1 - i
            float top = array.get(tops, idx)
            float bot = array.get(bots, idx)
            float hi = math.max(top, bot)
            float lo = math.min(top, bot)
            if wickHigh >= lo and wickLow <= hi
                outId := array.get(ids, idx)
                break
    outId

