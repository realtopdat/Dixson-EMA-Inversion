export computeChecklistState(bool lastHasState, int lastConfirmedEntryDir, int lastConfirmedBarsToMit, int vShapeBarsDisplay, string lastConfirmedDeliveryDisplay, string lastConfirmedSweepDisplay, string lastConfirmedSmtDisplay,
     bool activeLongState, bool activeShortState, int bullBarsToMit, int bearBarsToMit, string bullDeliveredTFs, bool bullDeliveredAny, string bearDeliveredTFs, bool bearDeliveredAny,
     bool showLiquiditySweeps, bool bullSweepInWindow, bool bearSweepInWindow, bool enableSmtDivergence, bool bullSmtWindowHit, bool bearSmtWindowHit, int msDir) =>
    int checklistDir = lastHasState ? lastConfirmedEntryDir : activeLongState ? 1 : activeShortState ? -1 : 0
    int checklistBars = lastHasState ? lastConfirmedBarsToMit : checklistDir == 1 ? bullBarsToMit : checklistDir == -1 ? bearBarsToMit : na
    string checklistBarsDisplay = not na(checklistBars) ? ((checklistBars <= vShapeBarsDisplay ? "✅ " : "❌ ") + str.tostring(checklistBars)) : "━"
    string checklistDeliveryDisplay = lastHasState ? lastConfirmedDeliveryDisplay :
         checklistDir == 1 ? (str.length(bullDeliveredTFs) > 0 ? "✅ " + bullDeliveredTFs : bullDeliveredAny ? "✅" : "❌") :
         checklistDir == -1 ? (str.length(bearDeliveredTFs) > 0 ? "✅ " + bearDeliveredTFs : bearDeliveredAny ? "✅" : "❌") : "━"
    string checklistSweepDisplay = lastHasState ? lastConfirmedSweepDisplay :
         checklistDir == 1 ? (showLiquiditySweeps ? (bullSweepInWindow ? "✅ SSL" : "❌") : "━") :
         checklistDir == -1 ? (showLiquiditySweeps ? (bearSweepInWindow ? "✅ BSL" : "❌") : "━") : "━"
    string checklistSmtDisplay = lastHasState ? lastConfirmedSmtDisplay :
         checklistDir == 1 ? (enableSmtDivergence ? (bullSmtWindowHit ? "✅" : "❌") : "━") :
         checklistDir == -1 ? (enableSmtDivergence ? (bearSmtWindowHit ? "✅" : "❌") : "━") : "━"
    string checklistMssDisplay = checklistDir != 0 ? (msDir == 0 ? "━" : ((checklistDir == 1 and msDir == 1) or (checklistDir == -1 and msDir == -1) ? "✅" : "❌")) : "━"
    [checklistBarsDisplay, checklistDeliveryDisplay, checklistSweepDisplay, checklistSmtDisplay, checklistMssDisplay]

displayPasses(string displayIn) =>
    str.pos(displayIn, "✅") == 0

deliveryBuckets(string deliveryDisplayIn) =>
    bool hasContinuation = false
    bool hasReversal = false
    string normalized = str.replace_all(str.replace_all(deliveryDisplayIn, "✅", ""), " ", "")
    if str.length(normalized) > 0
        string[] parts = str.split(normalized, ",")
        int partCount = array.size(parts)
        if partCount > 0
            for i = 0 to partCount - 1
                string tfToken = array.get(parts, i)
                int tokenLen = str.length(tfToken)
                if tokenLen >= 2
                    string lastTwo = str.lower(str.substring(tfToken, tokenLen - 2, tokenLen))
                    string lastOne = str.lower(str.substring(tfToken, tokenLen - 1, tokenLen))
                    if lastTwo == "mo" or lastOne == "h" or lastOne == "d" or lastOne == "w"
                        hasReversal := true
                    else if lastOne == "m"
                        float tfMinutes = str.tonumber(str.substring(tfToken, 0, tokenLen - 1))
                        if not na(tfMinutes)
                            hasContinuation := hasContinuation or tfMinutes == 5 or tfMinutes == 15
                            hasReversal := hasReversal or tfMinutes >= 30
    [hasContinuation, hasReversal]

export computeChecklistGrade(string checklistDeliveryDisplay, string checklistSweepDisplay, string checklistMssDisplay, string checklistBarsDisplay) =>
    bool noChecklistContext = checklistDeliveryDisplay == "━" and checklistSweepDisplay == "━" and checklistMssDisplay == "━" and checklistBarsDisplay == "━"
    bool hasSweep = displayPasses(checklistSweepDisplay)
    bool hasMss = displayPasses(checklistMssDisplay)
    bool hasVShape = displayPasses(checklistBarsDisplay)
    [isContinuationBucket, isReversalBucket] = deliveryBuckets(checklistDeliveryDisplay)
    bool qualifiesA = isReversalBucket or (isContinuationBucket and hasMss)
    if noChecklistContext
        "━"
    else if qualifiesA
        hasSweep ? "A+" : "A"
    else
        isContinuationBucket and (not hasMss) and hasVShape ? "B" : "C"

mitigationStopFromWindow(int tradeDir, int originBar) =>
    int barsSinceOrigin = not na(originBar) ? (bar_index - originBar) : na
    float out = na
    if not na(barsSinceOrigin) and barsSinceOrigin > 1
        int lookbackBars = barsSinceOrigin + 2
        float extreme = na
        for j = 1 to lookbackBars
            if j != barsSinceOrigin
                float candidate = tradeDir == 1 ? low[j] : high[j]
                if not na(candidate)
                    extreme := na(extreme) ? candidate : tradeDir == 1 ? math.min(extreme, candidate) : math.max(extreme, candidate)
        out := extreme
    out

originFormationStop(int tradeDir, int originBar) =>
    int barsSinceOrigin = not na(originBar) ? (bar_index - originBar) : na
    float out = na
    if not na(barsSinceOrigin) and barsSinceOrigin >= 0
        int startIdx = barsSinceOrigin
        int endIdx = barsSinceOrigin + 3
        float extreme = na
        for j = startIdx to endIdx
            if j >= 0
                float candidate = tradeDir == 1 ? low[j] : high[j]
                if not na(candidate)
                    extreme := na(extreme) ? candidate : tradeDir == 1 ? math.min(extreme, candidate) : math.max(extreme, candidate)
        out := extreme
    out

