export hasActiveTradeDir(int dir, int[] tradeDirsArr, bool[] tradeActiveArr) =>
    bool out = false
    int n = math.min(array.size(tradeDirsArr), array.size(tradeActiveArr))
    if n > 0
        for i = 0 to n - 1
            if array.get(tradeActiveArr, i) and array.get(tradeDirsArr, i) == dir
                out := true
                break
    out

export tradeEventVisualState(bool bullEntryTrade, bool bearEntryTrade, bool showSameDirectionTrades, bool showTradeLevels, int[] tradeDirsArr, bool[] tradeActiveArr) =>
    bool allowBull = bullEntryTrade and (showSameDirectionTrades or not hasActiveTradeDir(1, tradeDirsArr, tradeActiveArr))
    bool allowBear = bearEntryTrade and (showSameDirectionTrades or not hasActiveTradeDir(-1, tradeDirsArr, tradeActiveArr))
    bool triggered = bullEntryTrade or bearEntryTrade
    bool showForEvent = showTradeLevels and (bullEntryTrade ? allowBull : allowBear)
    [triggered, showForEvent]


export deleteLabelArray(label[] arr) =>
    int sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            label lb = array.get(arr, i)
            if not na(lb)
                label.delete(lb)
            array.set(arr, i, na)

export trimSessionLevels(int cap, line[] hiLines, line[] loLines, label[] hiLabels, label[] loLabels, int[] starts) =>
    if cap > 0
        while array.size(starts) > cap
            line hiLn = array.shift(hiLines)
            line loLn = array.shift(loLines)
            label hiLb = array.shift(hiLabels)
            label loLb = array.shift(loLabels)
            array.shift(starts)
            if not na(hiLn)
                line.delete(hiLn)
            if not na(loLn)
                line.delete(loLn)
            if not na(hiLb)
                label.delete(hiLb)
            if not na(loLb)
                label.delete(loLb)




export sessionHigh(string sessionStr, string tz) =>
    var float outHigh = na
    bool inSess = not na(time(timeframe.period, sessionStr, tz))
    if inSess and not inSess[1]
        outHigh := high
    else if inSess
        outHigh := math.max(outHigh, high)
    outHigh

export sessionLow(string sessionStr, string tz) =>
    var float outLow = na
    bool inSess = not na(time(timeframe.period, sessionStr, tz))
    if inSess and not inSess[1]
        outLow := low
    else if inSess
        outLow := math.min(outLow, low)
    outLow

export sessionStartTime(string sessionStr, string tz) =>
    var int outStart = na
    bool inSess = not na(time(timeframe.period, sessionStr, tz))
    if inSess and not inSess[1]
        outStart := time
    outStart


export sessionDayLevels(string sessionStr, string tz) =>
    var float dayHigh = na
    var float dayLow = na
    var float prevDayHigh = na
    var float prevDayLow = na
    var int sessionStart = na
    bool inSess = not na(time(timeframe.period, sessionStr, tz))
    bool sessDateChanged = inSess and (na(time[1]) or year(time, tz) != year(time[1], tz) or month(time, tz) != month(time[1], tz) or dayofmonth(time, tz) != dayofmonth(time[1], tz))
    bool newSess = inSess and (not inSess[1] or sessDateChanged)
    if newSess
        prevDayHigh := dayHigh
        prevDayLow := dayLow
        dayHigh := high
        dayLow := low
        sessionStart := time
    else if inSess
        dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
        dayLow := na(dayLow) ? low : math.min(dayLow, low)
    [dayHigh, dayLow, prevDayHigh, prevDayLow, sessionStart, newSess]










export liqEngine(int pivotLeft, int pivotRight) =>
    float pivotHighRaw = ta.pivothigh(high, pivotLeft, pivotRight)
    float pivotLowRaw = ta.pivotlow(low, pivotLeft, pivotRight)
    bool highTrigger = not na(pivotHighRaw)
    bool lowTrigger = not na(pivotLowRaw)
    float pivotHighLevel = highTrigger ? pivotHighRaw : na
    int pivotHighTime = highTrigger ? time[pivotRight] : na
    float pivotLowLevel = lowTrigger ? pivotLowRaw : na
    int pivotLowTime = lowTrigger ? time[pivotRight] : na

    var float lastSwingHigh = na
    var float lastSwingLow = na
    var float rangeHigh = na
    var float rangeLow = na
    var bool rangeValid = false
    var bool waitingForHigh = false
    var bool waitingForLow = false
    int rangeChangeTime = na
    bool prevRangeValid = rangeValid

    if not na(pivotHighRaw)
        lastSwingHigh := pivotHighRaw
    if not na(pivotLowRaw)
        lastSwingLow := pivotLowRaw

    bool bullMsb = not na(lastSwingHigh) and close > lastSwingHigh
    bool bearMsb = not na(lastSwingLow) and close < lastSwingLow

    if bullMsb
        rangeLow := lastSwingLow
        rangeHigh := na
        rangeValid := false
        waitingForHigh := true
        waitingForLow := false
        rangeChangeTime := time
    if bearMsb
        rangeHigh := lastSwingHigh
        rangeLow := na
        rangeValid := false
        waitingForLow := true
        waitingForHigh := false
        rangeChangeTime := time

    if waitingForHigh and not na(pivotHighRaw)
        rangeHigh := pivotHighRaw
        waitingForHigh := false
        rangeValid := not na(rangeLow)
        rangeChangeTime := time
    if waitingForLow and not na(pivotLowRaw)
        rangeLow := pivotLowRaw
        waitingForLow := false
        rangeValid := not na(rangeHigh)
        rangeChangeTime := time

    if not prevRangeValid and rangeValid
        rangeChangeTime := na(rangeChangeTime) ? time : rangeChangeTime

    [pivotHighLevel, pivotHighTime, pivotLowLevel, pivotLowTime, rangeHigh, rangeLow, rangeValid, rangeChangeTime]

export gapCountAliveForSetDir(int[] gapSetId, bool[] gapIsBull, bool[] gapMitigated, int setId, bool isBull) =>
    int count = 0
    int n = array.size(gapSetId)
    if n > 0
        for idx = 0 to n - 1
            if array.get(gapSetId, idx) == setId and array.get(gapIsBull, idx) == isBull and not array.get(gapMitigated, idx)
                count += 1
    count

export upsertLiqLabelCore(label lb, int x, float price, string labelText, color txtColor, string labelXloc, string st, string loc, string align, bool showLabels, string lblSize) =>
    label out = lb
    if not showLabels or str.length(labelText) == 0
        if not na(out)
            label.delete(out)
        out := na
    else
        if na(out)
            out := label.new(x, price, labelText, style=st, yloc=loc, xloc=labelXloc,
                 color=color.new(color.black, 100), textcolor=txtColor, size=lblSize, textalign=align)
        else
            label.set_xloc(out, x, labelXloc)
            if label.get_y(out) != price
                label.set_y(out, price)
            if label.get_text(out) != labelText
                label.set_text(out, labelText)
            label.set_textcolor(out, txtColor)
            label.set_size(out, lblSize)
            label.set_yloc(out, loc)
            label.set_style(out, st)
            label.set_textalign(out, align)
    out


export upsertSessionKeyLevels(bool showLevels, bool useSweepDetection, float sessHigh, float sessLow, int sessStart,
     int sessionLineEndTime, int sessionLookbackCap, color lineColor, string lineStyle, string lineExtendMode, int lineWidth,
     string highLabelShort, string lowLabelShort, bool showLabels, string labelSize,
     line[] highLines, line[] lowLines, label[] highLabels, label[] lowLabels, int[] sessionStarts, int lastSessionStart) =>
    bool sweepHigh = false
    bool sweepLow = false
    int nextLastSessionStart = lastSessionStart
    if showLevels and not na(sessHigh) and not na(sessLow) and not na(sessStart)
        bool isNewSession = na(nextLastSessionStart) or sessStart != nextLastSessionStart
        if isNewSession
            array.push(highLines, line.new(sessStart, sessHigh, sessionLineEndTime, sessHigh, extend=lineExtendMode, color=lineColor, style=lineStyle, width=lineWidth, xloc=xloc.bar_time))
            array.push(lowLines, line.new(sessStart, sessLow, sessionLineEndTime, sessLow, extend=lineExtendMode, color=lineColor, style=lineStyle, width=lineWidth, xloc=xloc.bar_time))
            array.push(highLabels, upsertLiqLabelCore(na, time_close, sessHigh, liqLabelText(highLabelShort, sessHigh), lineColor, xloc.bar_time, label.style_none, yloc.price, text.align_left, showLabels, labelSize))
            array.push(lowLabels, upsertLiqLabelCore(na, time_close, sessLow, liqLabelText(lowLabelShort, sessLow), lineColor, xloc.bar_time, label.style_none, yloc.price, text.align_left, showLabels, labelSize))
            array.push(sessionStarts, sessStart)
            nextLastSessionStart := sessStart
        int idx = array.size(highLines) - 1
        if idx >= 0
            line hi = array.get(highLines, idx)
            line lo = array.get(lowLines, idx)
            label hiLb = array.get(highLabels, idx)
            label loLb = array.get(lowLabels, idx)
            line.set_xloc(hi, sessStart, time_close, xloc.bar_time)
            line.set_y1(hi, sessHigh)
            line.set_y2(hi, sessHigh)
            line.set_color(hi, lineColor)
            line.set_style(hi, lineStyle)
            line.set_extend(hi, lineExtendMode)
            line.set_xloc(lo, sessStart, time_close, xloc.bar_time)
            line.set_y1(lo, sessLow)
            line.set_y2(lo, sessLow)
            line.set_color(lo, lineColor)
            line.set_style(lo, lineStyle)
            line.set_extend(lo, lineExtendMode)
            hiLb := upsertLiqLabelCore(hiLb, time_close, sessHigh, liqLabelText(highLabelShort, sessHigh), lineColor, xloc.bar_time, label.style_none, yloc.price, text.align_left, showLabels, labelSize)
            loLb := upsertLiqLabelCore(loLb, time_close, sessLow, liqLabelText(lowLabelShort, sessLow), lineColor, xloc.bar_time, label.style_none, yloc.price, text.align_left, showLabels, labelSize)
            array.set(highLabels, idx, hiLb)
            array.set(lowLabels, idx, loLb)
        if useSweepDetection
            sweepHigh := (high > sessHigh and close < sessHigh) or (high[1] > sessHigh and close < sessHigh)
            sweepLow := (low < sessLow and close > sessLow) or (low[1] < sessLow and close > sessLow)
        trimSessionLevels(sessionLookbackCap, highLines, lowLines, highLabels, lowLabels, sessionStarts)
    [sweepHigh, sweepLow, nextLastSessionStart]

export upsertGapLabelCore(label lb, int x, float y, string txt, color bg, string sz, string labelStyle) =>
    label out = lb
    if str.length(txt) == 0
        if not na(out)
            label.delete(out)
