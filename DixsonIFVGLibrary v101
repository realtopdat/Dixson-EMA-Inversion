joinLabel(string base, string piece) =>
    str.length(base) > 0 ? base + " | " + piece : piece

export joinComma(string base, string piece) =>
    str.length(base) > 0 ? base + ", " + piece : piece

export tfLabel(string tfStr) =>
    if str.length(tfStr) == 0
        ""
    else
        float tfNum = str.tonumber(tfStr)
        if not na(tfNum)
            float minutes = tfNum
            float hrs = minutes / 60.0
            bool isHourTf = math.round(hrs) * 60.0 == minutes
            if isHourTf
                str.tostring(minutes / 60.0, "#") + "H"
            else
                tfStr + "M"
        else
            string lastCh = str.lower(str.substring(tfStr, str.length(tfStr) - 1, str.length(tfStr)))
            string base   = str.substring(tfStr, 0, str.length(tfStr) - 1)
            string numPart = str.length(base) > 0 ? base : "1"
            lastCh == "d" ? numPart + "D" :
             lastCh == "w" ? numPart + "W" :
             lastCh == "m" ? numPart + "Mo" :
             lastCh == "h" ? numPart + "H" :
             tfStr + "M"

export gapPercent(float front, float hi, float lo, bool fillsUp, float minTick) =>
    math.min(math.max((fillsUp ? (front - lo) : (hi - front)) / math.max(hi - lo, minTick) * 100.0, 0.0), 100.0)

export gapDistanceToPrice(float hi, float lo, float price) =>
    float hiBand = math.max(hi, lo)
    float loBand = math.min(hi, lo)
    price >= loBand and price <= hiBand ? 0.0 : math.min(math.abs(price - loBand), math.abs(price - hiBand))

export gapLabelText(string typeTxt, string tfTxt, bool includeTf, int originTime, float pctMit, bool showType, bool showTf, bool showDateTime, bool showPercent) =>
    txt = ""
    txt := showType ? joinLabel(txt, typeTxt) : txt
    string tfPretty = includeTf and str.length(tfTxt) > 0 ? tfLabel(tfTxt) : ""
    txt := showTf and str.length(tfPretty) > 0 ? joinLabel(txt, tfPretty) : txt
    txt := showDateTime and not na(originTime) ? joinLabel(txt, str.format("{0,time,MM/dd/yy HH:mm}", originTime)) : txt
    pctRounded = not na(pctMit) ? math.round(pctMit) : na
    txt := showPercent and not na(pctRounded) ? joinLabel(txt, str.tostring(pctRounded, "#") + "%") : txt
    txt

export coreFvgLabelText(bool isInverted, string tfTxt, bool showTf) =>
    string base = isInverted ? "IFVG" : "FVG"
    showTf and str.length(tfTxt) > 0 ? base + " | " + tfTxt : base

