findNearestStructureLevel(float anchor, bool wantHigh, bool wantAbove, int[] msDirs, float[] msLevels, bool[] liqIsHighs, float[] liqLevels) =>
    float out = na
    int msCount = array.size(msLevels)
    if msCount > 0
        for i = 0 to msCount - 1
            int dir = array.get(msDirs, i)
            float lvl = array.get(msLevels, i)
            bool sideOk = (wantHigh and dir == 1) or (not wantHigh and dir == -1)
            bool dirOk = wantAbove ? lvl > anchor : lvl < anchor
            if sideOk and dirOk
                out := na(out) ? lvl : wantAbove ? math.min(out, lvl) : math.max(out, lvl)
    int liqCount = array.size(liqLevels)
    if liqCount > 0
        for i = 0 to liqCount - 1
            bool isHigh = array.get(liqIsHighs, i)
            float lvl = array.get(liqLevels, i)
            bool sideOk = (wantHigh and isHigh) or (not wantHigh and not isHigh)
            bool dirOk = wantAbove ? lvl > anchor : lvl < anchor
            if sideOk and dirOk
                out := na(out) ? lvl : wantAbove ? math.min(out, lvl) : math.max(out, lvl)
    out

