//@version=6
indicator("Dix$on EMA Inversion", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━
// Input Groups
//━━━━━━━━━━━━━━━━━━━━
string GROUP_EMA = "EMA Settings"
string GROUP_FVG = "FVG Settings"
string GROUP_IFVG = "IFVG Settings"
string GROUP_ENTRY = "Entry Settings"
string GROUP_DISPLAY = "Display Settings"
string GROUP_ALERTS = "Alert Settings"

//━━━━━━━━━━━━━━━━━━━━
// EMA Settings
//━━━━━━━━━━━━━━━━━━━━
shortEmaTf = input.timeframe("", "Short EMA Timeframe", group=GROUP_EMA, tooltip="Timeframe for the short EMA. Default blank uses current chart timeframe.", display=display.none)
shortEmaLength = input.int(31, "Short EMA Length", minval=1, group=GROUP_EMA, tooltip="Length for short EMA trend filter and spread fill. Default 31.", display=display.none)
shortMtfSmoothMode = input.bool(true, "Short EMA MTF Smoothing", group=GROUP_EMA, tooltip="Applies MTF smoothing behavior only for the short EMA when its timeframe is higher than chart timeframe.", display=display.none)
shortEmaWidth = input.int(1, "Short EMA Width", minval=1, maxval=5, group=GROUP_EMA, tooltip="Line width for short EMA. Default 1.", display=display.none)

longEmaTf = input.timeframe("10", "Long EMA Timeframe", group=GROUP_EMA, tooltip="Higher timeframe used to calculate long EMA. Default 10-minute for 1-minute execution context.", display=display.none)
longEmaLength = input.int(9, "Long EMA Length", minval=1, group=GROUP_EMA, tooltip="Length of long EMA. Default 9.", display=display.none)
longMtfSmoothMode = input.bool(true, "Long EMA MTF Smoothing", group=GROUP_EMA, tooltip="Applies MTF smoothing behavior only for the long EMA when its timeframe is higher than chart timeframe.", display=display.none)
emaSource = input.source(close, "EMA Source", group=GROUP_EMA, tooltip="Source series used for EMA calculations.", display=display.none)
showEma = input.bool(true, "Show EMAs", group=GROUP_EMA, tooltip="Shows or hides the long/short EMA lines and fill.", display=display.none)
longEmaWidth = input.int(1, "Long EMA Width", minval=1, maxval=5, group=GROUP_EMA, tooltip="Line width for long EMA. Default 1.", display=display.none)
bullTrendColor = input.color(color.new(color.lime, 0), "Bull Trend Color", group=GROUP_EMA, tooltip="EMA color when price is above EMA and fill color when short EMA is above long EMA.", display=display.none)
bearTrendColor = input.color(color.new(color.red, 0), "Bear Trend Color", group=GROUP_EMA, tooltip="EMA color when price is below EMA and fill color when short EMA is below long EMA.", display=display.none)

//━━━━━━━━━━━━━━━━━━━━
// FVG Settings
//━━━━━━━━━━━━━━━━━━━━
showBullFvg = input.bool(true, "Show Bullish FVGs", group=GROUP_FVG, tooltip="Displays bullish FVG zones (potential bearish IFVG source) as boxes.", display=display.none)
showBearFvg = input.bool(true, "Show Bearish FVGs", group=GROUP_FVG, tooltip="Displays bearish FVG zones (potential bullish IFVG source) as boxes.", display=display.none)
bullFvgColor = input.color(color.new(color.lime, 0), "Bullish FVG Color", group=GROUP_FVG, tooltip="Base color for bullish FVG boxes.", display=display.none)
bearFvgColor = input.color(color.new(color.red, 0), "Bearish FVG Color", group=GROUP_FVG, tooltip="Base color for bearish FVG boxes.", display=display.none)
fvgTransparency = input.int(85, "FVG Transparency", minval=0, maxval=100, group=GROUP_FVG, tooltip="Opacity of FVG boxes. Higher values are more transparent.", display=display.none)
extendFvgRight = input.bool(true, "Extend FVGs Right", group=GROUP_FVG, tooltip="Extends FVG zones into future bars for ongoing reference.", display=display.none)
showMidline = input.bool(true, "Show Midline", group=GROUP_FVG, tooltip="Draws midpoint line inside each FVG box.", display=display.none)
midlineStyleInput = input.string("Dotted", "Midline Style", options=["Solid", "Dashed", "Dotted"], group=GROUP_FVG, tooltip="Line style for FVG midpoint.", display=display.none)
midlineColor = input.color(color.new(color.gray, 0), "Midline Color", group=GROUP_FVG, tooltip="Color used for FVG midpoint line.", display=display.none)
fvgDisplayCap = input.int(2, "FVG Display Cap", minval=0, group=GROUP_DISPLAY, tooltip="Max number of bullish and bearish FVGs displayed per side. 0 = unlimited. Default 2 for clarity.", display=display.none)

fvgSizeFilterEnabled = input.bool(false, "FVG Size Filter Enabled", group=GROUP_FVG, tooltip="When enabled, only FVGs meeting minimum size threshold are eligible for logic/visual creation.", display=display.none)
fvgSizeMode = input.string("Points/Dollars", "FVG Size Mode", options=["Points/Dollars", "Ticks", "Percent", "ATR Multiple"], group=GROUP_FVG, tooltip="Measurement mode for minimum FVG size filter.", display=display.none)
minFvgSize = input.float(0.0, "Minimum FVG Size", minval=0.0, step=0.01, group=GROUP_FVG, tooltip="Minimum FVG size threshold in selected mode. Set 0 to effectively disable strict filtering.", display=display.none)
atrLength = input.int(14, "ATR Length", minval=1, group=GROUP_FVG, tooltip="ATR length used only when FVG Size Mode = ATR Multiple.", display=display.none)

//━━━━━━━━━━━━━━━━━━━━
// IFVG Settings
//━━━━━━━━━━━━━━━━━━━━
ifvgConfirmBarLimit = input.int(0, "IFVG Confirmation Bar Limit", minval=0, group=GROUP_IFVG, tooltip="Maximum bars allowed between FVG creation and inversion confirmation. 0 = no limit.", display=display.none)

//━━━━━━━━━━━━━━━━━━━━
// Entry Settings
//━━━━━━━━━━━━━━━━━━━━
emaTouchType = input.string("Either", "EMA Touch Type", options=["Wick Touch", "Body Touch", "Either"], group=GROUP_ENTRY, tooltip="Defines what counts as EMA interaction: wick cross, body intersection, or either.", display=display.none)
emaTouchBarsBefore = input.int(3, "EMA Touch Bars Before IFVG", minval=0, group=GROUP_ENTRY, tooltip="How many bars BEFORE IFVG confirmation are allowed to contain EMA touch for entry qualification.", display=display.none)
emaTouchBarsAfter = input.int(3, "EMA Touch Bars After IFVG", minval=0, group=GROUP_ENTRY, tooltip="How many bars AFTER IFVG confirmation are allowed for EMA touch/reclaim completion.", display=display.none)
showEntries = input.bool(true, "Show Entries", group=GROUP_ENTRY, tooltip="Show bullish/bearish entry markers on chart.", display=display.none)
bullEntryColor = input.color(color.new(color.aqua, 0), "Bullish Entry Color", group=GROUP_ENTRY, tooltip="Color of bullish entry marker.", display=display.none)
bearEntryColor = input.color(color.new(color.orange, 0), "Bearish Entry Color", group=GROUP_ENTRY, tooltip="Color of bearish entry marker.", display=display.none)
entryLabelSizeInput = input.string("Tiny", "Entry Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=GROUP_ENTRY, tooltip="Visual size of entry triangles.", display=display.none)
entryMarkerOffsetAtrMult = input.float(0.2, "Entry Marker Offset (ATR Mult)", minval=0.0, step=0.05, group=GROUP_ENTRY, tooltip="Vertical offset applied to entry triangles so they are clearly separated from candles. Uses ATR multiple; default 0.2.", display=display.none)
entryDisplayCap = input.int(10, "Entry Display Cap", minval=0, group=GROUP_DISPLAY, tooltip="Maximum number of bullish and bearish entry markers retained per side. 0 = unlimited.", display=display.none)

//━━━━━━━━━━━━━━━━━━━━
// Alert Settings
//━━━━━━━━━━━━━━━━━━━━
enableAlerts = input.bool(true, "Enable Alert Conditions", group=GROUP_ALERTS, tooltip="Master visibility/organization toggle for alertcondition usage in alert dialog. Does not affect plotted logic.", display=display.none)

//━━━━━━━━━━━━━━━━━━━━
// Helpers
//━━━━━━━━━━━━━━━━━━━━
f_getAvg(string maType, series float src, int len) =>
    smaV = ta.sma(src, len)
    emaV = ta.ema(src, len)
    maType == "MA" ? smaV : emaV

f_getConverted(string tf, series float src, int len, string maType, bool mtfMode) =>
    avg = f_getAvg(maType, src, len)
    if mtfMode
        [m, b] = request.security(syminfo.tickerid, tf, [avg, bar_index], barmerge.gaps_off, barmerge.lookahead_off)
        isNewHtfBar = ta.change(b) != 0
        isNewHtfBar or barstate.islast ? m : na
    else
        tf == "" ? avg : request.security(syminfo.tickerid, tf, avg, barmerge.gaps_off, barmerge.lookahead_off)

f_getConvertedDense(string tf, series float src, int len, string maType, bool mtfMode) =>
    avg = f_getAvg(maType, src, len)
    tf == "" ? avg : request.security(syminfo.tickerid, tf, avg, barmerge.gaps_off, barmerge.lookahead_on)


f_midlineStyle(string style) =>
    style == "Solid" ? line.style_solid : style == "Dashed" ? line.style_dashed : line.style_dotted

f_touchEma(float emaValue, string touchType) =>
    wickTouch = high >= emaValue and low <= emaValue
    bodyHigh = math.max(open, close)
    bodyLow = math.min(open, close)
    bodyTouch = bodyHigh >= emaValue and bodyLow <= emaValue
    touchType == "Wick Touch" ? wickTouch : touchType == "Body Touch" ? bodyTouch : (wickTouch or bodyTouch)

f_sizeValue(float top, float bottom, string mode, float atrV) =>
    absSize = math.abs(top - bottom)
    mode == "Points/Dollars" ? absSize :
     mode == "Ticks" ? absSize / syminfo.mintick :
     mode == "Percent" ? (absSize / close) * 100.0 : atrV == 0.0 ? 0.0 : absSize / atrV

f_labelSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : s == "Huge" ? size.huge : size.normal

f_cleanupVisuals(array<box> boxesArr, array<line> linesArr, int cap) =>
    if cap > 0
        while array.size(boxesArr) > cap
            b = array.shift(boxesArr)
            box.delete(b)
        while array.size(linesArr) > cap
            l = array.shift(linesArr)
            line.delete(l)

f_cleanupLabels(array<label> labelsArr, int cap) =>
    if cap > 0
        while array.size(labelsArr) > cap
            lb = array.shift(labelsArr)
            label.delete(lb)



f_createEntryFvgVisual(int leftBar, float top, float bottom, color fvgColor, int transp, bool drawMid, color midColor, string midStyle) =>
    newEntryBox = box.new(leftBar, top, bar_index, bottom, border_color=color.new(fvgColor, 0), bgcolor=color.new(fvgColor, transp), extend=extend.none)
    line newEntryMid = na
    if drawMid
        mid = (top + bottom) * 0.5
        newEntryMid := line.new(leftBar, mid, bar_index, mid, color=midColor, style=f_midlineStyle(midStyle), extend=extend.none)
    [newEntryBox, newEntryMid]
//━━━━━━━━━━━━━━━━━━━━
// Core Series
//━━━━━━━━━━━━━━━━━━━━
atrValue = ta.atr(atrLength)

longPlotSeries = f_getConverted(longEmaTf, emaSource, longEmaLength, "EMA", longMtfSmoothMode)
longLogicSeries = f_getConvertedDense(longEmaTf, emaSource, longEmaLength, "EMA", longMtfSmoothMode)
shortPlotSeries = f_getConverted(shortEmaTf, emaSource, shortEmaLength, "EMA", shortMtfSmoothMode)
shortLogicSeries = f_getConvertedDense(shortEmaTf, emaSource, shortEmaLength, "EMA", shortMtfSmoothMode)

logicEma = longLogicSeries
plotEma = longPlotSeries
shortEmaLogic = shortLogicSeries
shortEmaPlot = shortPlotSeries

longEmaColorDyn = close >= logicEma ? bullTrendColor : bearTrendColor
shortEmaColorDyn = close >= shortEmaLogic ? bullTrendColor : bearTrendColor

longPlot = plot(showEma ? plotEma : na, "Long EMA", color=longEmaColorDyn, linewidth=longEmaWidth)
shortPlot = plot(showEma ? shortEmaPlot : na, "Short EMA", color=shortEmaColorDyn, linewidth=shortEmaWidth)
fillColor = shortEmaLogic >= logicEma ? color.new(bullTrendColor, 85) : color.new(bearTrendColor, 85)
fill(longPlot, shortPlot, color=showEma ? fillColor : na, title="EMA Spread Fill")

//━━━━━━━━━━━━━━━━━━━━
// State Storage
//━━━━━━━━━━━━━━━━━━━━
var array<box> bullBoxes = array.new<box>()
var array<line> bullMidlines = array.new<line>()
var array<box> bearBoxes = array.new<box>()
var array<line> bearMidlines = array.new<line>()
var array<label> bullEntries = array.new<label>()
var array<label> bearEntries = array.new<label>()
var array<box> bullEntryFvgBoxes = array.new<box>()
var array<line> bullEntryFvgMidlines = array.new<line>()
var array<box> bearEntryFvgBoxes = array.new<box>()
var array<line> bearEntryFvgMidlines = array.new<line>()

var int latestBullFvgBar = na
var float latestBullTop = na
var float latestBullBottom = na
var bool latestBullActive = false
var bool latestBullIfvgConfirmed = false
var int latestBullIfvgBar = na
var bool latestBullSignalDone = false
var box latestBullBox = na

var int latestBearFvgBar = na
var float latestBearTop = na
var float latestBearBottom = na
var bool latestBearActive = false
var bool latestBearIfvgConfirmed = false
var int latestBearIfvgBar = na
var bool latestBearSignalDone = false
var box latestBearBox = na

var bool bullIfvgConfirmedAlert = false
var bool bearIfvgConfirmedAlert = false
var bool bullEntryAlert = false
var bool bearEntryAlert = false

bullIfvgConfirmedAlert := false
bearIfvgConfirmedAlert := false
bullEntryAlert := false
bearEntryAlert := false

//━━━━━━━━━━━━━━━━━━━━
// FVG Detection
//━━━━━━━━━━━━━━━━━━━━
bullFvgFound = bar_index >= 2 and high[2] < low
bearFvgFound = bar_index >= 2 and low[2] > high

if bullFvgFound
    fvgTop = low
    fvgBottom = high[2]
    sizeOk = not fvgSizeFilterEnabled or f_sizeValue(fvgTop, fvgBottom, fvgSizeMode, atrValue) >= minFvgSize
    if sizeOk
        if latestBullActive
            latestBullActive := false
        latestBullFvgBar := bar_index
        latestBullTop := fvgTop
        latestBullBottom := fvgBottom
        latestBullActive := true
        latestBullIfvgConfirmed := false
        latestBullIfvgBar := na
        latestBullSignalDone := false

        if showBullFvg
            rightEdge = extendFvgRight ? bar_index + 1 : bar_index
            newBox = box.new(bar_index - 2, fvgTop, rightEdge, fvgBottom, border_color=color.new(bullFvgColor, 0), bgcolor=color.new(bullFvgColor, fvgTransparency), extend=extendFvgRight ? extend.right : extend.none)
            array.push(bullBoxes, newBox)
            latestBullBox := newBox
            if showMidline
                mid = (fvgTop + fvgBottom) * 0.5
                newLine = line.new(bar_index - 2, mid, rightEdge, mid, color=midlineColor, style=f_midlineStyle(midlineStyleInput), extend=extendFvgRight ? extend.right : extend.none)
                array.push(bullMidlines, newLine)

if bearFvgFound
    fvgTop = low[2]
    fvgBottom = high
    sizeOk = not fvgSizeFilterEnabled or f_sizeValue(fvgTop, fvgBottom, fvgSizeMode, atrValue) >= minFvgSize
    if sizeOk
        if latestBearActive
            latestBearActive := false
        latestBearFvgBar := bar_index
        latestBearTop := fvgTop
        latestBearBottom := fvgBottom
        latestBearActive := true
        latestBearIfvgConfirmed := false
        latestBearIfvgBar := na
        latestBearSignalDone := false

        if showBearFvg
            rightEdge = extendFvgRight ? bar_index + 1 : bar_index
            newBox = box.new(bar_index - 2, fvgTop, rightEdge, fvgBottom, border_color=color.new(bearFvgColor, 0), bgcolor=color.new(bearFvgColor, fvgTransparency), extend=extendFvgRight ? extend.right : extend.none)
            array.push(bearBoxes, newBox)
            latestBearBox := newBox
            if showMidline
                mid = (fvgTop + fvgBottom) * 0.5
                newLine = line.new(bar_index - 2, mid, rightEdge, mid, color=midlineColor, style=f_midlineStyle(midlineStyleInput), extend=extendFvgRight ? extend.right : extend.none)
                array.push(bearMidlines, newLine)

f_cleanupVisuals(bullBoxes, bullMidlines, fvgDisplayCap)
f_cleanupVisuals(bearBoxes, bearMidlines, fvgDisplayCap)

//━━━━━━━━━━━━━━━━━━━━
// IFVG Confirmation
//━━━━━━━━━━━━━━━━━━━━
if latestBullActive and not latestBullIfvgConfirmed
    barsFromCreate = bar_index - latestBullFvgBar
    withinLimit = ifvgConfirmBarLimit == 0 or barsFromCreate <= ifvgConfirmBarLimit
    if withinLimit
        if close < latestBullBottom
            latestBullIfvgConfirmed := true
            latestBullIfvgBar := bar_index
            bearIfvgConfirmedAlert := true
            if not na(latestBullBox)
                box.set_bgcolor(latestBullBox, color.new(bearFvgColor, fvgTransparency))
                box.set_border_color(latestBullBox, color.new(bearFvgColor, 0))
    else
        latestBullActive := false

if latestBearActive and not latestBearIfvgConfirmed
    barsFromCreate = bar_index - latestBearFvgBar
    withinLimit = ifvgConfirmBarLimit == 0 or barsFromCreate <= ifvgConfirmBarLimit
    if withinLimit
        if close > latestBearTop
            latestBearIfvgConfirmed := true
            latestBearIfvgBar := bar_index
            bullIfvgConfirmedAlert := true
            if not na(latestBearBox)
                box.set_bgcolor(latestBearBox, color.new(bullFvgColor, fvgTransparency))
                box.set_border_color(latestBearBox, color.new(bullFvgColor, 0))
    else
        latestBearActive := false

//━━━━━━━━━━━━━━━━━━━━
// Entry Logic
//━━━━━━━━━━━━━━━━━━━━
emaTouched = f_touchEma(logicEma, emaTouchType)
barsSinceEmaTouch = ta.barssince(emaTouched)
lastEmaTouchBar = barsSinceEmaTouch >= 0 ? bar_index - barsSinceEmaTouch : na
labelSz = f_labelSize(entryLabelSizeInput)
entryOffset = math.max(syminfo.mintick * 10.0, atrValue * entryMarkerOffsetAtrMult)

if latestBearActive and latestBearIfvgConfirmed and not latestBearSignalDone
    barsSinceIfvg = bar_index - latestBearIfvgBar
    inAfterWindow = barsSinceIfvg >= 0 and barsSinceIfvg <= emaTouchBarsAfter
    validBeforeStart = math.max(latestBearFvgBar, latestBearIfvgBar - emaTouchBarsBefore)
    touchBeforeOrAtIfvg = not na(lastEmaTouchBar) and lastEmaTouchBar >= validBeforeStart and lastEmaTouchBar <= latestBearIfvgBar
    touchAfterOrNow = inAfterWindow and emaTouched
    emaWindowOk = touchBeforeOrAtIfvg or touchAfterOrNow
    reclaimUp = close > logicEma and close[1] <= logicEma[1]
    trendBullOk = shortEmaLogic > logicEma
    if emaWindowOk and reclaimUp and trendBullOk
        latestBearSignalDone := true
        bullEntryAlert := true
        if showEntries
            lb = label.new(bar_index, low - entryOffset, "Long", style=label.style_label_up, color=color.new(bullFvgColor, 0), textcolor=color.white, size=labelSz)
            array.push(bullEntries, lb)
            [entryFvgBox, entryFvgMid] = f_createEntryFvgVisual(latestBearFvgBar - 2, latestBearTop, latestBearBottom, bullFvgColor, fvgTransparency, showMidline, midlineColor, midlineStyleInput)
            array.push(bullEntryFvgBoxes, entryFvgBox)
            if not na(entryFvgMid)
                array.push(bullEntryFvgMidlines, entryFvgMid)

if latestBullActive and latestBullIfvgConfirmed and not latestBullSignalDone
    barsSinceIfvg = bar_index - latestBullIfvgBar
    inAfterWindow = barsSinceIfvg >= 0 and barsSinceIfvg <= emaTouchBarsAfter
    validBeforeStart = math.max(latestBullFvgBar, latestBullIfvgBar - emaTouchBarsBefore)
    touchBeforeOrAtIfvg = not na(lastEmaTouchBar) and lastEmaTouchBar >= validBeforeStart and lastEmaTouchBar <= latestBullIfvgBar
    touchAfterOrNow = inAfterWindow and emaTouched
    emaWindowOk = touchBeforeOrAtIfvg or touchAfterOrNow
    reclaimDown = close < logicEma and close[1] >= logicEma[1]
    trendBearOk = shortEmaLogic < logicEma
    if emaWindowOk and reclaimDown and trendBearOk
        latestBullSignalDone := true
        bearEntryAlert := true
        if showEntries
            lb = label.new(bar_index, high + entryOffset, "Short", style=label.style_label_down, color=color.new(bearFvgColor, 0), textcolor=color.white, size=labelSz)
            array.push(bearEntries, lb)
            [entryFvgBox, entryFvgMid] = f_createEntryFvgVisual(latestBullFvgBar - 2, latestBullTop, latestBullBottom, bearFvgColor, fvgTransparency, showMidline, midlineColor, midlineStyleInput)
            array.push(bearEntryFvgBoxes, entryFvgBox)
            if not na(entryFvgMid)
                array.push(bearEntryFvgMidlines, entryFvgMid)

f_cleanupLabels(bullEntries, entryDisplayCap)
f_cleanupLabels(bearEntries, entryDisplayCap)
f_cleanupVisuals(bullEntryFvgBoxes, bullEntryFvgMidlines, entryDisplayCap)
f_cleanupVisuals(bearEntryFvgBoxes, bearEntryFvgMidlines, entryDisplayCap)

//━━━━━━━━━━━━━━━━━━━━
// Alerts
//━━━━━━━━━━━━━━━━━━━━
alertcondition(enableAlerts and bullIfvgConfirmedAlert, "Bullish IFVG Confirmed", "Bearish FVG inverted to bullish IFVG.")
alertcondition(enableAlerts and bearIfvgConfirmedAlert, "Bearish IFVG Confirmed", "Bullish FVG inverted to bearish IFVG.")
alertcondition(enableAlerts and bullEntryAlert, "Bullish EMA Inversion Entry", "Bullish IFVG + EMA reclaim entry confirmed.")
alertcondition(enableAlerts and bearEntryAlert, "Bearish EMA Inversion Entry", "Bearish IFVG + EMA rejection entry confirmed.")
